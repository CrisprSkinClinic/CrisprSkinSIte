---
// src/components/BookingCalendar.astro
//
// One page to book and manage appointments, phone first:
//   1. Verify the WhatsApp number (nothing else is shown before this).
//   2. "Patients on this number": each patient's last visit and upcoming appointments,
//      with Reschedule / Cancel, and "Book for <name>" / "+ Someone new".
//   3. Book (doctor pre-selected from the last visit; a returning patient is a Review)
//      or pick a new time for a reschedule.
//   4. Confirmation with add-to-calendar and directions.
// Verification is kept in this tab for its 30 minutes. Every rule (who may be booked,
// limits, the 2-hour change cut-off) is enforced by the Netlify functions.
//
// Kept identical on the CRISPR Skin and Crispr Eye Care websites; site specifics live in
// src/config/booking.js.
import { bookingConfig } from '../config/booking.js';
const { defaultService, defaultDoctorId, heading } = Astro.props;
const { doctors, services, clinicPhone } = bookingConfig;
const clinicTel = clinicPhone.replace(/[^0-9+]/g, '');
const singleDoctor = doctors.length === 1;
const inputClass = 'w-full p-3 rounded-xl bg-white/80 border border-slate-200 focus:ring-2 focus:ring-brand-500 outline-none';
---

<div
  id="bookingRoot"
  data-default-service={defaultService || bookingConfig.defaultService || ''}
  data-default-doctor-id={defaultDoctorId || ''}
  data-config={JSON.stringify({ doctors, clinicName: bookingConfig.clinicName, addressLine: bookingConfig.addressLine, mapsUrl: bookingConfig.mapsUrl, clinicPhone, clinicTel })}
  class="max-w-3xl mx-auto p-5 md:p-8 bg-white border border-slate-200 rounded-2xl shadow-lg"
>
  <p id="bkNotice" class="hidden mb-4 p-3 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm font-medium" role="status" aria-live="polite"></p>
  <p id="bkError" class="hidden mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm font-medium" role="alert"></p>

  <!-- 1. Verify the number -->
  <section id="stepPhone" class="space-y-4">
    <div>
      <h3 class="text-2xl font-bold text-brand-900">{heading || 'Book or manage an appointment'}</h3>
      <p class="text-slate-600 mt-1">Start with your WhatsApp number. We'll send a 6-digit code to verify it.</p>
    </div>
    <div class="flex gap-3">
      <input type="tel" id="bkPhone" placeholder="WhatsApp mobile number" autocomplete="tel-national" inputmode="tel" class={`flex-1 min-w-0 ${inputClass}`} />
      <button type="button" id="bkSend" class="px-4 rounded-xl bg-brand-600 text-white font-semibold whitespace-nowrap hover:bg-brand-700 transition disabled:opacity-50">Send code</button>
    </div>
    <div id="bkOtpBlock" class="hidden space-y-2">
      <div class="flex gap-3">
        <input type="text" id="bkOtp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6-digit code" class={`flex-1 min-w-0 tracking-widest ${inputClass}`} />
        <button type="button" id="bkVerify" class="px-5 rounded-xl bg-brand-900 text-white font-semibold whitespace-nowrap hover:bg-brand-800 transition disabled:opacity-50">Verify</button>
      </div>
      <p id="bkOtpStatus" class="text-sm text-slate-600"></p>
    </div>
    <p class="text-xs text-slate-500">Your number is used only to confirm and manage your appointments. No WhatsApp? Call <a class="font-semibold text-brand-700 underline" href={`tel:${clinicTel}`}>{clinicPhone}</a> to book.</p>
  </section>

  <!-- 2. Patients on this number -->
  <section id="stepPeople" class="hidden space-y-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <p class="text-sm font-semibold text-green-700" id="bkVerifiedLabel"></p>
      <button type="button" id="bkChangeNumber" class="text-sm font-semibold text-brand-700 underline underline-offset-2">Use a different number</button>
    </div>
    <h3 class="text-2xl font-bold text-brand-900">Who is this for?</h3>
    <div id="bkPeople" class="space-y-4"></div>
    <button type="button" id="bkSomeoneNew" class="w-full py-4 rounded-xl border-2 border-dashed border-brand-200 text-brand-800 font-semibold hover:bg-brand-50 transition">+ Book for someone new</button>
  </section>

  <!-- 3. Book or reschedule -->
  <section id="stepBook" class="hidden space-y-5">
    <button type="button" id="bkBack" class="text-sm font-semibold text-brand-700 underline underline-offset-2">‹ Back</button>
    <h3 id="bkBookTitle" class="text-2xl font-bold text-brand-900"></h3>
    <div id="bkPatientSummary" class="hidden rounded-xl border border-brand-200 bg-brand-50 p-4 text-sm leading-relaxed text-brand-900"></div>

    <div id="bkNewPerson" class="hidden space-y-4">
      <div>
        <p class="text-sm font-semibold text-slate-700 mb-2">This appointment is for</p>
        <div id="bkFor" class="grid grid-cols-3 gap-2" role="radiogroup" aria-label="Who is this appointment for?">
          <button type="button" role="radio" data-for="self" class="bk-for py-2.5 px-2 rounded-xl border text-sm font-semibold transition">Myself</button>
          <button type="button" role="radio" data-for="family" class="bk-for py-2.5 px-2 rounded-xl border text-sm font-semibold transition">Family member</button>
          <button type="button" role="radio" data-for="friend" class="bk-for py-2.5 px-2 rounded-xl border text-sm font-semibold transition">Friend</button>
        </div>
      </div>
      <div class="flex gap-3">
        <select id="bkPrefix" class={`w-1/4 ${inputClass}`}>
          <option value="Mr.">Mr.</option><option value="Ms.">Ms.</option><option value="Mrs.">Mrs.</option><option value="Dr.">Dr.</option><option value="Master">Master</option><option value="Baby">Baby</option>
        </select>
        <input type="text" id="bkFirst" placeholder="First name" autocomplete="given-name" class={`w-3/4 ${inputClass}`} />
      </div>
      <input type="text" id="bkLast" placeholder="Last name" autocomplete="family-name" class={inputClass} />
      <div class="grid grid-cols-2 gap-3">
        <label class="text-sm text-slate-600">Date of birth <span class="text-slate-400">(optional)</span>
          <input type="date" id="bkDob" class={`mt-1 ${inputClass}`} />
        </label>
        <label class="text-sm text-slate-600">Gender <span class="text-slate-400">(optional)</span>
          <select id="bkGender" class={`mt-1 ${inputClass}`}><option value="">—</option><option value="female">Female</option><option value="male">Male</option><option value="other">Other</option></select>
        </label>
      </div>
    </div>

    <div id="bkDoctorWrap" class={singleDoctor ? 'hidden' : ''}>
      <label class="text-sm font-semibold text-slate-700">Doctor
        <select id="bkDoctor" class={`mt-1 ${inputClass}`}>
          {!singleDoctor && <option value="" disabled selected>Select doctor…</option>}
          {!singleDoctor && <option value="any">No preference</option>}
          {doctors.map((doctor) => <option value={doctor.id} selected={singleDoctor}>{doctor.name}</option>)}
        </select>
      </label>
    </div>
    <div id="bkServiceWrap">
      <label class="text-sm font-semibold text-slate-700">Reason for visit
        <select id="bkService" class={`mt-1 ${inputClass}`}>
          {services.map((group) => group.group
            ? <optgroup label={group.group}>{group.items.map(([value, label]) => <option value={value}>{label || value}</option>)}</optgroup>
            : group.items.map(([value, label]) => <option value={value}>{label || value}</option>))}
        </select>
      </label>
    </div>
    <label class="block text-sm font-semibold text-slate-700">Date
      <input type="date" id="bkDate" class={`mt-1 ${inputClass}`} />
    </label>
    <div>
      <p class="text-sm font-semibold text-slate-700 mb-2">Time</p>
      <div id="bkSlots" class="grid grid-cols-3 gap-2"><p class="col-span-3 text-slate-400 text-sm">Select a doctor and date to see available times.</p></div>
    </div>
    <div id="bkMove" class="hidden p-4 rounded-xl border border-brand-200 bg-brand-50 text-brand-900 text-sm leading-relaxed space-y-3" role="status" aria-live="polite">
      <p id="bkMoveText"></p>
      <div class="flex flex-col sm:flex-row gap-3">
        <button type="button" id="bkMoveBtn" class="flex-1 py-3 px-4 rounded-xl bg-brand-600 text-white font-semibold hover:bg-brand-700 transition disabled:opacity-50">Move it</button>
        <button type="button" id="bkKeepBtn" class="flex-1 py-3 px-4 rounded-xl border border-brand-200 bg-white text-brand-900 font-semibold hover:bg-brand-100 transition">Keep the existing appointment</button>
      </div>
    </div>
    <button type="button" id="bkConfirm" class="w-full py-4 bg-brand-900 text-white font-bold rounded-xl shadow-lg hover:bg-brand-800 transition disabled:opacity-50">Confirm appointment</button>
  </section>

  <!-- 4. Done -->
  <section id="stepDone" class="hidden space-y-5">
    <div class="text-center">
      <div class="mx-auto mb-3 w-14 h-14 rounded-full bg-green-100 text-green-700 grid place-items-center text-3xl" aria-hidden="true">✓</div>
      <h3 id="bkDoneTitle" class="text-2xl font-bold text-brand-900">Appointment confirmed</h3>
      <p id="bkDoneSub" class="text-slate-600 mt-1"></p>
    </div>
    <dl id="bkDoneDetails" class="rounded-xl border border-slate-200 divide-y divide-slate-100 text-sm"></dl>
    <div class="grid grid-cols-2 gap-3">
      <button type="button" id="bkIcs" class="py-3 rounded-xl border border-brand-200 bg-white text-brand-900 font-semibold hover:bg-brand-50 transition">Add to calendar</button>
      <a id="bkMaps" target="_blank" rel="noopener" href={bookingConfig.mapsUrl} class="py-3 rounded-xl border border-brand-200 bg-white text-brand-900 font-semibold hover:bg-brand-50 transition text-center">Directions</a>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <button type="button" id="bkAnother" class="py-3 rounded-xl bg-brand-600 text-white font-semibold hover:bg-brand-700 transition">Book for another person</button>
      <button type="button" id="bkDone" class="py-3 rounded-xl bg-brand-900 text-white font-semibold hover:bg-brand-800 transition">Done</button>
    </div>
  </section>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('bookingRoot');
    if (!root) return;
    const cfg = JSON.parse(root.dataset.config || '{}');
    const $ = (id) => document.getElementById(id);
    const steps = ['stepPhone', 'stepPeople', 'stepBook', 'stepDone'];
    const SESSION_KEY = 'crispr-booking-verification';
    const VERIFIED_FOR_MS = 29 * 60 * 1000; // the server accepts a verification for 30 minutes

    const state = {
      phone: '', token: '',
      people: [], maxPerDay: 2,
      patient: null,          // existing patient being booked for, or null for someone new
      bookingFor: 'self',
      reschedule: null,       // upcoming visit being moved
      slot: null,             // { time24, display, doctorIds }
      lastBody: null,
      done: null,
    };

    // ---------- small helpers ----------
    const digits10 = (v) => String(v || '').replace(/\D/g, '').slice(-10);
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const todayIst = () => new Date(Date.now() + 330 * 60000).toISOString().slice(0, 10);
    const track = (step, extra = {}) => window.gtag?.('event', 'booking_step', { event_category: 'booking', step, ...extra });
    function show(step) {
      steps.forEach((s) => $(s).classList.toggle('hidden', s !== step));
      // Bring the form back into view only if its top has scrolled off (never on page load).
      if (root.getBoundingClientRect().top < 0) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    function notice(text) { const el = $('bkNotice'); el.textContent = text; el.classList.toggle('hidden', !text); }
    function error(text) { const el = $('bkError'); el.textContent = text; el.classList.toggle('hidden', !text); }
    function clearMessages() { notice(''); error(''); }
    async function post(fn, body) {
      const response = await fetch(`/.netlify/functions/${fn}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const result = await response.json().catch(() => ({}));
      if (response.status === 403 || result.expired) { expireVerification(result.error); throw Object.assign(new Error(result.error || 'Please verify again.'), { handled: true }); }
      return { response, result };
    }

    // ---------- verification (kept in this tab for 30 minutes) ----------
    function saveVerification() {
      try { sessionStorage.setItem(SESSION_KEY, JSON.stringify({ phone: state.phone, token: state.token, at: Date.now() })); } catch {}
    }
    function loadVerification() {
      try {
        const saved = JSON.parse(sessionStorage.getItem(SESSION_KEY) || 'null');
        if (saved && saved.token && Date.now() - saved.at < VERIFIED_FOR_MS) return saved;
      } catch {}
      return null;
    }
    function forgetVerification() { try { sessionStorage.removeItem(SESSION_KEY); } catch {} }
    function expireVerification(message) {
      forgetVerification();
      state.token = '';
      resetOtp();
      show('stepPhone');
      error(message || 'Your verification has expired. Please verify your WhatsApp number again.');
    }

    let resendTimer = null, otpSentTo = '';
    function resetOtp() {
      otpSentTo = '';
      $('bkOtp').value = '';
      $('bkOtpBlock').classList.add('hidden');
      if (resendTimer) clearInterval(resendTimer);
      resendTimer = null;
      $('bkSend').disabled = false; $('bkSend').innerText = 'Send code';
    }
    $('bkPhone').addEventListener('input', () => { if (otpSentTo && digits10($('bkPhone').value) !== otpSentTo) resetOtp(); });

    $('bkSend').addEventListener('click', async () => {
      clearMessages();
      const d = digits10($('bkPhone').value);
      if (!/^[6-9]\d{9}$/.test(d)) { error('Enter a valid 10-digit mobile number that uses WhatsApp.'); return; }
      const btn = $('bkSend');
      btn.disabled = true; btn.innerText = 'Sending…';
      try {
        const response = await fetch('/.netlify/functions/send-booking-otp', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone: $('bkPhone').value }) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) throw new Error(result.error || 'Could not send the WhatsApp code.');
        otpSentTo = d;
        track('code_sent');
        $('bkOtpBlock').classList.remove('hidden');
        $('bkOtpStatus').textContent = `Code sent on WhatsApp to +91 ${d}. It expires in 5 minutes.`;
        $('bkOtp').focus();
        let wait = 30;
        btn.innerText = `Resend in ${wait}s`;
        resendTimer = setInterval(() => {
          wait -= 1;
          if (wait <= 0) { clearInterval(resendTimer); resendTimer = null; btn.disabled = false; btn.innerText = 'Resend code'; }
          else btn.innerText = `Resend in ${wait}s`;
        }, 1000);
      } catch (e) {
        error(e.message); btn.disabled = false; btn.innerText = 'Send code';
      }
    });

    async function verifyCode() {
      clearMessages();
      const code = String($('bkOtp').value || '').replace(/\D/g, '');
      if (code.length !== 6) { error('Enter the 6-digit code from WhatsApp.'); return; }
      const btn = $('bkVerify');
      btn.disabled = true; btn.innerText = 'Checking…';
      try {
        const response = await fetch('/.netlify/functions/verify-booking-otp', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ phone: $('bkPhone').value, code }) });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success || !result.token) throw new Error(result.error || 'Could not verify the code.');
        state.phone = otpSentTo; state.token = result.token;
        saveVerification();
        if (resendTimer) clearInterval(resendTimer);
        track('verified');
        await loadPeople();
      } catch (e) {
        if (!e.handled) error(e.message);
      } finally {
        btn.disabled = false; btn.innerText = 'Verify';
      }
    }
    $('bkVerify').addEventListener('click', verifyCode);
    $('bkOtp').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); verifyCode(); } });
    $('bkChangeNumber').addEventListener('click', () => { forgetVerification(); state.token = ''; resetOtp(); $('bkPhone').value = ''; clearMessages(); show('stepPhone'); $('bkPhone').focus(); });

    // ---------- 2. patients on this number ----------
    async function loadPeople() {
      const { response, result } = await post('number-overview', { phone: state.phone, otpToken: state.token });
      if (!response.ok) throw new Error(result.error || 'Could not load your appointments.');
      state.people = result.patients || [];
      state.maxPerDay = result.maxPerDay || 2;
      $('bkVerifiedLabel').textContent = `✓ +91 ${state.phone} verified`;
      if (!state.people.length) { startBooking(null); return; }
      renderPeople();
      show('stepPeople');
    }

    function renderPeople() {
      const box = $('bkPeople');
      box.innerHTML = state.people.map((p, i) => {
        const last = p.lastConsultation
          ? `<p class="text-sm text-slate-600">Last visit: ${esc(p.lastConsultation.dateLabel)}${p.lastConsultation.doctorName ? ` with Dr. ${esc(p.lastConsultation.doctorName)}` : ''}</p>`
          : '<p class="text-sm text-slate-500">No previous visit at this clinic</p>';
        const upcoming = p.upcoming.map((a) => `
          <div class="rounded-xl bg-brand-50 border border-brand-100 p-3 space-y-2">
            <p class="text-sm"><span class="font-semibold text-brand-900">${esc(a.dateLabel)} · ${esc(a.time)}</span>${a.doctorName ? ` · Dr. ${esc(a.doctorName)}` : ''}<br><span class="text-slate-600">${esc(a.service)}${a.status === 'arrived' ? ' · Checked in' : ''}</span></p>
            ${a.canChange
              ? `<div class="flex gap-2"><button type="button" data-resched="${esc(a.id)}" class="px-4 py-2 rounded-xl bg-white border border-brand-200 text-brand-900 text-sm font-semibold hover:bg-brand-100 transition">Reschedule</button><button type="button" data-cancel="${esc(a.id)}" class="px-4 py-2 rounded-xl bg-white border border-red-200 text-red-700 text-sm font-semibold hover:bg-red-50 transition">Cancel</button></div>`
              : `<p class="text-xs text-slate-600">${esc(a.changeNote || '')} <a class="font-semibold text-brand-700 underline" href="tel:${esc(cfg.clinicTel)}">${esc(cfg.clinicPhone)}</a></p>`}
          </div>`).join('');
        return `<article class="rounded-2xl border border-slate-200 p-4 space-y-3">
          <div><h4 class="text-lg font-bold text-brand-900">${esc(p.name)}</h4>${last}</div>
          ${upcoming}
          <button type="button" data-book="${i}" class="w-full py-3 rounded-xl bg-brand-600 text-white font-semibold hover:bg-brand-700 transition">Book for ${esc(p.name)}</button>
        </article>`;
      }).join('');
      box.querySelectorAll('[data-book]').forEach((b) => b.addEventListener('click', () => startBooking(state.people[Number(b.dataset.book)])));
      box.querySelectorAll('[data-resched]').forEach((b) => b.addEventListener('click', () => {
        const visit = state.people.flatMap((p) => p.upcoming).find((a) => a.id === b.dataset.resched);
        if (visit) startReschedule(visit);
      }));
      box.querySelectorAll('[data-cancel]').forEach((b) => b.addEventListener('click', () => cancelVisit(b.dataset.cancel, b)));
    }
    $('bkSomeoneNew').addEventListener('click', () => startBooking(null));

    async function cancelVisit(id, btn) {
      const visit = state.people.flatMap((p) => p.upcoming).find((a) => a.id === id);
      if (!visit || !window.confirm(`Cancel ${visit.patientName}'s appointment on ${visit.dateLabel} at ${visit.time}?`)) return;
      clearMessages();
      btn.disabled = true; btn.innerText = 'Cancelling…';
      try {
        const { response, result } = await post('manage-appointments', { action: 'cancel', phone: state.phone, otpToken: state.token, appointmentId: id });
        if (!response.ok || !result.success) throw new Error(result.error || 'Could not cancel the appointment.');
        track('cancelled');
        await loadPeople();
        notice(`${visit.patientName}'s appointment on ${visit.dateLabel} at ${visit.time} has been cancelled.`);
      } catch (e) {
        if (!e.handled) error(e.message);
        btn.disabled = false; btn.innerText = 'Cancel';
      }
    }

    // ---------- 3. book / reschedule ----------
    const doctorSelect = $('bkDoctor'), dateInput = $('bkDate'), serviceSelect = $('bkService');
    dateInput.min = todayIst();
    const defaultService = root.dataset.defaultService;
    const defaultDoctorId = root.dataset.defaultDoctorId;
    const hasDoctor = (id) => Array.from(doctorSelect.options).some((o) => o.value === id);

    function setFor(value) {
      state.bookingFor = value;
      document.querySelectorAll('#bkFor .bk-for').forEach((b) => {
        const on = b.dataset.for === value;
        b.setAttribute('aria-checked', String(on));
        b.className = `bk-for py-2.5 px-2 rounded-xl border text-sm font-semibold transition ${on ? 'bg-brand-600 border-brand-600 text-white' : 'bg-white border-slate-200 text-brand-900'}`;
      });
    }
    document.querySelectorAll('#bkFor .bk-for').forEach((b) => b.addEventListener('click', () => setFor(b.dataset.for)));

    function startBooking(patient) {
      clearMessages();
      state.patient = patient; state.reschedule = null; state.slot = null;
      $('bkMove').classList.add('hidden');
      $('bkBack').classList.toggle('hidden', !state.people.length);
      $('bkServiceWrap').classList.remove('hidden');
      $('bkNewPerson').classList.toggle('hidden', Boolean(patient));
      const summary = $('bkPatientSummary');
      if (patient) {
        $('bkBookTitle').textContent = `Book for ${patient.name}`;
        const last = patient.lastConsultation;
        summary.innerHTML = last
          ? `Last visit: <b>${esc(last.dateLabel)}</b>${last.doctorName ? ` with <b>Dr. ${esc(last.doctorName)}</b>` : ''}. This will be booked as a review${last.doctorId && hasDoctor(last.doctorId) ? ' with the same doctor — you can change this' : ''}.`
          : 'This will be booked as a new consultation.';
        summary.classList.remove('hidden');
        doctorSelect.value = last?.doctorId && hasDoctor(last.doctorId) ? last.doctorId : (defaultDoctorId && hasDoctor(defaultDoctorId) ? defaultDoctorId : doctorSelect.options[0].value);
      } else {
        $('bkBookTitle').textContent = 'Book for someone new';
        summary.classList.add('hidden');
        setFor(state.people.length ? 'family' : 'self');
        ['bkFirst', 'bkLast', 'bkDob'].forEach((id) => { $(id).value = ''; });
        $('bkGender').value = '';
        doctorSelect.value = defaultDoctorId && hasDoctor(defaultDoctorId) ? defaultDoctorId : doctorSelect.options[0].value;
      }
      if (defaultService && Array.from(serviceSelect.options).some((o) => o.value === defaultService)) serviceSelect.value = defaultService;
      if (!dateInput.value || dateInput.value < todayIst()) dateInput.value = todayIst();
      $('bkConfirm').innerText = 'Confirm appointment';
      track('patient_selected', { patient: patient ? 'existing' : 'new' });
      show('stepBook');
      loadSlots();
    }

    function startReschedule(visit) {
      clearMessages();
      state.reschedule = visit; state.patient = state.people.find((p) => p.id === visit.patientId) || null; state.slot = null;
      $('bkMove').classList.add('hidden');
      $('bkBack').classList.remove('hidden');
      $('bkNewPerson').classList.add('hidden');
      $('bkServiceWrap').classList.add('hidden');
      $('bkBookTitle').textContent = `Reschedule ${visit.patientName}'s appointment`;
      const summary = $('bkPatientSummary');
      summary.innerHTML = `Currently <b>${esc(visit.dateLabel)} at ${esc(visit.time)}</b>${visit.doctorName ? ` with Dr. ${esc(visit.doctorName)}` : ''}. Choose a new date and time.`;
      summary.classList.remove('hidden');
      if (hasDoctor(visit.doctorId)) doctorSelect.value = visit.doctorId;
      dateInput.value = visit.date >= todayIst() ? visit.date : todayIst();
      $('bkConfirm').innerText = 'Confirm new time';
      track('reschedule_started');
      show('stepBook');
      loadSlots();
    }

    $('bkBack').addEventListener('click', () => { clearMessages(); state.people.length ? show('stepPeople') : show('stepPhone'); });

    async function loadSlots() {
      state.slot = null;
      $('bkMove').classList.add('hidden');
      const box = $('bkSlots');
      const doctorId = doctorSelect.value;
      if (!doctorId || !dateInput.value) { box.innerHTML = '<p class="col-span-3 text-slate-400 text-sm">Select a doctor and date to see available times.</p>'; return; }
      box.innerHTML = '<p class="col-span-3 text-slate-400 text-sm">Checking availability…</p>';
      try {
        const q = `date=${encodeURIComponent(dateInput.value)}${doctorId === 'any' ? '' : `&doctorId=${encodeURIComponent(doctorId)}`}`;
        const response = await fetch(`/.netlify/functions/public-available-slots?${q}`);
        const data = await response.json();
        if (!response.ok || data.error) throw new Error(data.error || 'Could not load availability.');
        let slots = data.slots || [];
        if (state.reschedule) slots = slots.filter((s) => !(dateInput.value === state.reschedule.date && s.display.replace(/^0/, '') === state.reschedule.time && (doctorId === state.reschedule.doctorId)));
        if (!slots.length) { box.innerHTML = `<p class="col-span-3 text-slate-500 text-sm">${esc(data.reason || 'No times left on this date. Please try another day, or call the clinic.')}</p>`; return; }
        box.innerHTML = '';
        slots.forEach((slot) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'bk-slot py-3 border border-brand-200 rounded-lg text-brand-800 hover:bg-brand-50 transition font-medium';
          b.textContent = slot.display;
          b.addEventListener('click', () => {
            box.querySelectorAll('.bk-slot').forEach((x) => { x.classList.remove('bg-brand-600', 'text-white', 'border-brand-600'); x.classList.add('text-brand-800', 'hover:bg-brand-50'); });
            b.classList.remove('text-brand-800', 'hover:bg-brand-50');
            b.classList.add('bg-brand-600', 'text-white', 'border-brand-600');
            state.slot = slot;
            $('bkMove').classList.add('hidden');
          });
          box.appendChild(b);
        });
      } catch (e) {
        box.innerHTML = '<p class="col-span-3 text-red-600 text-sm">Could not load availability. Please try again.</p>';
      }
    }
    dateInput.addEventListener('change', loadSlots);
    doctorSelect.addEventListener('change', loadSlots);

    // "Sunni Tamil" + "Tamil" → "Mr. Sunni Tamil": drop a surname typed twice. A single-word
    // first name is left alone so names like "Ram Ram" survive.
    function newPersonName() {
      const first = $('bkFirst').value.trim().replace(/\s+/g, ' ');
      const last = $('bkLast').value.trim().replace(/\s+/g, ' ');
      if (!first) return '';
      const words = first.split(' ');
      const repeated = last !== '' && words.length > 1 && words.slice(-last.split(' ').length).join(' ').toLowerCase() === last.toLowerCase();
      return [$('bkPrefix').value, first, repeated ? '' : last].filter(Boolean).join(' ');
    }

    async function submit(extra = {}) {
      clearMessages();
      if (!state.slot) { error('Choose a time.'); return; }
      const doctorId = doctorSelect.value;
      const noPreference = doctorId === 'any';
      const confirmBtn = $('bkConfirm');
      confirmBtn.disabled = true; confirmBtn.innerText = 'Saving…';
      try {
        if (state.reschedule) {
          const { response, result } = await post('manage-appointments', {
            action: 'reschedule', phone: state.phone, otpToken: state.token, appointmentId: state.reschedule.id,
            date: dateInput.value, time: state.slot.display,
            ...(noPreference ? { candidateDoctorIds: state.slot.doctorIds || [] } : { doctorId }),
          });
          if (!response.ok || !result.success) throw new Error(result.error || 'Could not move the appointment.');
          track('rescheduled');
          finish({ title: 'Appointment moved', sub: `From ${result.from}.`, patientName: state.reschedule.patientName, doctorName: String(result.to || '').split(' with Dr. ')[1] || null, date: dateInput.value, time24: state.slot.time24, timeLabel: state.slot.display, service: state.reschedule.service });
          return;
        }
        const name = state.patient ? null : newPersonName();
        if (!state.patient && !name) throw new Error('Enter the patient\'s name.');
        const body = {
          phone: state.phone, otpToken: state.token,
          ...(state.patient ? { patientId: state.patient.id } : { name, dob: $('bkDob').value || undefined, gender: $('bkGender').value || undefined, bookingFor: state.bookingFor }),
          service: serviceSelect.value, date: dateInput.value, time: state.slot.display,
          ...(noPreference ? { candidateDoctorIds: state.slot.doctorIds || [] } : { doctorId }),
          ...extra,
        };
        state.lastBody = body;
        const { response, result } = await post('public-book-appointment', body);
        if (response.status === 409 && result.existing) {
          $('bkMoveText').textContent = result.canReschedule ? `${result.error} Move it to ${state.slot.display} instead?` : result.error;
          $('bkMoveBtn').innerText = `Move it to ${state.slot.display}`;
          $('bkMoveBtn').classList.toggle('hidden', !result.canReschedule);
          $('bkMove').classList.remove('hidden');
          return;
        }
        if (!response.ok || !result.success) {
          if (result.limitReached) track('limit_reached');
          window.gtag?.('event', 'booking_failed', { event_category: 'engagement', event_label: body.service, error_message: result.error || 'unknown_error' });
          throw new Error(result.error || 'Could not complete your booking. Please try again or call the clinic.');
        }
        const a = result.appointment || {};
        if (result.rescheduled) track('rescheduled'); else {
          track('confirmed', { patient: state.patient ? 'existing' : 'new' });
          window.gtag?.('event', 'booking_completed', { event_category: 'conversion', event_label: body.service, doctor_preference: noPreference ? 'no_preference' : 'specific_doctor', doctor_id: noPreference ? undefined : doctorId });
        }
        finish({ title: result.rescheduled ? 'Appointment moved' : 'Appointment confirmed', sub: result.rescheduled ? `From ${result.from}.` : '', patientName: a.patientName, doctorName: a.doctorName, date: a.date || dateInput.value, time24: state.slot.time24, timeLabel: a.time || state.slot.display, service: a.service || body.service });
      } catch (e) {
        if (!e.handled) error(e.message);
      } finally {
        confirmBtn.disabled = false; confirmBtn.innerText = state.reschedule ? 'Confirm new time' : 'Confirm appointment';
      }
    }
    $('bkConfirm').addEventListener('click', () => submit());
    $('bkMoveBtn').addEventListener('click', () => { $('bkMove').classList.add('hidden'); submit({ reschedule: true }); });
    $('bkKeepBtn').addEventListener('click', () => { $('bkMove').classList.add('hidden'); notice('No changes made — the existing appointment stays as it is. Choose another date to book a different day.'); });

    // ---------- 4. done ----------
    function finish(done) {
      state.done = done;
      clearMessages();
      $('bkDoneTitle').textContent = done.title;
      $('bkDoneSub').textContent = `${done.sub ? `${done.sub} ` : ''}We've sent the details on WhatsApp to +91 ${state.phone}.`;
      const dateLabel = new Date(`${done.date}T00:00:00Z`).toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
      const rows = [['Patient', done.patientName], ['Doctor', done.doctorName ? `Dr. ${done.doctorName}` : ''], ['When', `${dateLabel} · ${String(done.timeLabel).replace(/^0/, '')}`], ['Reason', done.service], ['Where', `${cfg.clinicName}, ${cfg.addressLine}`]];
      $('bkDoneDetails').innerHTML = rows.filter(([, v]) => v).map(([k, v]) => `<div class="flex gap-4 p-3"><dt class="w-20 shrink-0 text-slate-500">${esc(k)}</dt><dd class="font-medium text-slate-900">${esc(v)}</dd></div>`).join('');
      show('stepDone');
    }

    $('bkIcs').addEventListener('click', () => {
      const d = state.done;
      if (!d) return;
      const start = new Date(`${d.date}T${d.time24}:00+05:30`);
      const end = new Date(start.getTime() + 30 * 60000);
      const stamp = (t) => t.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      const icsText = (v) => String(v || '').replace(/[\\,;]/g, (c) => `\\${c}`).replace(/\n/g, '\\n');
      const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//CRISPR//Appointment//EN', 'BEGIN:VEVENT',
        `UID:${stamp(start)}-${Math.random().toString(36).slice(2)}@crispr`, `DTSTAMP:${stamp(new Date())}`, `DTSTART:${stamp(start)}`, `DTEND:${stamp(end)}`,
        `SUMMARY:${icsText(`${cfg.clinicName} appointment${d.doctorName ? ` with Dr. ${d.doctorName}` : ''}`)}`,
        `LOCATION:${icsText(`${cfg.clinicName}, ${cfg.addressLine}`)}`,
        `DESCRIPTION:${icsText(`${d.patientName} · ${d.service}. To change it, visit the website or call ${cfg.clinicPhone}.`)}`,
        'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
      a.download = 'appointment.ics';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      track('added_to_calendar');
    });
    $('bkAnother').addEventListener('click', async () => { clearMessages(); try { await loadPeople(); } catch (e) { if (!e.handled) error(e.message); } });
    $('bkDone').addEventListener('click', async () => { clearMessages(); try { await loadPeople(); } catch (e) { if (!e.handled) error(e.message); } });

    // ---------- start: resume a verification made in this tab ----------
    const saved = loadVerification();
    if (saved) {
      state.phone = saved.phone; state.token = saved.token;
      $('bkPhone').value = saved.phone;
      track('verification_restored');
      loadPeople().catch((e) => { if (!e.handled) { show('stepPhone'); error(e.message); } });
    } else {
      show('stepPhone');
    }
  });
</script>
