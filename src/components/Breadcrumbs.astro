---
// src/components/Breadcrumbs.astro
//
// Renders both a visible breadcrumb trail AND BreadcrumbList JSON-LD schema.
// Usage: <Breadcrumbs items={[{ name: "Services", url: "/services" }, { name: "Cataract Surgery", url: "/services/cataract" }]} />
// "Home" is always prepended automatically -- don't include it in items.

import { siteConfig } from '../config/site.js';

interface BreadcrumbItem {
  name: string;
  url: string;
}

const { items = [] } = Astro.props as { items: BreadcrumbItem[] };

const allItems = [{ name: "Home", url: "/" }, ...items];

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": allItems.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": new URL(item.url, siteConfig.url).toString(),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<nav aria-label="Breadcrumb" class="bg-[#f8f7f8] border-b border-slate-200/70 px-5 sm:px-6 py-3.5 text-xs sm:text-sm leading-none">
  <ol class="max-w-7xl mx-auto flex items-center flex-nowrap overflow-hidden gap-1 text-slate-500 leading-none">
    {allItems.map((item, index) => (
      <li class={`flex items-center gap-1 leading-none ${index === allItems.length - 1 ? 'min-w-0 flex-1' : 'shrink-0'}`}>
        {index > 0 && <span class="mx-1 text-slate-300">/</span>}
        {index === allItems.length - 1 ? (
          <span class="font-semibold text-slate-700 leading-none truncate block">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-brand-600 transition-colors inline-block leading-none">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
