---
import { siteConfig } from '../config/site.js';

const photos = [
  { src: '/images/clinic/hallway.jpg', alt: `Clinic interior at ${siteConfig.name}` },
  { src: '/images/clinic/waiting-area.jpg', alt: `Patient waiting area at ${siteConfig.name}` },
  { src: '/images/clinic/consultation-room.webp', alt: `Consultation room at ${siteConfig.name}` },
  { src: '/images/clinic/procedure-room.webp', alt: `Procedure room at ${siteConfig.name}` },
  { src: '/images/clinic/clinic-corridor.webp', alt: `Procedure rooms at ${siteConfig.name}` },
  { src: '/images/clinic/clinic-exterior.webp', alt: `Exterior of ${siteConfig.name} in KK Nagar` },
];
---

<section class="py-14 px-5 md:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-extrabold text-[#0e172b] mb-3 tracking-tight">Visit Our Clinic</h2>
      <p class="text-lg text-slate-600">A look inside {siteConfig.name}, KK Nagar.</p>
    </div>

    <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth -mx-6 px-6 md:mx-0 md:px-0">
      {photos.map((photo) => (
        <div class="shrink-0 w-72 sm:w-80 snap-start">
          <img
            src={photo.src}
            alt={photo.alt}
            width="320"
            height="224"
            loading="lazy"
            decoding="async"
            class="ui-card h-56 w-full object-cover p-1 bg-white"
          />
        </div>
      ))}
    </div>
  </div>
</section>
