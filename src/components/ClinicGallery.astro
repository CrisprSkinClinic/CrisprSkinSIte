---
import { siteConfig } from '../config/site.js';

const photos = [
  { src: '/images/clinic/clinic-exterior.png', alt: `Exterior of ${siteConfig.name} in KK Nagar` },
  { src: '/images/clinic/clinic-corridor.png', alt: `Procedure rooms at ${siteConfig.name}` },
  { src: '/images/clinic/consultation-room.png', alt: `Consultation room at ${siteConfig.name}` },
  { src: '/images/clinic/procedure-room.png', alt: `Procedure room at ${siteConfig.name}` },
];
---

<section class="py-16 px-6 bg-white border-t border-slate-200">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-extrabold text-[#0e172b] mb-3 tracking-tight">Visit Our Clinic</h2>
      <p class="text-lg text-slate-600">A look inside {siteConfig.name}, KK Nagar.</p>
    </div>

    <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth -mx-6 px-6 md:mx-0 md:px-0">
      {photos.map((photo) => (
        <div class="shrink-0 w-72 sm:w-80 snap-start">
          <img
            src={photo.src}
            alt={photo.alt}
            width="320"
            height="224"
            loading="lazy"
            decoding="async"
            class="w-full h-56 object-cover rounded-2xl shadow-md border border-slate-200 bg-brand-50"
          />
        </div>
      ))}
    </div>
  </div>
</section>
