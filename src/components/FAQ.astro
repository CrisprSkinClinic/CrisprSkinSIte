---
import { getCollection } from 'astro:content';

const { limit } = Astro.props;

const allFaqs = await getCollection('faqs');
const sortedAll = allFaqs.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const sortedFaqs = limit ? sortedAll.slice(0, limit) : sortedAll;

// This creates the invisible SEO code for Google
const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sortedFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.data.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.body // This pulls the Markdown content
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<section class="mx-auto max-w-4xl px-5 py-16 md:px-6 md:py-24">
  <p class="mb-3 text-center text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">Questions patients ask</p>
  <h2 class="mb-10 text-center text-4xl text-brand-900 md:text-5xl">Frequently asked questions</h2>

  <div class="space-y-3">
    {sortedFaqs.map((faq) => (
      <details class="group ui-card overflow-hidden open:border-brand-300 open:shadow-lg">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-sans text-base font-bold text-slate-900 transition-colors hover:text-brand-700 md:p-6 md:text-lg [&::-webkit-details-marker]:hidden">
          {faq.data.question}
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700 transition duration-300 group-open:rotate-45 group-open:bg-brand-600 group-open:text-white" aria-hidden="true">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </span>
        </summary>
        <div class="px-5 pb-6 leading-relaxed text-slate-600 md:px-6">{faq.body}</div>
      </details>
    ))}
  </div>

  {limit && allFaqs.length > limit && (
    <div class="mt-8 text-center">
      <a href="/faq" class="inline-flex items-center gap-2 font-bold text-brand-700 hover:underline">View all questions <span aria-hidden="true">→</span></a>
    </div>
  )}
</section>
