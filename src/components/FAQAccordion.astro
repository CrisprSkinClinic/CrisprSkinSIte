---
// Reusable accordion for service/condition pages. Unlike FAQ.astro
// (which reads the global faqs collection directly with a limit prop),
// this takes already-resolved { question, answer } entries -- so it
// can render content sourced from faqIds (central repo) as well as
// any inline-written FAQs, with identical markup either way.
//
// `entries`: Array<{ question: string, answer: string }>
// `title`: optional heading override (defaults to "Frequently Asked Questions")
const { entries, title = "Frequently Asked Questions" } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": entries.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

{entries && entries.length > 0 && (
  <>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <section class="mx-auto max-w-4xl px-5 py-14 md:px-6">
      <p class="mb-2 text-center text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">Questions patients ask</p>
      <h2 class="mb-8 text-center text-3xl text-brand-900 md:text-4xl">{title}</h2>

      <div class="space-y-3">
        {entries.map((faq) => (
          <details class="group ui-card overflow-hidden open:border-brand-300 open:shadow-lg">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-sans text-base font-bold text-slate-900 transition-colors hover:text-brand-700 md:p-6 md:text-lg [&::-webkit-details-marker]:hidden">
              {faq.question}
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700 transition duration-300 group-open:rotate-45 group-open:bg-brand-600 group-open:text-white" aria-hidden="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </span>
            </summary>
            <div class="px-5 pb-6 leading-relaxed text-slate-600 md:px-6">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>
  </>
)}
