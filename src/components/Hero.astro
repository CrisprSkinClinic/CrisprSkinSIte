---
import { siteConfig } from '../config/site.js';
const { title: _title, subtitle, eyebrow, credentials, ctaText, whatsappText } = Astro.props;
---

<section class="relative overflow-hidden bg-brand-950 text-white">
  <div class="absolute inset-0">
    <img src="/images/hero-doctor.jpg" alt="" width="1400" height="900" loading="eager" fetchpriority="high" class="h-full w-full object-cover object-center opacity-55 md:object-[65%_center]" />
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/90 to-brand-900/20"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-brand-950/80 via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto grid min-h-[650px] max-w-7xl items-end px-6 pb-14 pt-24 md:min-h-[720px] md:items-center md:py-24 lg:grid-cols-[1.05fr_.95fr]">
    <div class="max-w-3xl reveal-up">
      <p class="mb-6 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.22em] text-brand-200"><span class="h-px w-10 bg-gold-400"></span>{credentials}</p>
      <p class="mb-4 text-sm font-semibold text-gold-300">{eyebrow}</p>
      <h1 class="max-w-3xl text-5xl leading-[1.02] text-white md:text-7xl lg:text-[5.25rem]">Dermatology that begins with <span class="italic text-brand-200">understanding.</span></h1>
      <p class="mt-7 max-w-2xl text-base leading-relaxed text-white/75 md:text-lg">{subtitle}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row reveal-up reveal-up-delay">
        <a href="/book" data-track="booking-click" class="inline-flex items-center justify-center gap-3 rounded-full bg-white px-7 py-4 text-sm font-bold text-brand-900 shadow-xl transition hover:-translate-y-0.5 hover:bg-brand-50">{ctaText}<span aria-hidden="true">→</span></a>
        <a href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-4 text-sm font-bold text-white backdrop-blur transition hover:bg-white/20">{whatsappText}</a>
      </div>
    </div>

    <div class="hidden self-end justify-self-end pb-3 lg:block">
      <div class="max-w-xs rounded-3xl border border-white/20 bg-white/10 p-6 backdrop-blur-md">
        <p class="font-display text-2xl leading-tight">Clear advice. Thoughtful treatment. Natural results.</p>
        <div class="mt-5 flex items-center gap-3 border-t border-white/15 pt-5 text-xs text-white/70"><span class="grid h-10 w-10 place-items-center rounded-full bg-gold-500 text-lg text-white">✓</span><span>Evidence-based care<br />without unnecessary procedures</span></div>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10 bg-brand-950/85 backdrop-blur">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px px-6 py-5 text-center text-xs font-semibold text-white/70 sm:grid-cols-4 md:text-sm"><span>Medical Dermatology</span><span>Hair Restoration</span><span>Aesthetic Care</span><span>Paediatric Skin</span></div>
  </div>
</section>
