<style is:global>
  /* Frosted-glass surface shared by the floating header and the mobile action bar */
  .glass {
    background: rgba(255, 255, 255, 0.62);
    -webkit-backdrop-filter: blur(22px) saturate(180%);
    backdrop-filter: blur(22px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 10px 36px rgba(31, 20, 48, 0.14), inset 0 1px 0 rgba(255, 255, 255, 0.65);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass { background: rgba(255, 255, 255, 0.97); }
  }
  @media (max-width: 1023px) {
    .site-header, #siteBottomBar { transition: transform .32s cubic-bezier(.22, .8, .24, 1); will-change: transform; }
    .site-header[data-hidden="true"] { transform: translateY(-115%); }
    #siteBottomBar[data-hidden="true"] { transform: translateY(140%); }
  }
  @media (prefers-reduced-motion: reduce) { .site-header, #siteBottomBar { transition: none !important; } }
</style>

<script>
  // Mobile: hide the header and the bottom action bar while scrolling down, bring them back on any scroll up,
  // at the very top, at the very bottom, or after the page has been still for a moment. Bound once per page
  // load of the app (the layout uses view transitions), looking the elements up fresh each time.
  if (!(window as any).__siteChromeBound) {
    (window as any).__siteChromeBound = true;
    let lastY = window.scrollY;
    let ticking = false;
    let idleTimer: number | undefined;
    const phone = () => window.matchMedia('(max-width: 1023px)').matches;
    const set = (el: HTMLElement | null, hidden: boolean) => { if (el) el.dataset.hidden = String(hidden); };
    const notify = () => window.setTimeout(() => document.dispatchEvent(new CustomEvent('sitebar:change')), 340);

    const update = () => {
      ticking = false;
      const header = document.getElementById('siteHeader');
      const bar = document.getElementById('siteBottomBar');
      const y = window.scrollY;
      const dy = y - lastY;
      lastY = y;
      if (!phone()) { set(header, false); set(bar, false); return; }
      const menuOpen = !document.getElementById('mobileMenuPanel')?.classList.contains('hidden');
      const atTop = y <= 8;
      const atBottom = window.innerHeight + y >= document.documentElement.scrollHeight - 8;
      if (atTop || menuOpen) { set(header, false); set(bar, false); }
      else if (Math.abs(dy) > 5) {
        const down = dy > 0;
        set(header, down && y > 90);
        set(bar, down && y > 90 && !atBottom);
      }
      if (atBottom) set(bar, false);
      window.clearTimeout(idleTimer);
      idleTimer = window.setTimeout(() => { set(bar, false); notify(); }, 1500);
      notify();
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    // Keyboard users: tabbing into the header or the bar must reveal it.
    document.addEventListener('focusin', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('#siteHeader')) set(document.getElementById('siteHeader'), false);
      if (t.closest('#siteBottomBar')) set(document.getElementById('siteBottomBar'), false);
    });
    document.addEventListener('astro:page-load', () => { lastY = window.scrollY; set(document.getElementById('siteHeader'), false); set(document.getElementById('siteBottomBar'), false); });
  }
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobileMenuBtn');
    const panel = document.getElementById('mobileMenuPanel');
    const iconOpen = document.getElementById('menuIconOpen');
    const iconClose = document.getElementById('menuIconClose');

    if (!btn || !panel || !iconOpen || !iconClose) return;

    btn.addEventListener('click', () => {
      const isHidden = panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(isHidden));
    });

    // Close menu when any link is tapped
    panel.querySelectorAll('nav > a, #mobileServicesSubmenu a, #mobileConditionsSubmenu a').forEach((link) => {
      link.addEventListener('click', () => {
        panel.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });

    // Services submenu toggle
    const servicesToggle = document.getElementById('mobileServicesToggle');
    const servicesSubmenu = document.getElementById('mobileServicesSubmenu');
    const servicesChevron = document.getElementById('mobileServicesChevron');

    if (servicesToggle && servicesSubmenu && servicesChevron) {
      servicesToggle.addEventListener('click', () => {
        const isHidden = servicesSubmenu.classList.contains('hidden');
        servicesSubmenu.classList.toggle('hidden');
        servicesSubmenu.classList.toggle('flex');
        servicesChevron.classList.toggle('rotate-180');
        servicesToggle.setAttribute('aria-expanded', String(isHidden));
      });
    }

    // Conditions submenu toggle (NEW)
    const conditionsToggle = document.getElementById('mobileConditionsToggle');
    const conditionsSubmenu = document.getElementById('mobileConditionsSubmenu');
    const conditionsChevron = document.getElementById('mobileConditionsChevron');

    if (conditionsToggle && conditionsSubmenu && conditionsChevron) {
      conditionsToggle.addEventListener('click', () => {
        const isHidden = conditionsSubmenu.classList.contains('hidden');
        conditionsSubmenu.classList.toggle('hidden');
        conditionsSubmenu.classList.toggle('flex');
        conditionsChevron.classList.toggle('rotate-180');
        conditionsToggle.setAttribute('aria-expanded', String(isHidden));
      });
    }
  });
</script>
