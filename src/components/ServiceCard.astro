---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  link: string;
  image?: ImageMetadata | string;
  alt?: string;
  priority?: boolean;
}

const { title, description, link, image, alt, priority = false } = Astro.props;

const isOptimized = image && typeof image === 'object' && 'src' in image;
---
<a href={link} class="ui-card overflow-hidden group flex flex-col h-full">
  
  <div class="relative aspect-[4/3] overflow-hidden bg-brand-50">
    {isOptimized ? (
      <Image
        src={image}
        alt={alt || title}
        width={500}
        height={500}
        widths={[300, 400, 500]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
        formats={['avif', 'webp']}
        quality={80}
        loading={priority ? "eager" : "lazy"}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    ) : image ? (
      <img
        src={image}
        alt={alt || title}
        width="500"
        height="500"
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    ) : (
      <!-- No photo yet: a neutral branded tile (no external placeholder request) -->
      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-50 to-champagne-100 p-8 text-center">
        <span class="font-serif text-2xl font-bold leading-snug text-brand-800/80">{title}</span>
      </div>
    )}
  </div>
  
  <div class="p-6 md:p-8 flex flex-col flex-grow">
    <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-brand-600 transition-colors">{title}</h3>
    <p class="text-slate-600 text-sm leading-relaxed mb-6 flex-grow">{description}</p>
    <span class="text-brand-600 font-semibold text-sm mt-auto flex items-center gap-1 group-hover:gap-2 transition-all">
      Learn More <span aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>
