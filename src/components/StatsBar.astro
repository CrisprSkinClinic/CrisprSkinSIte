---
// src/components/StatsBar.astro
const googleReviewsUrl = 'https://www.google.com/search?q=CRISPR+Skin+and+Hair+Clinic+KK+Nagar'; // replace with exact GBP reviews link

const stats = [
  {
    value: '4.9',
    label: 'Google rating',
    sub: '370+ patient reviews',
    href: googleReviewsUrl,
    featured: true,
  },
  {
    value: '3',
    label: 'AIIMS-trained consultant dermatologists',
  },
  {
    value: '5,000+',
    label: 'Patients counselled and treated',
  },
  {
    value: '20+',
    label: 'Years combined clinical experience',
  },
];
---

<section class="bg-champagne-50 py-14 md:py-16 px-6 border-y border-champagne-200">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {stats.map((stat) => {
        const cardClass = `rounded-2xl border p-6 md:p-8 text-center h-full flex flex-col items-center justify-center transition-all duration-300 ${
          stat.featured
            ? 'bg-brand-900 border-brand-800 text-white shadow-lg hover:shadow-xl'
            : 'bg-white border-champagne-200 text-slate-900 shadow-sm hover:shadow-md hover:border-brand-200'
        }`;

        const inner = (
          <>
            <div class="flex items-baseline justify-center gap-1.5">
              <p class={`text-4xl md:text-5xl font-extrabold tracking-tight ${stat.featured ? 'text-white' : 'text-brand-900'}`}>
                {stat.value}
              </p>
              {stat.featured && (
                <span class="text-xl text-amber-300" aria-hidden="true">★</span>
              )}
            </div>
            <p class={`mt-3 text-sm font-semibold leading-snug ${stat.featured ? 'text-brand-100' : 'text-slate-800'}`}>
              {stat.label}
            </p>
            {stat.sub && (
              <p class={`mt-1 text-xs ${stat.featured ? 'text-brand-300' : 'text-slate-500'}`}>
                {stat.sub}
              </p>
            )}
          </>
        );

        return stat.href ? (
          <a
            href={stat.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`${cardClass} group`}
          >
            {inner}
            <span class={`mt-3 text-xs font-medium ${stat.featured ? 'text-brand-200 group-hover:text-white' : 'text-brand-600'} transition-colors`}>
              View reviews →
            </span>
          </a>
        ) : (
          <div class={cardClass}>
            {inner}
          </div>
        );
      })}
    </div>

    <p class="mt-8 text-center text-sm text-slate-600 font-medium">
      Evaluation first. Procedures only when they fit.
    </p>
  </div>
</section>
