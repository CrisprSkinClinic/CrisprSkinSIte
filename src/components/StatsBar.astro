---
// src/components/StatsBar.astro
const googleReviewsUrl = 'https://www.google.com/search?q=CRISPR+Skin+and+Hair+Clinic+KK+Nagar'; // replace with exact GBP link

const stats = [
  {
    id: 'doctors',
    end: 3,
    decimals: 0,
    suffix: '',
    label: 'AIIMS-trained consultant dermatologists',
    badge: 'Core team',
  },
  {
    id: 'rating',
    end: 4.9,
    decimals: 1,
    suffix: '',
    label: 'Google rating',
    sub: '370+ patient reviews',
    href: googleReviewsUrl,
  },
  {
    id: 'patients',
    end: 5000,
    decimals: 0,
    suffix: '+',
    label: 'Patients counselled and treated',
  },
  {
    id: 'experience',
    end: 20,
    decimals: 0,
    suffix: '+',
    label: 'Years combined clinical experience',
  },
];
---

<section class="bg-champagne-50 py-14 md:py-16 px-6 border-y border-champagne-200">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6" id="statsBarGrid">
      {stats.map((stat) => {
        const cardClass =
          'rounded-2xl border border-champagne-200 bg-white p-7 md:p-8 text-center h-full flex flex-col items-center justify-center shadow-sm hover:shadow-lg hover:border-brand-200 hover:-translate-y-0.5 transition-all duration-300';

        const inner = (
          <>
            {stat.badge && (
              <span class="mb-3 inline-block text-[10px] font-bold uppercase tracking-wider text-brand-700 bg-brand-50 border border-brand-100 px-2.5 py-0.5 rounded-full">
                {stat.badge}
              </span>
            )}

            <p
              class="text-4xl md:text-5xl font-extrabold tracking-tight text-brand-900 tabular-nums"
              data-stat-value
              data-end={stat.end}
              data-decimals={stat.decimals}
              data-suffix={stat.suffix}
            >
              0{stat.suffix}
            </p>

            <p
              class={`mt-3 text-sm leading-snug ${
                stat.badge ? 'font-bold text-brand-900' : 'font-semibold text-slate-800'
              }`}
            >
              {stat.label}
            </p>

            {stat.sub && (
              <p class="mt-1 text-xs text-slate-500">{stat.sub}</p>
            )}
          </>
        );

        return stat.href ? (
          <a
            href={stat.href}
            target="_blank"
            rel="noopener noreferrer"
            class={`${cardClass} group`}
          >
            {inner}
            <span class="mt-3 text-xs font-semibold text-brand-600 group-hover:text-brand-800 transition-colors">
              View reviews →
            </span>
          </a>
        ) : (
          <div class={cardClass}>{inner}</div>
        );
      })}
    </div>
  </div>
</section>

<script>
  function animateValue(el, end, decimals, suffix, duration = 1400) {
    const start = 0;
    const startTime = performance.now();

    function frame(now) {
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = start + (end - start) * eased;
      el.textContent =
        (decimals > 0 ? current.toFixed(decimals) : Math.round(current).toLocaleString('en-IN')) +
        suffix;
      if (progress < 1) requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }

  function runStatsAnimation() {
    const nodes = document.querySelectorAll('[data-stat-value]');
    nodes.forEach((el) => {
      if (el.dataset.animated === 'true') return;
      el.dataset.animated = 'true';
      const end = parseFloat(el.dataset.end || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const suffix = el.dataset.suffix || '';
      animateValue(el, end, decimals, suffix);
    });
  }

  document.addEventListener('astro:page-load', () => {
    const grid = document.getElementById('statsBarGrid');
    if (!grid) return;

    grid.querySelectorAll('[data-stat-value]').forEach((el) => {
      el.dataset.animated = 'false';
      const suffix = el.dataset.suffix || '';
      el.textContent = '0' + suffix;
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runStatsAnimation();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );

    observer.observe(grid);
  });
</script>
