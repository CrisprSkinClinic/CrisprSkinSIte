---
// src/components/StatsBar.astro
const googleReviewsUrl = 'https://share.google/UGVT60Semdn8hnpuv';

const stats = [
  {
    id: 'doctors',
    end: 3,
    decimals: 0,
    suffix: '',
    label: 'AIIMS-trained dermatologists',
  },
  {
    id: 'rating',
    end: 4.9,
    decimals: 1,
    suffix: '',
    label: 'Google rating',
    sub: '370+ reviews',
    href: googleReviewsUrl,
  },
  {
    id: 'patients',
    end: 5000,
    decimals: 0,
    suffix: '+',
    label: 'Satisfied patients',
  },
  {
    id: 'experience',
    end: 20,
    decimals: 0,
    suffix: '+',
    label: 'Years combined experience',
  },
];
---

<section class="border-y border-slate-200/70 bg-white px-[22px] py-14 md:px-6 md:py-12">
  <div class="max-w-7xl mx-auto">
    <div
      id="statsBarGrid"
      class="overflow-hidden rounded-2xl bg-[#0d0e17] shadow-xl shadow-slate-950/10"
    >
      <div class="grid grid-cols-1 lg:grid-cols-4">
        {stats.map((stat, i) => {
          const cellClass = [
            'relative min-h-[170px] px-4 py-8 md:px-6 md:py-7 text-center flex flex-col items-center justify-center',
            i > 0 ? 'border-t border-white/10 lg:border-l lg:border-t-0' : '',
          ].join(' ');

          const inner = (
            <>
              <p
                class="text-4xl font-extrabold tracking-tight text-white tabular-nums"
                data-stat-value
                data-end={stat.end}
                data-decimals={stat.decimals}
                data-suffix={stat.suffix}
              >
                0{stat.suffix}
              </p>
              <p class="mt-3 max-w-[12rem] text-xs font-medium text-slate-300 leading-snug">
                {stat.label}
              </p>
              {stat.sub && (
                <p class="mt-1 text-[11px] text-slate-500">{stat.sub}</p>
              )}
            </>
          );

          return stat.href ? (
            <a
              href={stat.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`${cellClass} group hover:bg-white/[0.04] transition-colors`}
            >
              {inner}
              <span class="mt-4 text-[11px] font-medium text-slate-400 group-hover:text-white transition-colors">
                View reviews →
              </span>
            </a>
          ) : (
            <div class={cellClass}>{inner}</div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  function animateValue(el, end, decimals, suffix, duration = 1400) {
    const start = 0;
    const startTime = performance.now();

    function frame(now) {
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = start + (end - start) * eased;
      el.textContent =
        (decimals > 0 ? current.toFixed(decimals) : Math.round(current).toLocaleString('en-IN')) +
        suffix;
      if (progress < 1) requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }

  function runStatsAnimation() {
    document.querySelectorAll('[data-stat-value]').forEach((el) => {
      if (el.dataset.animated === 'true') return;
      el.dataset.animated = 'true';
      const end = parseFloat(el.dataset.end || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const suffix = el.dataset.suffix || '';
      animateValue(el, end, decimals, suffix);
    });
  }

  document.addEventListener('astro:page-load', () => {
    const grid = document.getElementById('statsBarGrid');
    if (!grid) return;

    grid.querySelectorAll('[data-stat-value]').forEach((el) => {
      el.dataset.animated = 'false';
      el.textContent = '0' + (el.dataset.suffix || '');
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runStatsAnimation();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );

    observer.observe(grid);
  });
</script>
