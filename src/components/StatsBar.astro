---
// src/components/StatsBar.astro
import Icon from './ui/Icon.astro';
import ClinicIcon from './ui/ClinicIcon.astro';
const googleReviewsUrl = 'https://share.google/UGVT60Semdn8hnpuv';

const stats = [
  {
    id: 'doctors',
    icon: 'doctor',
    end: 3,
    decimals: 0,
    suffix: '',
    label: 'AIIMS-trained dermatologists',
  },
  {
    id: 'rating',
    icon: 'rating',
    stars: true,
    end: 4.9,
    decimals: 1,
    suffix: '',
    label: 'Google rating',
    sub: '370+ reviews',
    href: googleReviewsUrl,
  },
  {
    id: 'patients',
    icon: 'patients',
    end: 10000,
    decimals: 0,
    suffix: '+',
    label: 'Satisfied patients',
  },
  {
    id: 'experience',
    icon: 'experience',
    end: 20,
    decimals: 0,
    suffix: '+',
    label: 'Years combined experience',
  },
];
---

<section class="relative z-10 -mt-12 px-4 pb-8 md:-mt-16 md:px-6 md:pb-14" aria-label="Clinic highlights">
  <div class="mx-auto max-w-7xl">
    <div class="stats-band relative overflow-hidden rounded-[2rem] bg-[linear-gradient(120deg,#2b1733_0%,#503057_48%,#7E4D8B_100%)] p-1.5 shadow-[0_34px_80px_-24px_rgba(56,34,61,0.65)] md:rounded-[2.6rem]">
      <div class="pointer-events-none absolute -left-24 -top-28 h-80 w-80 rounded-full bg-accent-500/30 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 -right-16 h-80 w-80 rounded-full bg-brand-300/25 blur-3xl" aria-hidden="true"></div>
      <div class="stats-sheen pointer-events-none absolute inset-y-0 -left-1/3 w-1/3 skew-x-[-18deg] bg-gradient-to-r from-transparent via-white/15 to-transparent" aria-hidden="true"></div>

      <div id="statsBarGrid" class="relative grid grid-cols-2 overflow-hidden rounded-[1.7rem] bg-white/[0.045] ring-1 ring-white/10 backdrop-blur-sm md:rounded-[2.2rem] lg:grid-cols-4">
        {stats.map((stat, i) => {
          const cell = [
            'group relative flex flex-col items-start p-5 transition-colors duration-300 hover:bg-white/[0.07] md:p-9',
            i % 2 === 1 ? 'border-l border-white/10' : '',
            i > 1 ? 'border-t border-white/10 lg:border-t-0' : '',
            i > 0 ? 'lg:border-l lg:border-white/10' : '',
          ].join(' ');
          const inner = (
            <>
              <span class="mb-5 grid h-14 w-14 place-items-center rounded-2xl bg-white/10 text-white ring-1 ring-white/15 transition duration-300 [--ic-accent:#F0A6C8] group-hover:-translate-y-0.5 group-hover:bg-white/15 md:h-16 md:w-16" aria-hidden="true">
                <ClinicIcon name={stat.icon} class="h-9 w-9 md:h-10 md:w-10" stroke={2} />
              </span>
              <p
                class="bg-gradient-to-b from-white to-brand-200 bg-clip-text font-display text-[2.9rem] leading-[0.95] tracking-tight text-transparent tabular-nums md:text-[4.6rem]"
                data-stat-value
                data-end={stat.end}
                data-decimals={stat.decimals}
                data-suffix={stat.suffix}
              >
                0{stat.suffix}
              </p>
              {stat.stars && (
                <span class="mt-3 flex gap-1 text-amber-300 drop-shadow-[0_0_8px_rgba(252,211,77,0.55)]" aria-hidden="true">
                  {[0, 1, 2, 3, 4].map(() => <Icon name="star" class="h-4 w-4 md:h-[1.1rem] md:w-[1.1rem]" fill="currentColor" stroke={0} />)}
                </span>
              )}
              <p class="mt-3 text-[11px] font-bold uppercase leading-snug tracking-[0.14em] text-white/85 md:text-[13px]">{stat.label}</p>
              {stat.sub && <p class="mt-1 text-xs text-white/60">{stat.sub}</p>}
              {stat.href && (
                <span class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-accent-300 transition group-hover:gap-1.5">
                  Read reviews <Icon name="arrow-right" class="h-3.5 w-3.5" stroke={2.4} />
                </span>
              )}
            </>
          );
          return stat.href ? (
            <a href={stat.href} target="_blank" rel="noopener noreferrer" class={cell}>{inner}</a>
          ) : (
            <div class={cell}>{inner}</div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    @keyframes stats-sheen { from { transform: translateX(0) skewX(-18deg); } to { transform: translateX(520%) skewX(-18deg); } }
    .stats-sheen { animation: stats-sheen 2.4s .5s var(--ease-out, ease-out) 1 both; }
  }
</style>

<script>
  function animateValue(el, end, decimals, suffix, duration = 1400) {
    const start = 0;
    const startTime = performance.now();

    function frame(now) {
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = start + (end - start) * eased;
      el.textContent =
        (decimals > 0 ? current.toFixed(decimals) : Math.round(current).toLocaleString('en-IN')) +
        suffix;
      if (progress < 1) requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }

  function runStatsAnimation() {
    document.querySelectorAll('[data-stat-value]').forEach((el) => {
      if (el.dataset.animated === 'true') return;
      el.dataset.animated = 'true';
      const end = parseFloat(el.dataset.end || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const suffix = el.dataset.suffix || '';
      animateValue(el, end, decimals, suffix);
    });
  }

  document.addEventListener('astro:page-load', () => {
    const grid = document.getElementById('statsBarGrid');
    if (!grid) return;

    grid.querySelectorAll('[data-stat-value]').forEach((el) => {
      el.dataset.animated = 'false';
      el.textContent = '0' + (el.dataset.suffix || '');
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runStatsAnimation();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );

    observer.observe(grid);
  });
</script>
