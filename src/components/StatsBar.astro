---
// src/components/StatsBar.astro
const googleReviewsUrl = 'https://share.google/UGVT60Semdn8hnpuv';

const stats = [
  {
    id: 'doctors',
    end: 3,
    decimals: 0,
    suffix: '',
    label: 'AIIMS-trained dermatologists',
  },
  {
    id: 'rating',
    end: 4.9,
    decimals: 1,
    suffix: '',
    label: 'Google rating',
    sub: '370+ reviews',
    href: googleReviewsUrl,
  },
  {
    id: 'patients',
    end: 10000,
    decimals: 0,
    suffix: '+',
    label: 'Satisfied patients',
  },
  {
    id: 'experience',
    end: 20,
    decimals: 0,
    suffix: '+',
    label: 'Years combined experience',
  },
];
---

<section class="border-y border-[#eaddea] bg-[#fbf8fc] px-[22px] py-10 md:px-6 md:py-12">
  <div class="max-w-7xl mx-auto">
    <div
      id="statsBarGrid"
      class="overflow-hidden rounded-2xl border border-[#e5d5e7] bg-white shadow-xl shadow-[#54295f]/[0.08]"
    >
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {stats.map((stat, i) => {
          const cellClass = [
            'relative min-h-[154px] px-3 py-7 md:min-h-[170px] md:px-6 md:py-7 text-center flex flex-col items-center justify-center bg-[radial-gradient(circle_at_top,_rgba(226,72,145,0.08),_transparent_58%)]',
            i % 2 === 1 ? 'border-l border-[#eaddea] lg:border-l' : 'lg:border-l',
            i > 1 ? 'border-t border-[#eaddea] lg:border-t-0' : '',
            i === 0 ? 'lg:border-l-0' : '',
          ].join(' ');

          const inner = (
            <>
              <p
                class="text-[2.15rem] font-extrabold tracking-tight text-[#6f3578] tabular-nums md:text-4xl"
                data-stat-value
                data-end={stat.end}
                data-decimals={stat.decimals}
                data-suffix={stat.suffix}
              >
                0{stat.suffix}
              </p>
              <p class="mt-3 max-w-[10rem] text-[11px] font-semibold text-[#3f3344] leading-snug md:max-w-[12rem] md:text-xs">
                {stat.label}
              </p>
              {stat.sub && (
                <p class="mt-1 text-[10px] text-[#927e96] md:text-[11px]">{stat.sub}</p>
              )}
            </>
          );

          return stat.href ? (
            <a
              href={stat.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`${cellClass} group hover:bg-[#faf5fb] transition-colors`}
            >
              {inner}
              <span class="mt-3 text-[10px] font-semibold text-[#a3478e] group-hover:text-[#6f3578] transition-colors md:mt-4 md:text-[11px]">
                View reviews →
              </span>
            </a>
          ) : (
            <div class={cellClass}>{inner}</div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  function animateValue(el, end, decimals, suffix, duration = 1400) {
    const start = 0;
    const startTime = performance.now();

    function frame(now) {
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const current = start + (end - start) * eased;
      el.textContent =
        (decimals > 0 ? current.toFixed(decimals) : Math.round(current).toLocaleString('en-IN')) +
        suffix;
      if (progress < 1) requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }

  function runStatsAnimation() {
    document.querySelectorAll('[data-stat-value]').forEach((el) => {
      if (el.dataset.animated === 'true') return;
      el.dataset.animated = 'true';
      const end = parseFloat(el.dataset.end || '0');
      const decimals = parseInt(el.dataset.decimals || '0', 10);
      const suffix = el.dataset.suffix || '';
      animateValue(el, end, decimals, suffix);
    });
  }

  document.addEventListener('astro:page-load', () => {
    const grid = document.getElementById('statsBarGrid');
    if (!grid) return;

    grid.querySelectorAll('[data-stat-value]').forEach((el) => {
      el.dataset.animated = 'false';
      el.textContent = '0' + (el.dataset.suffix || '');
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runStatsAnimation();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.35 }
    );

    observer.observe(grid);
  });
</script>
