---
// "What brings you in?" Problem-first navigation: patients start from what they notice, not from a treatment name.
const concerns = [
  { title: 'Hair fall & thinning', hint: 'Shedding, widening parting, receding hairline', href: '/services/hair-loss', icon: '<path d="M9.59 4.59A2 2 0 1 1 11 8H2m10.59 11.41A2 2 0 1 0 14 16H2m15.73-8.27A2.5 2.5 0 1 1 19.5 12H2"/>' },
  { title: 'Acne & acne scars', hint: 'Breakouts, marks, pits and texture', href: '/services/acne', icon: '<circle cx="12" cy="12" r="10"/><circle cx="9" cy="10" r=".8" fill="currentColor"/><circle cx="15" cy="9" r=".8" fill="currentColor"/><circle cx="13" cy="15" r=".8" fill="currentColor"/>' },
  { title: 'Pigmentation & melasma', hint: 'Dark patches, uneven tone, sun marks', href: '/services/pigmentation', icon: '<path d="M12 2.7s7 6.3 7 11.3a7 7 0 0 1-14 0c0-5 7-11.3 7-11.3z"/>' },
  { title: 'White patches', hint: 'Vitiligo and loss of skin colour', href: '/services/vitiligo', icon: '<circle cx="12" cy="12" r="10"/><path d="M12 18a6 6 0 0 0 0-12v12z" fill="currentColor"/>' },
  { title: 'Itchy, scaly skin', hint: 'Psoriasis, eczema, rashes, allergies', href: '/services/psoriasis', icon: '<path d="M12 2l9 5-9 5-9-5z"/><path d="M3 12l9 5 9-5"/><path d="M3 17l9 5 9-5"/>' },
  { title: 'Hair transplant', hint: 'Surgical hair restoration (FUE)', href: '/services/hair-transplant-fue', icon: '<path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>' },
  { title: 'Skin & anti-ageing', hint: 'Lines, volume, glow, peels, Botox', href: '/services/anti-ageing', icon: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.7 1.8L21.5 17.5l-1.8.7L19 20l-.7-1.8-1.8-.7 1.8-.7z"/>' },
  { title: "Children's skin", hint: 'Eczema, birthmarks, warts, rashes', href: '/services/pediatric-dermatology', icon: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01M15 9h.01"/>' },
];
---
<section class="mx-auto max-w-7xl px-5 py-16 md:px-6 md:py-24">
  <div class="mx-auto mb-10 max-w-2xl text-center md:mb-14">
    <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">Start with what you notice</p>
    <h2 class="text-4xl text-brand-900 md:text-5xl">What brings you in?</h2>
    <p class="mt-4 text-lg text-slate-600">Choose the closest match. You will land on a plain-language page written by our doctors, with the option to book right there.</p>
  </div>

  <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {concerns.map((c) => (
      <a href={c.href} class="ui-card group flex flex-col gap-3 p-4 sm:p-6">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-brand-50 text-brand-700 transition duration-300 group-hover:bg-brand-600 group-hover:text-white" aria-hidden="true">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon}></svg>
        </span>
        <span>
          <span class="block font-sans text-[15px] font-bold leading-snug text-slate-900 transition-colors group-hover:text-brand-700 sm:text-base">{c.title}</span>
          <span class="mt-1 hidden text-sm leading-snug text-slate-500 sm:block">{c.hint}</span>
        </span>
      </a>
    ))}
  </div>

  <div class="mt-8 flex flex-col items-center justify-center gap-3 text-center sm:flex-row">
    <p class="text-slate-600">Not sure which one fits?</p>
    <a href="/book/" data-track="booking-click" class="inline-flex min-h-[48px] items-center gap-2 rounded-2xl bg-brand-800 px-6 font-bold text-white shadow-lg shadow-brand-900/20 transition hover:bg-brand-700 active:scale-[0.98]">Book a consultation <span aria-hidden="true">→</span></a>
  </div>
</section>
