---
// "What brings you in?" Problem-first navigation: patients start from what they notice, not from a treatment name.
const concerns = [
  { title: 'Hair fall & thinning', hint: 'Shedding, widening parting, receding hairline', href: '/services/hair-loss', icon: 'hair' },
  { title: 'Acne & acne scars', hint: 'Breakouts, marks, pits and texture', href: '/services/acne', icon: 'acne' },
  { title: 'Pigmentation & melasma', hint: 'Dark patches, uneven tone, sun marks', href: '/services/pigmentation', icon: 'pigment' },
  { title: 'White patches', hint: 'Vitiligo and loss of skin colour', href: '/services/vitiligo', icon: 'vitiligo' },
  { title: 'Itchy, scaly skin', hint: 'Psoriasis, eczema, rashes, allergies', href: '/services/psoriasis', icon: 'scaly' },
  { title: 'Hair transplant', hint: 'Surgical hair restoration (FUE)', href: '/services/hair-transplant-fue', icon: 'transplant' },
  { title: 'Skin & anti-ageing', hint: 'Lines, volume, glow, peels, Botox', href: '/services/anti-ageing', icon: 'cosmetic' },
  { title: "Children's skin", hint: 'Eczema, birthmarks, warts, rashes', href: '/services/pediatric-dermatology', icon: 'kids' },
];
import ClinicIcon from '../ui/ClinicIcon.astro';
import Icon from '../ui/Icon.astro';
---
<section class="mx-auto max-w-7xl px-5 py-16 md:px-6 md:py-24">
  <div class="mx-auto mb-10 max-w-2xl text-center md:mb-14">
    <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">Start with what you notice</p>
    <h2 class="text-4xl text-brand-900 md:text-5xl">What brings you in?</h2>
    <p class="mt-4 text-lg text-slate-600">Choose the closest match. You will land on a plain-language page written by our doctors, with the option to book right there.</p>
  </div>

  <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    {concerns.map((c) => (
      <a href={c.href} class="ui-card group flex flex-col gap-3 p-4 sm:p-6">
        <span class="relative grid h-16 w-16 place-items-center rounded-[1.25rem] bg-gradient-to-br from-brand-50 to-brand-100 text-brand-700 shadow-inner ring-1 ring-brand-200/70 transition duration-300 [--ic-accent:#C36F9A] group-hover:scale-105 group-hover:from-brand-500 group-hover:to-brand-700 group-hover:text-white group-hover:ring-transparent group-hover:[--ic-accent:#F7D3E6]" aria-hidden="true">
          <ClinicIcon name={c.icon} class="h-10 w-10" stroke={2} />
        </span>
        <span>
          <span class="flex items-start justify-between gap-2"><span class="block font-sans text-[15px] font-bold leading-snug text-slate-900 transition-colors group-hover:text-brand-700 sm:text-base">{c.title}</span><Icon name="arrow-right" class="mt-0.5 hidden h-4 w-4 shrink-0 text-brand-400 opacity-0 transition duration-300 group-hover:translate-x-0.5 group-hover:opacity-100 sm:block" stroke={2.2} /></span>
          <span class="mt-1 hidden text-sm leading-snug text-slate-500 sm:block">{c.hint}</span>
        </span>
      </a>
    ))}
  </div>

  <div class="mt-8 flex flex-col items-center justify-center gap-3 text-center sm:flex-row">
    <p class="text-slate-600">Not sure which one fits?</p>
    <a href="/book/" data-track="booking-click" class="inline-flex min-h-[48px] items-center gap-2 rounded-2xl bg-brand-800 px-6 font-bold text-white shadow-lg shadow-brand-900/20 transition hover:bg-brand-700 active:scale-[0.98]">Book a consultation <span aria-hidden="true">→</span></a>
  </div>
</section>
