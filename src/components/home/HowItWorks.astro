---
const steps = [
  { n: '1', title: 'Pick a slot', body: 'See real availability and book in about a minute. You confirm with a WhatsApp OTP, so no account or password.', icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>' },
  { n: '2', title: 'Meet your dermatologist', body: 'A careful examination and a clear conversation. We tell you what it is, and what it is not.', icon: '<path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/>' },
  { n: '3', title: 'Get a plan that fits', body: 'Simple options in plain language, with realistic timelines. Treatment only when it is indicated.', icon: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>' },
];
---
<section class="bg-gradient-to-b from-brand-50/60 to-transparent px-5 py-16 md:px-6 md:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">How it works</p>
      <h2 class="text-4xl text-brand-900 md:text-5xl">Consultation first. Always.</h2>
    </div>
    <ol class="relative grid gap-5 md:grid-cols-3">
      <span class="absolute left-[16.7%] right-[16.7%] top-[2.4rem] hidden h-px border-t-2 border-dashed border-brand-200 md:block" aria-hidden="true"></span>
      {steps.map((s) => (
        <li class="ui-card relative p-7 text-center">
          <span class="relative mx-auto mb-5 grid h-[4.5rem] w-[4.5rem] place-items-center rounded-full bg-white shadow-md ring-8 ring-brand-50">
            <span class="grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon}></svg>
            </span>
            <span class="absolute -right-1 -top-1 grid h-6 w-6 place-items-center rounded-full bg-accent-500 text-[11px] font-bold text-white">{s.n}</span>
          </span>
          <h3 class="mb-2 font-sans text-lg font-bold text-brand-900">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-slate-600">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
