---
import ClinicIcon from '../ui/ClinicIcon.astro';
const steps = [
  { n: '1', title: 'Pick a slot', body: 'See real availability and book in about a minute. You confirm with a WhatsApp OTP, so no account or password.', icon: 'slot' },
  { n: '2', title: 'Meet your dermatologist', body: 'A careful examination and a clear conversation. We tell you what it is, and what it is not.', icon: 'examine' },
  { n: '3', title: 'Get a plan that fits', body: 'Simple options in plain language, with realistic timelines. Treatment only when it is indicated.', icon: 'plan' },
];
---
<section class="bg-gradient-to-b from-brand-50/60 to-transparent px-5 py-16 md:px-6 md:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">How it works</p>
      <h2 class="text-4xl text-brand-900 md:text-5xl">Consultation first. Always.</h2>
    </div>
    <ol class="relative grid gap-5 md:grid-cols-3">
      <span class="absolute left-[16.7%] right-[16.7%] top-[2.4rem] hidden h-px border-t-2 border-dashed border-brand-200 md:block" aria-hidden="true"></span>
      {steps.map((s) => (
        <li class="ui-card relative p-7 text-center">
          <span class="relative mx-auto mb-5 grid h-[4.5rem] w-[4.5rem] place-items-center rounded-full bg-white shadow-md ring-8 ring-brand-50">
            <span class="grid h-14 w-14 place-items-center rounded-full bg-gradient-to-br from-brand-500 to-brand-700 text-white [--ic-accent:#F7D3E6]">
              <ClinicIcon name={s.icon} class="h-9 w-9" stroke={2} />
            </span>
            <span class="absolute -right-1 -top-1 grid h-6 w-6 place-items-center rounded-full bg-accent-500 text-[11px] font-bold text-white">{s.n}</span>
          </span>
          <h3 class="mb-2 font-sans text-lg font-bold text-brand-900">{s.title}</h3>
          <p class="text-[15px] leading-relaxed text-slate-600">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
