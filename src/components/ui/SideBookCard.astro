---
// Sticky "talk to a dermatologist" card shown beside the content on wide screens.
import { siteConfig } from '../../config/site.js';
const { target = '#book', heading = 'Talk to a dermatologist' } = Astro.props;
const tel = siteConfig.contact.phone.replace(/[^0-9+]/g, '');
---
<div class="ui-card overflow-hidden">
  <img src="/images/clinic/waiting-area.jpg" alt={`Waiting area at ${siteConfig.name}`} width="340" height="220" loading="lazy" decoding="async" class="h-36 w-full object-cover" />
  <div class="p-6">
    <div data-shuffle class="mb-4 flex -space-x-2.5" aria-hidden="true">
      {siteConfig.doctors.map((d) => (
        <img src={`/images/doctors/${d.slug}.jpg`} alt="" width="40" height="40" loading="lazy" class="h-10 w-10 rounded-full border-2 border-white object-cover object-top shadow-sm" />
      ))}
    </div>
    <h2 class="font-sans text-lg font-bold leading-snug text-brand-900">{heading}</h2>
    <p class="mt-1.5 text-sm leading-relaxed text-slate-600">Consultation first. Treatment only when indicated, with an AIIMS-trained dermatologist.</p>
    <a href={target} data-track="booking-click" class="mt-5 flex min-h-[48px] items-center justify-center gap-2 rounded-2xl bg-brand-800 px-5 text-sm font-bold text-white shadow-md shadow-brand-900/20 transition hover:bg-brand-700 active:scale-[0.98]">Book a consultation <span aria-hidden="true">→</span></a>
    <div class="mt-2.5 grid grid-cols-2 gap-2.5">
      <a href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="flex min-h-[44px] items-center justify-center rounded-2xl border border-emerald-200 bg-emerald-50 text-sm font-bold text-emerald-800 transition hover:bg-emerald-100">WhatsApp</a>
      <a href={`tel:${tel}`} class="flex min-h-[44px] items-center justify-center rounded-2xl border border-slate-200 bg-white text-sm font-bold text-slate-800 transition hover:bg-slate-50">Call</a>
    </div>
    <p class="mt-4 border-t border-slate-100 pt-3.5 text-xs leading-relaxed text-slate-500">{siteConfig.contact.workingHoursDisplay}</p>
  </div>
</div>
