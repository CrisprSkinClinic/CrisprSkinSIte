---
import { ViewTransitions } from 'astro:transitions'; 
import FloatingContact from '../components/FloatingContact.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site.js';
import '../styles/global.css';

// Accept SEO properties from individual pages, with safe fallbacks
const { 
  title, 
  description = siteConfig.description,
  image = '/images/og-default.jpg', // Default link-sharing image (1200x630)
  type = 'website',
  // Defaults to indexed (false) -- only internal/non-public pages like
  // Utility pages may pass true here. Ad landing pages use their own
  // LandingPageLayout, which already handles noindex separately.
  noindex = false,
  // Focused pages (e.g. registration) hide the site header, footer and bottom action bar.
  bare = false,
} = Astro.props;

// Automatically generate the exact canonical URL for the current page
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteConfig.url);

// ---- Search-snippet hygiene ----------------------------------------------------------------------
// Titles: pages pass a plain title; the brand is appended only when the whole thing stays within ~60
// characters (Google truncates beyond that). A brand suffix already on the title is removed first so it is
// never doubled.
const baseTitle = String(title).replace(/\s*[|\u2013-]\s*CRISPR[^|]*$/i, '').trim();
const withBrand = `${baseTitle} | ${siteConfig.titleSuffix}`;
const fullTitle = withBrand.length <= 60 ? withBrand : baseTitle;
// Descriptions: keep within ~155 characters, cutting at a sentence or word boundary.
const clip = (text, max = 155) => {
  const t = String(text || '').replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  const cut = t.slice(0, max - 1);
  const sentence = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf(': '));
  return sentence > max * 0.6 ? cut.slice(0, sentence + 1) : cut.slice(0, cut.lastIndexOf(' ')).replace(/[,;:\-\u2013]$/, '') + '\u2026';
};
const metaDescription = clip(description);

// ---- Structured data -----------------------------------------------------------------------------
// The clinic entity is described once, on the pages that are about the clinic itself, instead of repeating
// it (and all three doctors) on all 180 pages. Other pages carry only their own page-specific schema.
const path = Astro.url.pathname;
const clinicId = `${siteConfig.url}/#clinic`;
const showClinic = ['/', '/contact/', '/book/'].includes(path) || path.startsWith('/our-doctors');
const doctorsToShow = path === '/' || path === '/our-doctors/'
  ? siteConfig.doctors
  : siteConfig.doctors.filter((d) => path.startsWith(`/our-doctors/${d.slug}`));
const mapUrl = siteConfig.contact.googleMapsUrl || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${siteConfig.name}, ${siteConfig.contact.address.street}, ${siteConfig.contact.address.locality}, ${siteConfig.contact.address.city}`)}`;
---

<!DOCTYPE html>
<html lang="en-IN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    
    <ViewTransitions />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(image, Astro.site || siteConfig.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={metaDescription} />
    <meta property="twitter:image" content={new URL(image, Astro.site || siteConfig.url)} />

    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6JTEB0S8T0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6JTEB0S8T0');
    </script>

    {showClinic && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": ["MedicalClinic", "Dermatology"],
        "@id": clinicId,
        "name": siteConfig.name,
        "url": siteConfig.url,
        "description": siteConfig.description,
        "image": new URL('/images/hero-doctor.jpg', siteConfig.url).toString(),
        "logo": new URL('/images/crispr-logo.png', siteConfig.url).toString(),
        "telephone": siteConfig.contact.phone,
        "email": siteConfig.contact.email,
        "priceRange": "\u20B9\u20B9",
        "medicalSpecialty": "Dermatology",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": siteConfig.contact.address.street,
          "addressLocality": siteConfig.contact.address.locality,
          "addressRegion": siteConfig.contact.address.state,
          "postalCode": siteConfig.contact.address.postalCode,
          "addressCountry": "IN"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": siteConfig.contact.geo?.latitude,
          "longitude": siteConfig.contact.geo?.longitude
        },
        "hasMap": mapUrl,
        "openingHours": siteConfig.contact.workingHours,
        "areaServed": { "@type": "City", "name": "Chennai" },
        ...(siteConfig.contact.sameAs?.length ? { "sameAs": siteConfig.contact.sameAs } : {})
      })} />
    )}

    {showClinic && doctorsToShow.map((doc) => (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Physician",
        "@id": `${siteConfig.url}/our-doctors/${doc.slug}/#physician`,
        "name": doc.name,
        "url": new URL(`/our-doctors/${doc.slug}/`, siteConfig.url).toString(),
        "medicalSpecialty": "Dermatology",
        "jobTitle": doc.designation,
        "image": new URL(`/images/doctors/${doc.slug}.jpg`, siteConfig.url).toString(),
        "telephone": siteConfig.contact.phone,
        "worksFor": { "@id": clinicId },
        "address": {
          "@type": "PostalAddress",
          "streetAddress": siteConfig.contact.address.street,
          "addressLocality": siteConfig.contact.address.locality,
          "addressRegion": siteConfig.contact.address.state,
          "postalCode": siteConfig.contact.address.postalCode,
          "addressCountry": "IN"
        }
      })} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <noscript><style>[data-shuffle],[data-rotate]{visibility:visible!important;animation:none!important}</style></noscript>
  </head>

  <body class="bg-warmwhite text-charcoal antialiased selection:bg-brand-200 selection:text-brand-900 flex flex-col min-h-screen pb-20 md:pb-0">
    
    {!bare && <Navbar />}
    
    <main class="flex-grow overflow-hidden">
      <slot />
    </main>
    
    {!bare && <Footer />}

    {!bare && <FloatingContact />}


    <script is:inline>
      // Equal billing for the doctors: any element marked data-shuffle gets its children put in a fresh
      // random order on every page load, so no doctor is always first. The pages are static, so this has to
      // happen in the browser. It is inline (not bundled) so it runs as soon as the page is parsed, on first
      // load, on view-transition navigations and on back/forward cache restores.
      (function () {
        function shuffleAll() {
          document.querySelectorAll('[data-shuffle]:not([data-shuffled])').forEach(function (el) {
            var kids = Array.prototype.slice.call(el.children);
            for (var i = kids.length - 1; i > 0; i--) {
              var j = Math.floor(Math.random() * (i + 1));
              var tmp = kids[i]; kids[i] = kids[j]; kids[j] = tmp;
            }
            // Scroll-snap carousels (the phone layout) remember which card was snapped and re-snap to it after
            // the cards move, which carried the carousel to whichever doctor used to be first. Turn snapping
            // off while reordering, start at the left edge, then turn it back on.
            el.style.scrollSnapType = 'none';
            kids.forEach(function (k) { el.appendChild(k); });
            el.scrollLeft = 0;
            requestAnimationFrame(function () { el.scrollLeft = 0; el.style.scrollSnapType = ''; });
            el.setAttribute('data-shuffled', '');
          });
        }
        document.addEventListener('DOMContentLoaded', shuffleAll);
        document.addEventListener('astro:page-load', shuffleAll);
        document.addEventListener('astro:after-swap', shuffleAll);
        window.addEventListener('pageshow', function (e) {
          if (e.persisted) { document.querySelectorAll('[data-shuffled]').forEach(function (el) { el.removeAttribute('data-shuffled'); }); shuffleAll(); }
        });
        if (document.readyState !== 'loading') shuffleAll();
      })();
    </script>

    <script>
      // GA4 conversion tracking via event delegation -- a single
      // document-level click listener catches phone, WhatsApp, and
      // directions links anywhere on the site (including ones added
      // later) without needing to wire each link individually.
      // Booking click/completion are tracked separately: click via
      // data-track="booking-click" on Book Now buttons/links, and
      // completion fires directly from BookingCalendar.astro's
      // confirm handler once public-book-appointment.js succeeds.
      document.addEventListener('astro:page-load', () => {
        document.addEventListener('click', (e) => {
          if (typeof gtag !== 'function') return;

          const link = e.target.closest('a');
          if (!link) return;

          const href = link.getAttribute('href') || '';

          if (href.startsWith('tel:')) {
            gtag('event', 'phone_call_click', {
              event_category: 'engagement',
              event_label: href.replace('tel:', ''),
            });
            return;
          }

          if (href.includes('wa.me') || href.includes('whatsapp.com')) {
            gtag('event', 'whatsapp_click', {
              event_category: 'engagement',
              event_label: 'whatsapp_button',
            });
            return;
          }

          if (href.includes('google.com/maps') || href.includes('goo.gl/maps')) {
            gtag('event', 'directions_click', {
              event_category: 'engagement',
              event_label: 'get_directions',
            });
            return;
          }

          if (href.startsWith('mailto:')) {
            gtag('event', 'email_click', {
              event_category: 'engagement',
              event_label: href.replace('mailto:', ''),
            });
            return;
          }

          if (link.dataset.track === 'booking-click') {
            gtag('event', 'booking_click', {
              event_category: 'engagement',
              event_label: link.dataset.trackLabel || 'book_now_button',
            });
          }
        });
      });

      // Scroll depth tracking: fires once each at 50% and 90% of
      // total page height. Reset per navigation (ViewTransitions
      // swaps content without a full reload) so depth re-fires on
      // every new page rather than only the first.
      document.addEventListener('astro:page-load', () => {
        let firedDepths = { 50: false, 90: false };

        function checkScrollDepth() {
          if (typeof gtag !== 'function') return;

          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight <= 0) return;

          const percentScrolled = (scrollTop / docHeight) * 100;

          if (!firedDepths[50] && percentScrolled >= 50) {
            firedDepths[50] = true;
            gtag('event', 'scroll_depth_50', {
              event_category: 'engagement',
              event_label: window.location.pathname,
            });
          }
          if (!firedDepths[90] && percentScrolled >= 90) {
            firedDepths[90] = true;
            gtag('event', 'scroll_depth_90', {
              event_category: 'engagement',
              event_label: window.location.pathname,
            });
          }
        }

        window.addEventListener('scroll', checkScrollDepth, { passive: true });
      });

      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.15 
      };

      const observer = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('opacity-100', 'translate-y-0');
            entry.target.classList.remove('opacity-0', 'translate-y-12');
            observer.unobserve(entry.target); 
          }
        });
      }, observerOptions);

      // Listen to 'astro:page-load' instead of 'DOMContentLoaded' to work perfectly with ViewTransitions
      document.addEventListener('astro:page-load', () => {
        // Only apply the scroll-reveal animation on the homepage --
        // applying it sitewide caused content (like blog post grids)
        // to appear blank until scrolled into view on other pages.
        if (window.location.pathname !== '/') return;

        const elements = document.querySelectorAll('main section > div');
        elements.forEach((el) => {
          el.classList.add('transition-all', 'duration-[1200ms]', 'ease-out', 'opacity-0', 'translate-y-12');
          observer.observe(el);
        });
      });
    </script>
    
    <style is:global>
      /* Enforce the new premium font globally */
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      
      /* Premium Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #f8fafc; 
      }
      ::-webkit-scrollbar-thumb {
        background: #cbd5e1; 
        border-radius: 10px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8; 
      }

      /* Tighter letter spacing for a modern, clinical look */
      h1, h2, h3, h4, h5, h6 {
        letter-spacing: -0.02em; 
      }
    </style>
  </body>
</html>
