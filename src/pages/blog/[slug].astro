---
import { getCollection, getEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { siteConfig } from '../../config/site.js';
import { getServiceImage } from '../../utils/serviceImages';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, 
    props: { entry },
  }));
}

// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content } = await entry.render();

const relatedCondition = entry.data.condition
  ? await getEntry('conditions', entry.data.condition)
  : null;
const relatedService = entry.data.service
  ? await getEntry('services', entry.data.service)
  : null;

// Other articles on the same service or condition, newest first.
const moreArticles = (await getCollection('blog'))
  .filter(
    (post) =>
      post.slug !== entry.slug &&
      ((entry.data.service && post.data.service === entry.data.service) ||
        (entry.data.condition && post.data.condition === entry.data.condition))
  )
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);

const pageUrl = new URL(`/blog/${entry.slug}/`, siteConfig.url).toString();
const shareImage = getServiceImage(relatedService?.data.heroImage)?.src;
const imageAbs = new URL(shareImage || '/images/og-default.jpg', siteConfig.url).toString();
// The article is written by one of the clinic's doctors when named, otherwise by the clinic team.
const authorDoctor = siteConfig.doctors.find((d) => entry.data.author && entry.data.author.includes(d.name));
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${pageUrl}#article`,
  "headline": entry.data.title,
  "description": entry.data.description,
  "datePublished": new Date(entry.data.pubDate).toISOString(),
  "dateModified": new Date(entry.data.pubDate).toISOString(),
  "mainEntityOfPage": pageUrl,
  "url": pageUrl,
  "image": imageAbs,
  "inLanguage": "en-IN",
  "author": authorDoctor
    ? { "@type": "Person", "name": authorDoctor.name, "url": new URL(`/our-doctors/${authorDoctor.slug}/`, siteConfig.url).toString() }
    : { "@type": "Organization", "name": siteConfig.name, "url": siteConfig.url },
  "publisher": { "@type": "MedicalClinic", "name": siteConfig.name, "url": siteConfig.url,
    "logo": { "@type": "ImageObject", "url": new URL('/images/crispr-logo.png', siteConfig.url).toString() } },
  ...(entry.data.tags?.length ? { "keywords": entry.data.tags.join(', ') } : {}),
  ...(relatedCondition ? { "about": { "@type": "MedicalCondition", "name": relatedCondition.data.title, "url": new URL(`/conditions/${relatedCondition.slug}/`, siteConfig.url).toString() } } : {}),
};
---

<MainLayout title={entry.data.title} description={entry.data.description} image={shareImage} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Breadcrumbs items={[{ name: "Blog", url: "/blog" }, { name: entry.data.title, url: `/blog/${entry.slug}` }]} />
  <article class="mx-auto max-w-[46rem] px-6 py-12">
    <div class="mb-8">
      <h1 class="text-4xl font-extrabold text-brand-900 mb-4">{entry.data.title}</h1>
      <p class="text-slate-500 font-medium">
        By {entry.data.author || `The ${siteConfig.name} Team`} 
        {entry.data.pubDate && ` • ${new Date(entry.data.pubDate).toDateString()}`}
      </p>
    </div>
    
    <div class="prose prose-slate prose-brand max-w-none md:text-lg">
      <Content />
    </div>

    {(relatedCondition || relatedService) && (
      <div class="mt-12 pt-8 border-t border-champagne-200">
        <h2 class="text-lg font-bold text-brand-900 mb-4">Related Reading</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedCondition && (
            <a href={`/conditions/${relatedCondition.slug}`} class="block p-5 rounded-xl bg-champagne-50 hover:bg-champagne-100 transition-colors">
              <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Condition</p>
              <p class="font-semibold text-slate-900">{relatedCondition.data.title}</p>
            </a>
          )}
          {relatedService && (
            <a href={`/services/${relatedService.slug}`} class="block p-5 rounded-xl bg-brand-50 hover:bg-brand-100 transition-colors">
              <p class="text-xs text-brand-600 font-bold uppercase tracking-wider mb-1">Service</p>
              <p class="font-semibold text-slate-900">{relatedService.data.title}</p>
            </a>
          )}
        </div>
      </div>
    )}

    {moreArticles.length > 0 && (
      <div class="mt-10 pt-8 border-t border-champagne-200">
        <h2 class="text-lg font-bold text-brand-900 mb-4">More on This Topic</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {moreArticles.map((post) => (
            <a href={`/blog/${post.slug}`} class="block p-5 rounded-xl bg-champagne-50 hover:bg-champagne-100 transition-colors">
              <p class="text-xs text-slate-500 font-bold uppercase tracking-wider mb-1">Article</p>
              <p class="font-semibold text-slate-900">{post.data.title}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>
</MainLayout>

