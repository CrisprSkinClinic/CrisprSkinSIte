---
import { getCollection, getEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LinkCards from '../../components/ui/LinkCards.astro';
import TocChips from '../../components/ui/TocChips.astro';
import { siteConfig } from '../../config/site.js';
import { getServiceImage } from '../../utils/serviceImages';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, 
    props: { entry },
  }));
}

// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const readMinutes = Math.max(1, Math.round(entry.body.split(/\s+/).length / 210));

const relatedCondition = entry.data.condition
  ? await getEntry('conditions', entry.data.condition)
  : null;
const relatedService = entry.data.service
  ? await getEntry('services', entry.data.service)
  : null;

// Other articles on the same service or condition, newest first.
const moreArticles = (await getCollection('blog'))
  .filter(
    (post) =>
      post.slug !== entry.slug &&
      ((entry.data.service && post.data.service === entry.data.service) ||
        (entry.data.condition && post.data.condition === entry.data.condition))
  )
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4);

const pageUrl = new URL(`/blog/${entry.slug}/`, siteConfig.url).toString();
const shareImage = getServiceImage(relatedService?.data.heroImage)?.src;
const imageAbs = new URL(shareImage || '/images/og-default.jpg', siteConfig.url).toString();
// The article is written by one of the clinic's doctors when named, otherwise by the clinic team.
const authorDoctor = siteConfig.doctors.find((d) => entry.data.author && entry.data.author.includes(d.name));
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${pageUrl}#article`,
  "headline": entry.data.title,
  "description": entry.data.description,
  "datePublished": new Date(entry.data.pubDate).toISOString(),
  "dateModified": new Date(entry.data.pubDate).toISOString(),
  "mainEntityOfPage": pageUrl,
  "url": pageUrl,
  "image": imageAbs,
  "inLanguage": "en-IN",
  "author": authorDoctor
    ? { "@type": "Person", "name": authorDoctor.name, "url": new URL(`/our-doctors/${authorDoctor.slug}/`, siteConfig.url).toString() }
    : { "@type": "Organization", "name": siteConfig.name, "url": siteConfig.url },
  "publisher": { "@type": "MedicalClinic", "name": siteConfig.name, "url": siteConfig.url,
    "logo": { "@type": "ImageObject", "url": new URL('/images/crispr-logo.png', siteConfig.url).toString() } },
  ...(entry.data.tags?.length ? { "keywords": entry.data.tags.join(', ') } : {}),
  ...(relatedCondition ? { "about": { "@type": "MedicalCondition", "name": relatedCondition.data.title, "url": new URL(`/conditions/${relatedCondition.slug}/`, siteConfig.url).toString() } } : {}),
};
---

<MainLayout title={entry.data.title} description={entry.data.description} image={shareImage} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Breadcrumbs items={[{ name: "Blog", url: "/blog" }, { name: entry.data.title, url: `/blog/${entry.slug}` }]} />
  <div class="read-progress" aria-hidden="true"></div>
  <article class="mx-auto max-w-[46rem] px-6 pb-12 pt-6">
    <header class="mb-9">
      {entry.data.tags && entry.data.tags.length > 0 && (
        <span class="mb-4 inline-flex rounded-full border border-brand-100 bg-brand-50 px-3.5 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-brand-700">{entry.data.tags[0]}</span>
      )}
      <h1 data-rise style="--d:1" class="mb-5 text-4xl leading-[1.1] text-brand-900">{entry.data.title}</h1>
      <div class="flex items-center gap-3">
        {authorDoctor && (
          <img src={`/images/doctors/${authorDoctor.slug}.jpg`} alt="" width="44" height="44" class="h-11 w-11 rounded-full border-2 border-white object-cover object-top shadow" />
        )}
        <p class="text-sm leading-snug text-slate-600">
          <span class="font-semibold text-slate-900">{entry.data.author || `The ${siteConfig.name} Team`}</span><br />
          {new Date(entry.data.pubDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })} · {readMinutes} min read
        </p>
      </div>
    </header>

    <TocChips headings={headings} />

    <div class="prose prose-slate prose-brand max-w-none md:text-lg prose-h2:scroll-mt-28">
      <Content />
    </div>

    <aside class="ui-card mt-12 bg-gradient-to-br from-brand-50 to-white p-7 text-center md:p-9" aria-label="Book a consultation">
      <h2 class="mb-2 font-sans text-xl font-bold text-brand-900">Have questions about your own skin or hair?</h2>
      <p class="mx-auto mb-5 max-w-md text-slate-600">An examination gives you a clear answer. Consultation first, treatment only when indicated.</p>
      <a href="/book" data-track="booking-click" class="inline-flex min-h-[50px] items-center justify-center gap-2 rounded-2xl bg-brand-800 px-7 font-bold text-white shadow-lg shadow-brand-900/20 transition hover:bg-brand-700 active:scale-[0.98]">Book a consultation <span aria-hidden="true">→</span></a>
    </aside>

    <div class="mt-12 space-y-12">
      <LinkCards title="Related Reading" items={[
        ...(relatedCondition ? [{ href: `/conditions/${relatedCondition.slug}`, kicker: 'Condition', title: relatedCondition.data.title }] : []),
        ...(relatedService ? [{ href: `/services/${relatedService.slug}`, kicker: 'Service', title: relatedService.data.title }] : []),
      ]} />
      <LinkCards title="More on This Topic" items={moreArticles.map((post) => ({ href: `/blog/${post.slug}`, kicker: 'Article', title: post.data.title }))} />
    </div>
  </article>
</MainLayout>

