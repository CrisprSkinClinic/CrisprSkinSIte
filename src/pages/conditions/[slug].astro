---
import { getCollection, getEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ClinicGallery from '../../components/ClinicGallery.astro';
import OptionCards from '../../components/ui/OptionCards.astro';
import CheckCards from '../../components/ui/CheckCards.astro';
import LinkCards from '../../components/ui/LinkCards.astro';
import TocChips from '../../components/ui/TocChips.astro';
import SideBookCard from '../../components/ui/SideBookCard.astro';
import { siteConfig } from '../../config/site.js';
import { getServiceImage } from '../../utils/serviceImages';

export async function getStaticPaths() {
  const conditions = await getCollection('conditions');
  return conditions.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const data = entry.data;

const parentService = await getEntry('services', data.parentService);
// Link-sharing image: the parent service's photo, when it has one.
const shareImage = getServiceImage(parentService?.data.heroImage)?.src;
const relatedConditionEntries = data.relatedConditions
  ? (await Promise.all(
      data.relatedConditions.map((slug) => getEntry('conditions', slug))
    )).filter(Boolean)
  : [];

// Blog articles that declare this condition, newest first.
const relatedArticles = (await getCollection('blog'))
  .filter((post) => post.data.condition === entry.slug)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);

let faqEntries = [];
if (data.faqIds && data.faqIds.length > 0) {
  const resolved = await Promise.all(
    data.faqIds.map((id) => getEntry('faqs', id))
  );
  faqEntries = resolved
    .filter(Boolean)
    .map((f) => ({ question: f.data.question, answer: f.body }));
}

const pageUrl = new URL(`/conditions/${entry.slug}`, siteConfig.url).toString();
const conditionSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalCondition",
  "name": data.title,
  "description": data.metaDescription,
  "url": pageUrl,
  ...(data.symptoms && data.symptoms.length > 0 && {
    "signOrSymptom": data.symptoms.map((s) => ({ "@type": "MedicalSignOrSymptom", "name": s })),
  }),
  ...(data.riskFactors && data.riskFactors.length > 0 && {
    "riskFactor": data.riskFactors.map((r) => ({ "@type": "MedicalRiskFactor", "name": r })),
  }),
  ...(data.treatmentOverview && data.treatmentOverview.length > 0 && {
    "possibleTreatment": data.treatmentOverview.map((t) => ({
      "@type": "MedicalTherapy",
      "name": t.name,
      "description": t.description,
    })),
  }),
};
---

<MainLayout title={`${data.title}: Symptoms & Treatment`.length <= 48 ? `${data.title}: Symptoms & Treatment` : data.title} description={data.metaDescription} image={shareImage}>
  <script type="application/ld+json" set:html={JSON.stringify(conditionSchema)} />

  <Breadcrumbs items={[
    { name: "Services", url: "/services" },
    ...(parentService ? [{ name: parentService.data.title, url: `/services/${parentService.slug}` }] : []),
    { name: data.title, url: `/conditions/${entry.slug}` }
  ]} />

  <section class="bg-gradient-to-b from-brand-50/70 to-transparent px-5 pb-12 pt-3 md:px-6 md:pb-16">
    <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.2fr_.8fr] md:items-center md:gap-14">
      <div>
        {data.heroEyebrow && (
          <span class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-100 bg-white/80 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.16em] text-brand-700 shadow-sm"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>{data.heroEyebrow}</span>
        )}
        <h1 class="mb-5 max-w-4xl text-4xl leading-[1.05] text-slate-950 md:text-6xl">{data.heroHeadline}</h1>
        <p class="mb-8 max-w-2xl text-lg leading-relaxed text-slate-600 md:text-xl">{data.heroSubheadline}</p>
        <a href="#book" data-track="booking-click" class="inline-flex min-h-[52px] items-center justify-center gap-3 rounded-2xl bg-brand-800 px-7 font-bold text-white shadow-lg shadow-brand-900/20 transition hover:bg-brand-700 active:scale-[0.98]">
          {data.ctaTitle || `Book an Evaluation`} <span aria-hidden="true">→</span>
        </a>
      </div>
      <aside class="ui-card bg-gradient-to-br from-white to-brand-50/60 p-7 md:p-8">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.18em] text-brand-600">Clinical assessment</p>
        <p class="text-lg leading-relaxed text-slate-800">A dermatologist will confirm the diagnosis, assess severity, and discuss treatment options appropriate for your age, history, and goals.</p>
        {parentService && <a href={`/services/${parentService.slug}`} class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-700 hover:underline">Explore {parentService.data.title} <span aria-hidden="true">→</span></a>}
      </aside>
    </div>
  </section>

  {data.twoPaths && (
    <section class="px-5 md:px-6">
      <div class="mx-auto grid max-w-6xl gap-5 pb-10 md:grid-cols-2">
        <div class="ui-card bg-gradient-to-br from-brand-50 to-white p-7">
          <span class="mb-4 grid h-11 w-11 place-items-center rounded-2xl bg-brand-100 text-brand-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
          <h2 class="mb-2 font-sans text-lg font-bold text-brand-900">{data.twoPaths.screeningTitle}</h2>
          <p class="leading-relaxed text-slate-700">{data.twoPaths.screeningBody}</p>
        </div>
        <div class="ui-card border-rose-100 bg-gradient-to-br from-rose-50 to-white p-7">
          <span class="mb-4 grid h-11 w-11 place-items-center rounded-2xl bg-rose-100 text-rose-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12.5"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
          <h2 class="mb-2 font-sans text-lg font-bold text-rose-900">{data.twoPaths.symptomsTitle}</h2>
          <p class="leading-relaxed text-rose-900/80">{data.twoPaths.symptomsBody}</p>
        </div>
      </div>
    </section>
  )}

  <div class="mx-auto max-w-6xl px-5 py-6 md:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-12">
    <div class="min-w-0 space-y-14 pb-10">
      <section>
        <TocChips headings={headings} />
        <div class="prose prose-slate max-w-none md:prose-lg prose-headings:text-brand-900 prose-h2:scroll-mt-28 prose-a:text-brand-700 prose-p:leading-7 md:prose-p:leading-8">
          <h2>What Is It?</h2>
          <Content />
        </div>
      </section>

      <CheckCards title="Risk Factors" items={data.riskFactors || []} />

      <CheckCards title="Symptoms" items={data.symptoms || []} />

      <OptionCards title="Treatment" items={data.treatmentOverview || []}>
        {parentService && (
          <p slot="footer" class="mt-6 text-sm">
            <a href={`/services/${parentService.slug}`} class="font-semibold text-brand-700 hover:underline">Learn more about {parentService.data.title} &rarr;</a>
          </p>
        )}
      </OptionCards>

      {data.urgentScenarios && data.urgentScenarios.length > 0 && (
        <section class="ui-card border-rose-100 bg-gradient-to-br from-rose-50 to-white p-7">
          <h3 class="mb-3 font-sans text-xl font-bold text-rose-900">{data.urgentCareTitle}</h3>
          {data.urgentCareBody && <p class="mb-4 leading-relaxed text-rose-900/80">{data.urgentCareBody}</p>}
          <ul class="space-y-2.5">
            {data.urgentScenarios.map((item) => (
              <li class="flex items-start gap-3 text-rose-900/90"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-rose-500"></span><span>{item}</span></li>
            ))}
          </ul>
        </section>
      )}

      <LinkCards title="Related Articles" items={relatedArticles.map((post) => ({ href: `/blog/${post.slug}`, kicker: 'Article', title: post.data.title }))} />

      <LinkCards title="Related Conditions" items={relatedConditionEntries.map((c) => ({ href: `/conditions/${c.slug}`, kicker: 'Related condition', title: c.data.title }))} />

      {siteConfig.doctors.length > 0 && (
        <section>
          <h2 class="mb-6 text-2xl text-brand-900 md:text-3xl">Our Specialists</h2>
          <div id="conditionDoctorsGrid" class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            {siteConfig.doctors.map((doc) => (
              <a href={`/our-doctors/${doc.slug}`} class="ui-card group flex flex-col items-center gap-3 p-5 text-center">
                <img
                  src={`/images/doctors/${doc.slug}.jpg`}
                  alt={`${doc.name}, ${doc.designation}`}
                  width="72"
                  height="72"
                  loading="lazy"
                  decoding="async"
                  class="h-[72px] w-[72px] shrink-0 rounded-full border-2 border-white object-cover object-top shadow"
                  onerror={`this.src='https://placehold.co/72x72/223154/FAF8F5?text=${encodeURIComponent(doc.name.split(' ').pop())}'`}
                />
                <div class="min-w-0">
                  <p class="font-semibold text-slate-900 transition-colors group-hover:text-brand-700">{doc.name}</p>
                  <p class="mt-1 text-xs font-medium leading-snug text-brand-600">{doc.designation}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="hidden lg:block" aria-label="Book a consultation">
      <div class="sticky top-28"><SideBookCard /></div>
    </aside>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const grid = document.getElementById('conditionDoctorsGrid');
      if (!grid) return;
      const cards = Array.from(grid.children);
      for (let i = cards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }
      cards.forEach((card) => grid.appendChild(card));
    });
  </script>

  <ClinicGallery />

  <FAQAccordion entries={faqEntries} />

  <CTA
    title={data.ctaTitle || `Book an Evaluation for ${data.title}`}
    address={`${siteConfig.contact.address.street}, ${siteConfig.contact.address.locality} - ${siteConfig.contact.address.postalCode}`}
    phone={siteConfig.contact.phone}
  />
</MainLayout>
