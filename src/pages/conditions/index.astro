---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, getEntry } from 'astro:content';
import ListingFilter from '../../components/ListingFilter.astro';
import { siteConfig } from '../../config/site.js';

const pageTitle = "All Conditions";
const pageDescription = `Complete list of skin, hair, and paediatric dermatology conditions treated at ${siteConfig.name}, KK Nagar, Chennai.`;

const allConditions = await getCollection('conditions');
const allServices = await getCollection('services');
const serviceTitleBySlug = Object.fromEntries(allServices.map((s) => [s.slug, s.data.title]));
const serviceCategoryBySlug = Object.fromEntries(allServices.map((s) => [s.slug, s.data.category]));

const categoryLabels = {
  hair: 'Hair',
  skin: 'Skin',
  cosmetic: 'Cosmetic',
  pediatric: 'Pediatric',
};

const categoryOrder = ['hair', 'skin', 'cosmetic', 'pediatric'];

// Conditions don't carry their own category -- each one links to a
// parentService, and that service's category is what places the
// condition in the right group here (mirrors services/index.astro's
// grouping, one level removed).
const filterCategories = categoryOrder.map((value) => ({ value, label: categoryLabels[value] }));

const conditionsByCategory = categoryOrder.map((cat) => ({
  category: cat,
  label: categoryLabels[cat],
  conditions: allConditions
    .filter((c) => serviceCategoryBySlug[c.data.parentService] === cat)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
}));
---

<MainLayout title={pageTitle} description={pageDescription}>
  <Breadcrumbs items={[{ name: "Conditions", url: "/conditions" }]} />

  <div class="bg-gradient-to-b from-brand-50/70 to-transparent py-12 md:py-16 px-6 text-center">
    <p data-rise style="--d:0" class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-600 mb-4">Patient guide</p>
    <h1 data-rise style="--d:1" class="text-4xl md:text-6xl text-slate-950 mb-4">Conditions We Treat</h1>
    <p data-rise style="--d:2" class="text-lg text-slate-600 max-w-2xl mx-auto">Learn about the skin, hair, and paediatric dermatology conditions we diagnose and treat at {siteConfig.name}.</p>
  </div>

  <ListingFilter noun="conditions" placeholder="Search" categories={filterCategories} />

  <div class="max-w-6xl mx-auto py-10 px-6">
    {conditionsByCategory.map(({ category, label, conditions }) => (
      conditions.length > 0 && (
        <section class="mb-16 last:mb-0" data-filter-section>
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-2xl md:text-3xl font-bold text-brand-900">{label}</h2>
            <a href={`/${category}`} class="text-sm text-brand-600 font-semibold hover:underline">View {label} services &rarr;</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {conditions.map((condition) => (
              <a
                href={`/conditions/${condition.slug}`}
                data-filter-item
                data-cat={category}
                data-search={`${condition.data.title} ${condition.data.heroSubheadline || ''} ${serviceTitleBySlug[condition.data.parentService] || ''} ${label}`.toLowerCase()}
                class="ui-card p-5 group flex items-center justify-between"
              >
                <span class="font-semibold text-slate-800 group-hover:text-brand-700 transition-colors">{condition.data.title}</span>
                <span aria-hidden="true" class="text-brand-500 group-hover:translate-x-0.5 transition-transform">&rarr;</span>
              </a>
            ))}
          </div>
        </section>
      )
    ))}
  </div>
</MainLayout>
