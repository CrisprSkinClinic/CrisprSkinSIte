---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import ListingFilter from '../components/ListingFilter.astro';
import { siteConfig } from '../config/site.js';

const pageTitle = "Frequently Asked Questions";
const pageDescription = `Answers to common questions about hair transplant, acne, pigmentation, vitiligo, psoriasis, and cosmetic dermatology at ${siteConfig.name}, Chennai.`;

const allFaqs = await getCollection('faqs');
const allServices = await getCollection('services');
const allConditions = await getCollection('conditions');
const serviceCategoryBySlug = Object.fromEntries(allServices.map((x) => [x.slug, x.data.category]));
// A question belongs to the category of the service or condition page that uses it; the rest are General.
const faqCategory = {};
allServices.forEach((x) => (x.data.faqIds || []).forEach((id) => { faqCategory[id] ??= x.data.category; }));
allConditions.forEach((x) => (x.data.faqIds || []).forEach((id) => { faqCategory[id] ??= serviceCategoryBySlug[x.data.parentService]; }));
const categoryLabels = { hair: 'Hair', skin: 'Skin', cosmetic: 'Cosmetic', pediatric: 'Pediatric', general: 'General' };
const filterCategories = ['hair', 'skin', 'cosmetic', 'pediatric', 'general'].map((value) => ({ value, label: categoryLabels[value] }));
const catOf = (faq) => faqCategory[faq.slug] || 'general';
const sortedFaqs = allFaqs.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sortedFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.data.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.body,
    },
  })),
};
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="bg-gradient-to-b from-brand-50/70 to-transparent py-12 md:py-16 px-6 text-center">
    <div class="max-w-3xl mx-auto">
      <p data-rise style="--d:0" class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-600 mb-4">Patient information</p>
      <h1 data-rise style="--d:1" class="text-4xl md:text-6xl text-slate-950 mb-4">Frequently Asked Questions</h1>
      <p data-rise style="--d:2" class="text-xl text-slate-600">Answers to common questions about skin, hair, and cosmetic care.</p>
    </div>
  </section>

  <ListingFilter noun="questions" placeholder="Search" categories={filterCategories} />

  <section class="py-10 px-6 max-w-3xl mx-auto">
    <div class="space-y-3">
      {sortedFaqs.map((faq) => (
        <details data-filter-item data-open-on-match data-cat={catOf(faq)} data-search={`${faq.data.question} ${faq.body} ${(faq.data.tags || []).join(' ')} ${categoryLabels[catOf(faq)]}`.toLowerCase()} class="group ui-card overflow-hidden open:border-brand-300 open:shadow-lg">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-sans text-base font-bold text-slate-900 transition-colors hover:text-brand-700 md:p-6 md:text-lg [&::-webkit-details-marker]:hidden">
            {faq.data.question}
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-700 transition duration-300 group-open:rotate-45 group-open:bg-brand-600 group-open:text-white" aria-hidden="true">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </summary>
          <div class="px-5 pb-6 leading-relaxed text-slate-600 md:px-6">
            {faq.body}
          </div>
        </details>
      ))}
    </div>
  </section>
</MainLayout>
