---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import ListingFilter from '../components/ListingFilter.astro';
import { siteConfig } from '../config/site.js';

const pageTitle = "Frequently Asked Questions";
const pageDescription = `Answers to common questions about hair transplant, acne, pigmentation, vitiligo, psoriasis, and cosmetic dermatology at ${siteConfig.name}, Chennai.`;

const allFaqs = await getCollection('faqs');
const allServices = await getCollection('services');
const allConditions = await getCollection('conditions');
const serviceCategoryBySlug = Object.fromEntries(allServices.map((x) => [x.slug, x.data.category]));
// A question belongs to the category of the service or condition page that uses it; the rest are General.
const faqCategory = {};
allServices.forEach((x) => (x.data.faqIds || []).forEach((id) => { faqCategory[id] ??= x.data.category; }));
allConditions.forEach((x) => (x.data.faqIds || []).forEach((id) => { faqCategory[id] ??= serviceCategoryBySlug[x.data.parentService]; }));
const categoryLabels = { hair: 'Hair', skin: 'Skin', cosmetic: 'Cosmetic', pediatric: 'Pediatric', general: 'General' };
const filterCategories = ['hair', 'skin', 'cosmetic', 'pediatric', 'general'].map((value) => ({ value, label: categoryLabels[value] }));
const catOf = (faq) => faqCategory[faq.slug] || 'general';
const sortedFaqs = allFaqs.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": sortedFaqs.map((faq) => ({
    "@type": "Question",
    "name": faq.data.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.body,
    },
  })),
};
---

<MainLayout title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="bg-[#fdfcfc] py-14 md:py-20 px-6 text-center border-b border-slate-200/70">
    <div class="max-w-3xl mx-auto">
      <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-600 mb-4">Patient information</p>
      <h1 class="text-4xl md:text-6xl text-slate-950 mb-4">Frequently Asked Questions</h1>
      <p class="text-xl text-slate-600">Answers to common questions about skin, hair, and cosmetic care.</p>
    </div>
  </section>

  <ListingFilter noun="questions" placeholder="Search" categories={filterCategories} />

  <section class="py-10 px-6 max-w-3xl mx-auto">
    <div class="space-y-4">
      {sortedFaqs.map((faq) => (
        <details data-filter-item data-open-on-match data-cat={catOf(faq)} data-search={`${faq.data.question} ${faq.body} ${(faq.data.tags || []).join(' ')} ${categoryLabels[catOf(faq)]}`.toLowerCase()} class="group bg-champagne-50 rounded-lg border border-slate-200 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-bold text-lg text-slate-900 group-hover:text-brand-600 transition">
            {faq.data.question}
            <span class="transition group-open:rotate-180 shrink-0 ml-4">
              <svg fill="none" height="24" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <div class="p-6 pt-0 text-slate-600 leading-relaxed border-t border-slate-100 mt-2">
            {faq.body}
          </div>
        </details>
      ))}
    </div>
  </section>
</MainLayout>
