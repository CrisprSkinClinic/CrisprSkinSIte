---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StatsBar from '../components/StatsBar.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { getCollection, getEntry } from 'astro:content';
import ConcernGrid from '../components/home/ConcernGrid.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import WhyCrispr from '../components/home/WhyCrispr.astro';
import ArticleCard from '../components/home/ArticleCard.astro';
import VisitSection from '../components/home/VisitSection.astro';
import BookingSection from '../components/LandingPageSections/BookingSection.astro';
import { siteConfig } from '../config/site.js';
import { getServiceImage, getServiceImageAlt } from '../utils/serviceImages';

const featuredServices = [
  { slug: 'hair-transplant-fue', alt: 'Hair transplant procedure', title: 'Hair Transplant (FUE)', description: 'Advanced Follicular Unit Extraction for natural, permanent hair restoration performed by a dedicated hair transplant surgeon.', link: '/services/hair-transplant-fue' },
  { slug: 'acne', alt: 'Acne treatment consultation', title: 'Acne & Acne Scars', description: 'Evidence-based treatment for active acne and the scarring it leaves behind, tailored to your skin type.', link: '/services/acne' },
  { slug: 'pigmentation', alt: 'Skin pigmentation treatment', title: 'Pigmentation & Melasma', description: 'Targeted treatment for stubborn pigmentation and melasma using dermatologist-guided regimens.', link: '/services/pigmentation' },
  { slug: 'vitiligo', alt: 'Vitiligo treatment', title: 'Vitiligo', description: 'Comprehensive evaluation and long-term management of vitiligo with realistic, honest expectations.', link: '/services/vitiligo' },
  { slug: 'botox', alt: 'Cosmetic dermatology treatment', title: 'Botox & Fillers', description: 'Subtle, natural-looking anti-ageing and rejuvenation treatments administered by trained dermatologists.', link: '/services/botox' },
  { slug: 'pediatric-dermatology', alt: 'Pediatric dermatology consultation', title: 'Pediatric Dermatology', description: "A child-friendly approach to eczema, birthmarks, and other skin conditions in infants and children.", link: '/services/pediatric-dermatology' },
];

const featuredConditionSlugs = [
  'androgenetic-alopecia',
  'melasma',
  'vitiligo',
  'plaque-psoriasis',
  'hormonal-acne',
  'childhood-atopic-dermatitis',
];
const featuredConditions = (
  await Promise.all(featuredConditionSlugs.map((slug) => getEntry('conditions', slug)))
).filter(Boolean);

const pageTitle = "Best Skin & Hair Clinic in KK Nagar, Chennai";
const pageDescription = siteConfig.description;

const allPosts = await getCollection('blog') || [];
const allServices = await getCollection('services');
const heroBySlug = Object.fromEntries(allServices.map((x) => [x.slug, x.data.heroImage]));
const imageOf = (post) => getServiceImage(heroBySlug[post.data.service]);
const minutesOf = (post) => Math.max(1, Math.round(post.body.split(/\s+/).length / 210));
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);
---

<MainLayout title={pageTitle} description={pageDescription}>
  <Hero 
    title="Skin, Hair & Aesthetic Dermatology Specialists" 
    subtitle="AIIMS-trained dermatologists in KK Nagar, Chennai offering hair transplantation, medical dermatology, and cosmetic treatments. Evidence-based care, no unnecessary procedures."
    eyebrow={siteConfig.name}
    credentials="AIIMS-trained dermatology team"
    ctaText="Book Consultation"
    whatsappText="Chat on WhatsApp"
  />

  <StatsBar />

  <ConcernGrid />

  <HowItWorks />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-6 md:py-24" id="services">
    <div class="mb-12 grid gap-6 md:grid-cols-[.8fr_1.2fr] md:items-end">
      <div>
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">Explore our expertise</p>
        <h2 class="text-4xl leading-tight text-brand-900 md:text-5xl">Care designed around you.</h2>
      </div>
      <p class="max-w-2xl text-lg text-slate-600 md:justify-self-end">From hair restoration to clinical and cosmetic dermatology, evidence-based care for every member of your family, right here in KK Nagar.</p>
    </div>

    <div class="-mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-3 [&::-webkit-scrollbar]:hidden">
      {featuredServices.map((service, i) => (
        <div class="w-[78vw] max-w-[340px] shrink-0 snap-start md:w-auto md:max-w-none [&>a]:h-full">
          <ServiceCard
            image={getServiceImage(service.slug)}
            alt={getServiceImageAlt(service.slug, service.alt)}
            title={service.title}
            description={service.description}
            link={service.link}
            priority={i < 3}
          />
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/services" class="inline-flex items-center gap-2 font-bold text-brand-700 hover:underline">View all services <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <WhyCrispr />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-6 md:py-24" id="conditions">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">Patient guide</p>
      <h2 class="mb-4 text-4xl text-brand-900 md:text-5xl">Conditions we treat</h2>
      <p class="text-lg text-slate-600">A closer look at the hair, skin and paediatric conditions our doctors diagnose and manage every day.</p>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
      {featuredConditions.map((condition) => (
        <a href={`/conditions/${condition.slug}`} class="ui-card group flex h-full flex-col p-4 sm:p-6">
          <h3 class="mb-2 font-sans text-[15px] font-bold leading-snug text-slate-900 transition-colors group-hover:text-brand-700 sm:text-lg">{condition.data.title}</h3>
          <p class="mb-5 hidden flex-grow text-sm leading-relaxed text-slate-600 sm:block">{condition.data.heroSubheadline}</p>
          <span class="mt-auto flex items-center gap-1.5 text-sm font-bold text-brand-700">Learn more <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>

    <div class="mt-8 text-center">
      <a href="/conditions" class="inline-flex items-center gap-2 font-bold text-brand-700 hover:underline">View all conditions <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 text-center md:px-6 md:py-20">
    <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">Your dermatologists</p>
    <h2 class="mb-4 text-4xl text-brand-900 md:text-5xl">Meet our doctors</h2>
    <p class="mx-auto mb-12 max-w-3xl text-lg leading-relaxed text-slate-600">
      Three AIIMS-trained consultant dermatologists with expertise spanning hair transplantation, clinical and cosmetic dermatology, and paediatric skin care. Ethical, evidence-based treatment, with your long-term skin and hair health first.
    </p>

    <div id="doctorGridHome" data-shuffle class="-mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-4 [scrollbar-width:none] md:mx-0 md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0 md:pb-0 [&::-webkit-scrollbar]:hidden">
      {siteConfig.doctors.map((doctor) => (
        <a href={`/our-doctors/${doctor.slug}`} class="ui-card group flex w-[72vw] max-w-[300px] shrink-0 snap-start flex-col overflow-hidden text-left md:w-auto md:max-w-none">
          <div class="aspect-[3/4] overflow-hidden bg-brand-50">
            <img
              src={`/images/doctors/${doctor.slug}.jpg`}
              alt={`${doctor.name}, ${doctor.designation}`}
              width="400"
              height="533"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
              onerror={`this.onerror=null;this.src='https://placehold.co/400x533/EEF0F6/223154?text=${encodeURIComponent(doctor.name)}'`}
            />
          </div>
          <div class="flex flex-grow flex-col p-6">
            <h3 class="mb-1 font-sans text-xl font-bold text-brand-900">{doctor.name}</h3>
            <p class="mb-1 text-sm font-semibold text-brand-600">{doctor.designation}</p>
            <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-slate-500">{doctor.qualificationsShort}</p>
            <span class="mt-auto flex items-center gap-1.5 text-sm font-bold text-brand-700">View profile <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>

    <a href="/our-doctors" class="mt-10 inline-block rounded-2xl bg-brand-100 px-7 py-3.5 font-bold text-brand-800 transition hover:bg-brand-200">View all doctors</a>
  </section>

  <Testimonials />

  {latestPosts.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 py-16 md:px-6 md:py-24">
      <div class="mb-10 flex flex-col items-center justify-between gap-4 text-center md:flex-row md:items-end md:text-left">
        <div>
          <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">From our doctors</p>
          <h2 class="text-4xl text-brand-900 md:text-5xl">Skin &amp; hair health</h2>
        </div>
        <a href="/blog" class="hidden items-center gap-2 font-bold text-brand-700 hover:underline md:inline-flex">View all articles <span aria-hidden="true">→</span></a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {latestPosts.map((post) => <ArticleCard post={post} image={imageOf(post)} minutes={minutesOf(post)} />)}
      </div>

      <div class="mt-8 text-center md:hidden">
        <a href="/blog" class="inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-8 py-3.5 font-bold text-brand-700 shadow-sm">View all articles</a>
      </div>
    </section>
  )}

  <FAQ limit={5} />

  <VisitSection />

  <BookingSection defaultService="General Consultation" />
</MainLayout>
