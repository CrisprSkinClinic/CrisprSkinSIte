---
// src/pages/partner-register.astro
//
// Public registration for pharma medical representatives who want to supply the clinic's pharmacy.
//   1. verify the WhatsApp number (send-booking-otp / verify-booking-otp)
//   2. upload the brochure and rate list; the extract-partner-registration edge function reads them with AI
//   3. the rep reviews and corrects everything (details, offer terms, stockists, price list) before submitting
// The form posts to public-partner-registration.js, which files it in partner_registrations. Nothing becomes a Partner
// in the clinic app until staff approve it.
import MainLayout from '../layouts/MainLayout.astro';
import { siteConfig } from '../config/site.js';

const field = "w-full bg-white px-4 py-3.5 text-base text-[#17233d] placeholder:text-[#a9a3b3] border border-[#d9d3df] rounded-xl focus:border-[#9b4fa2] focus:ring-4 focus:ring-[#9b4fa2]/15 outline-none transition";
const label = "text-sm font-semibold text-[#17233d] mb-1.5 block";
const card = "rounded-2xl bg-white border border-[#e5e2e8] shadow-sm p-5 md:p-7 space-y-5";
const btn = "shrink-0 px-5 rounded-xl font-semibold text-base bg-[#9b4fa2] text-white hover:bg-[#84358c] transition disabled:opacity-50";
---

<MainLayout title={`Medical Rep Registration | ${siteConfig.name}`} description="Register as a medical representative for CRISPR Skin and Hair Clinic's pharmacy." bare>
  <div class="max-w-xl mx-auto pt-6 pb-10 md:pt-10 md:pb-16 px-4">
    <img src="/images/crispr-logo.png" alt="CRISPR Skin and Hair Clinic" width="3240" height="1493" class="h-auto w-[150px] mx-auto mb-4" />
    <h1 class="text-2xl md:text-3xl font-extrabold text-[#17233d] mb-2 text-center">Medical Rep Registration</h1>
    <p class="text-center text-[#46536b] mb-6">Upload your brochure and rate list. We read them for you and you check everything before submitting.</p>

    <div id="pr-form-container" class="space-y-5">
      <input type="text" id="pr-website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

      <!-- 1. verify -->
      <div class={card}>
        <h2 class="text-lg font-bold text-[#17233d]">1. Verify your WhatsApp number</h2>
        <div>
          <label for="pr-phone" class={label}>WhatsApp Number *</label>
          <div class="flex gap-2">
            <div class="relative flex-1 min-w-0">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#46536b] font-semibold">+91</span>
              <input type="tel" id="pr-phone" placeholder="10-digit mobile" autocomplete="tel-national" inputmode="numeric" maxlength="10" class={`${field} pl-14 tracking-wide`} />
            </div>
            <button type="button" id="pr-send-code" class={btn}>Verify</button>
          </div>
          <div id="pr-code-group" class="hidden mt-3">
            <label for="pr-code" class={label}>Enter the 6-digit code sent on WhatsApp</label>
            <div class="flex gap-2">
              <input type="text" id="pr-code" placeholder="6-digit code" autocomplete="one-time-code" inputmode="numeric" maxlength="6" class={`${field} flex-1 min-w-0 tracking-widest`} />
              <button type="button" id="pr-verify-code" class={btn}>Confirm</button>
            </div>
            <button type="button" id="pr-resend" class="text-sm text-[#84358c] font-semibold mt-2 hover:underline">Resend code</button>
          </div>
          <p id="pr-phone-status" class="text-[#7b8495] text-xs mt-1 min-h-[1rem]"></p>
        </div>
      </div>

      <!-- 2. upload -->
      <div id="pr-upload" class={`${card} hidden`}>
        <h2 class="text-lg font-bold text-[#17233d]">2. Upload your documents</h2>
        <p class="text-sm text-[#46536b]">Brochure and rate list, as PDF, photo, Excel or CSV (up to 5 files, 15 MB in all).</p>
        <label for="pr-files" class="block cursor-pointer rounded-xl border-2 border-dashed border-[#d9d3df] bg-[#fbf8fc] px-4 py-6 text-center text-[#84358c] font-semibold hover:border-[#9b4fa2]">Choose files</label>
        <input type="file" id="pr-files" multiple accept=".pdf,.jpg,.jpeg,.png,.webp,.csv,.xlsx,.xls,application/pdf,image/*" class="hidden" />
        <ul id="pr-file-list" class="text-sm text-[#17233d] space-y-1"></ul>
        <button type="button" id="pr-read" class={`${btn} w-full py-3.5 hidden`}>Read my documents</button>
        <p id="pr-read-status" class="text-xs min-h-[1rem] text-[#7b8495]" role="status"></p>
        <button type="button" id="pr-skip" class="text-sm text-[#84358c] font-semibold hover:underline">I'll type my details in instead</button>
      </div>

      <!-- 3. review -->
      <form id="pr-form" class="space-y-5 hidden" novalidate>
        <div class={card}>
          <h2 class="text-lg font-bold text-[#17233d]">Check your details</h2>
          <div class="grid grid-cols-3 gap-3">
            <div><label for="pr-salutation" class={label}>Title</label>
              <select id="pr-salutation" class={field}><option value="">—</option><option>Mr.</option><option>Ms.</option><option>Mrs.</option><option>Dr.</option></select></div>
            <div class="col-span-2"><label for="pr-first" class={label}>First name *</label><input id="pr-first" class={field} autocomplete="given-name" /></div>
          </div>
          <div><label for="pr-last" class={label}>Last name</label><input id="pr-last" class={field} autocomplete="family-name" /></div>
          <div><label for="pr-company" class={label}>Company *</label><input id="pr-company" class={field} placeholder="e.g. Glenmark" autocomplete="organization" /></div>
          <div class="grid grid-cols-2 gap-3">
            <div><label for="pr-division" class={label}>Division</label><input id="pr-division" class={field} placeholder="e.g. Skinnora" /></div>
            <div><label for="pr-designation" class={label}>Designation</label><input id="pr-designation" class={field} autocomplete="organization-title" /></div>
          </div>
          <div><label for="pr-email" class={label}>Email</label><input id="pr-email" type="email" class={field} autocomplete="email" /></div>
        </div>

        <div class={card}>
          <h2 class="text-lg font-bold text-[#17233d]">Offer and terms</h2>
          <div><label for="pr-offer" class={label}>Offer type</label>
            <select id="pr-offer" class={field}><option value="">Not sure</option><option value="Scheme">Scheme (buy and get free)</option><option value="Discount">Discount / margin</option><option value="No_Offer">No offer</option></select></div>
          <div id="pr-scheme" class="grid grid-cols-2 gap-3 hidden">
            <div><label for="pr-buy" class={label}>Buy (qty)</label><input id="pr-buy" inputmode="decimal" class={field} /></div>
            <div><label for="pr-free" class={label}>Get free (qty)</label><input id="pr-free" inputmode="decimal" class={field} /></div>
          </div>
          <div id="pr-margin" class="hidden"><label for="pr-marginpct" class={label}>Margin / discount (%)</label><input id="pr-marginpct" inputmode="decimal" class={field} /></div>
          <div class="grid grid-cols-2 gap-3">
            <div><label for="pr-moq" class={label}>Minimum order qty</label><input id="pr-moq" inputmode="numeric" class={field} /></div>
            <div><label for="pr-cash" class={label}>Cash discount (%)</label><input id="pr-cash" inputmode="decimal" class={field} /></div>
            <div><label for="pr-delivery" class={label}>Delivery (days)</label><input id="pr-delivery" inputmode="numeric" class={field} /></div>
            <div><label for="pr-terms" class={label}>Payment terms</label><input id="pr-terms" class={field} placeholder="e.g. 7 Days" /></div>
          </div>
          <div><label for="pr-medvol" class={label}>Do you take orders through the Medvol app?</label>
            <select id="pr-medvol" class={field}><option value="">—</option><option>Yes</option><option>No</option></select></div>
          <div><label for="pr-pref" class={label}>Preferred stockist</label><input id="pr-pref" class={field} placeholder="Distributor we should order through" /></div>
          <div class="grid grid-cols-2 gap-3">
            <div><label for="pr-sec1" class={label}>Second stockist</label><input id="pr-sec1" class={field} /></div>
            <div><label for="pr-sec2" class={label}>Third stockist</label><input id="pr-sec2" class={field} /></div>
          </div>
        </div>

        <div class={card}>
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-[#17233d]">Price list <span id="pr-price-count" class="text-sm font-semibold text-[#7b8495]"></span></h2>
            <button type="button" id="pr-add-row" class="text-sm text-[#84358c] font-semibold hover:underline">+ Add product</button>
          </div>
          <p class="text-xs text-[#7b8495]">PTR is your price to us; MRP is the printed retail price. Open a product to correct it, or remove it.</p>
          <div id="pr-rows" class="space-y-2"></div>
        </div>

        <p id="pr-error" class="text-red-600 text-sm min-h-[1rem]" role="alert"></p>
        <button type="submit" id="pr-submit" class={`${btn} w-full py-4`}>Submit registration</button>
        <p class="text-xs text-center text-[#7b8495]">Our pharmacy team reviews every registration before adding you.</p>
      </form>
    </div>

    <div id="pr-success" class="hidden text-center rounded-2xl bg-white border border-[#e5e2e8] shadow-sm p-8">
      <h2 class="text-xl font-extrabold text-[#17233d] mb-2">Thank you</h2>
      <p class="text-[#46536b]">Your registration has been sent to our pharmacy team. We will contact you on WhatsApp once it is reviewed.</p>
    </div>
  </div>
</MainLayout>

<script is:inline>
  const $ = (id) => document.getElementById(id);
  const EXTRACT_URL = 'https://kdcuoezsopvcsulahlad.supabase.co/functions/v1/extract-partner-registration';
  const CATEGORIES = ['Acne & Rosacea Therapeutics','Emollients, Moisturizers & Barrier Repair','Sunscreens & Photoprotection','Cleansers, Face Washes & Medicated Shampoos','Topical Antibiotics & Antibacterials','Systemic Antibiotics','Topical Antifungals','Systemic Antifungals','Anti-Dandruff & Scalp Therapeutics','Antihistamines & Anti-Allergics','Topical Corticosteroids','Combination Therapeutics','Pigmentation & Depigmenting Agents','Hair Growth & Hair Care','Antivirals','Psoriasis, Eczema & Immunomodulators','Nutraceuticals, Vitamins & Supplements','Wound Care & Antiseptics','Other'];
  const MAX_FILES = 5, MAX_BYTES = 15 * 1024 * 1024;
  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const val = (id) => $(id).value.trim();
  const inputCls = "w-full bg-white px-3 py-2.5 text-sm text-[#17233d] border border-[#d9d3df] rounded-lg focus:border-[#9b4fa2] focus:ring-2 focus:ring-[#9b4fa2]/15 outline-none";

  let verifiedPhone = '', otpToken = '', chosen = [], folderUrl = '', rows = [];

  // ---- phone verification (same flow as the patient registration page) ----
  function setPhoneStatus(text, tone) {
    const el = $('pr-phone-status');
    el.textContent = text;
    el.className = `text-xs mt-1 min-h-[1rem] ${tone === 'ok' ? 'text-green-700 font-semibold' : tone === 'error' ? 'text-red-600' : 'text-[#7b8495]'}`;
  }
  function resetVerification() {
    verifiedPhone = ''; otpToken = '';
    $('pr-phone').readOnly = false;
    $('pr-send-code').textContent = 'Verify';
    $('pr-code-group').classList.add('hidden');
    $('pr-code').value = '';
  }
  $('pr-phone').addEventListener('input', (e) => { e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 10); setPhoneStatus(''); });
  async function postJson(url, body) {
    const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || (result.success === false) || result.error) { const err = new Error(result.error || 'Something went wrong. Please try again.'); err.expired = !!result.verificationExpired; throw err; }
    return result;
  }
  async function sendCode() {
    const phone = $('pr-phone').value.trim();
    if (!/^[6-9][0-9]{9}$/.test(phone)) { setPhoneStatus('Enter a valid 10-digit mobile number.', 'error'); return; }
    $('pr-send-code').disabled = true; $('pr-resend').disabled = true;
    setPhoneStatus('Sending code on WhatsApp...');
    try {
      await postJson('/.netlify/functions/send-booking-otp', { phone });
      $('pr-code-group').classList.remove('hidden');
      $('pr-code').focus();
      setPhoneStatus(`Code sent to +91 ${phone} on WhatsApp.`);
    } catch (err) { setPhoneStatus(err.message, 'error'); }
    finally { $('pr-send-code').disabled = false; $('pr-resend').disabled = false; }
  }
  $('pr-send-code').addEventListener('click', () => {
    if (verifiedPhone) { resetVerification(); setPhoneStatus(''); $('pr-upload').classList.add('hidden'); $('pr-form').classList.add('hidden'); $('pr-phone').focus(); return; }
    sendCode();
  });
  $('pr-resend').addEventListener('click', sendCode);
  $('pr-code').addEventListener('input', (e) => {
    e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 6);
    if (e.target.value.length === 6) $('pr-verify-code').click();
  });
  $('pr-verify-code').addEventListener('click', async () => {
    const phone = $('pr-phone').value.trim();
    const code = $('pr-code').value.trim();
    if (code.length !== 6) { setPhoneStatus('Enter the 6-digit code.', 'error'); return; }
    $('pr-verify-code').disabled = true;
    try {
      const result = await postJson('/.netlify/functions/verify-booking-otp', { phone, code });
      verifiedPhone = phone; otpToken = result.token;
      $('pr-phone').readOnly = true;
      $('pr-code-group').classList.add('hidden');
      $('pr-send-code').textContent = 'Change';
      setPhoneStatus('✓ Number verified', 'ok');
      $('pr-upload').classList.remove('hidden');
      $('pr-upload').scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) { setPhoneStatus(err.message, 'error'); }
    finally { $('pr-verify-code').disabled = false; }
  });

  // ---- choosing and reading the documents ----
  function renderFiles() {
    $('pr-file-list').innerHTML = chosen.map((f, i) => `<li class="flex items-center justify-between gap-2 rounded-lg bg-[#f6edf8] px-3 py-2"><span class="truncate">${esc(f.name)}</span><button type="button" data-rm="${i}" class="text-[#84358c] font-semibold">Remove</button></li>`).join('');
    $('pr-read').classList.toggle('hidden', !chosen.length);
  }
  $('pr-file-list').addEventListener('click', (e) => { const i = e.target.dataset && e.target.dataset.rm; if (i !== undefined) { chosen.splice(+i, 1); renderFiles(); } });
  $('pr-files').addEventListener('change', (e) => {
    for (const f of e.target.files) chosen.push(f);
    e.target.value = '';
    if (chosen.length > MAX_FILES) { chosen = chosen.slice(0, MAX_FILES); $('pr-read-status').textContent = `Only the first ${MAX_FILES} files are used.`; }
    renderFiles();
  });

  const toBase64 = (buf) => { let s = ''; const b = new Uint8Array(buf); for (let i = 0; i < b.length; i += 0x8000) s += String.fromCharCode.apply(null, b.subarray(i, i + 0x8000)); return btoa(s); };
  function loadScript(src) { return new Promise((res, rej) => { const s = document.createElement('script'); s.src = src; s.onload = res; s.onerror = () => rej(new Error('Could not load the spreadsheet reader.')); document.head.appendChild(s); }); }
  async function prepare(f) {
    const name = f.name || 'document';
    const ext = name.split('.').pop().toLowerCase();
    if (ext === 'xlsx' || ext === 'xls') {
      if (!window.XLSX) await loadScript('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js');
      const wb = window.XLSX.read(await f.arrayBuffer(), { type: 'array' });
      const csv = wb.SheetNames.map((n) => `# Sheet: ${n}\n${window.XLSX.utils.sheet_to_csv(wb.Sheets[n])}`).join('\n\n');
      return { name: name.replace(/\.[^.]+$/, '') + '.csv', mime_type: 'text/csv', base64_data: btoa(unescape(encodeURIComponent(csv))) };
    }
    const mime = f.type || ({ pdf: 'application/pdf', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', csv: 'text/csv' }[ext] || '');
    return { name, mime_type: mime, base64_data: toBase64(await f.arrayBuffer()) };
  }

  $('pr-read').addEventListener('click', async () => {
    if (chosen.reduce((n, f) => n + f.size, 0) > MAX_BYTES) { $('pr-read-status').textContent = 'The files are over 15 MB in total. Remove or compress some.'; return; }
    const btn = $('pr-read');
    btn.disabled = true; btn.textContent = 'Reading your documents...';
    $('pr-read-status').textContent = 'This can take up to a minute for a long rate list.';
    try {
      const files = [];
      for (const f of chosen) files.push(await prepare(f));
      const out = await postJson(EXTRACT_URL, { phone: verifiedPhone, otp_token: otpToken, files });
      fill(out);
      $('pr-read-status').textContent = '';
    } catch (err) {
      if (err.expired) { resetVerification(); setPhoneStatus('Please verify your number again.', 'error'); $('pr-upload').classList.add('hidden'); }
      $('pr-read-status').textContent = err.message + ' You can try again or type your details in.';
    } finally { btn.disabled = false; btn.textContent = 'Read my documents'; }
  });
  $('pr-skip').addEventListener('click', () => fill({ rep: {}, price_list: [], uploads_folder_url: '' }));

  // ---- review form ----
  const numStr = (v) => (v === null || v === undefined || v === '' ? '' : String(v));
  function fill(out) {
    const r = out.rep || {};
    folderUrl = out.uploads_folder_url || '';
    const name = String(r.name || '').replace(/^(mr|ms|mrs|dr)\.?\s+/i, '').trim();
    const sp = name.lastIndexOf(' ');
    if (!val('pr-first')) { $('pr-first').value = sp > 0 ? name.slice(0, sp) : name; $('pr-last').value = sp > 0 ? name.slice(sp + 1) : ''; }
    const set = (id, v) => { if (v !== null && v !== undefined && String(v).trim() !== '' && !$(id).value) $(id).value = v; };
    set('pr-company', r.company); set('pr-division', r.division); set('pr-designation', r.designation); set('pr-email', r.email);
    $('pr-offer').value = ['Scheme', 'Discount', 'No_Offer'].includes(r.offer_type) ? r.offer_type : $('pr-offer').value;
    if (r.offer_type === 'Scheme') { set('pr-buy', numStr(r.buy_or_margin)); set('pr-free', numStr(r.get_free)); }
    if (r.offer_type === 'Discount') set('pr-marginpct', numStr(r.buy_or_margin));
    set('pr-moq', numStr(r.moq)); set('pr-cash', numStr(r.cash_discount_percent)); set('pr-delivery', numStr(r.delivery_days)); set('pr-terms', r.payment_terms); set('pr-pref', r.stockist);
    rows = (out.price_list || []).map((p) => ({ category: p.category || '', brand: p.brand || '', ingredients: p.ingredients || '', sku: p.sku || '', ptr: numStr(p.ptr), mrp: numStr(p.mrp), stockist: '' }));
    syncOffer(); renderRows();
    $('pr-upload').classList.add('hidden');
    $('pr-form').classList.remove('hidden');
    $('pr-form').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function syncOffer() {
    const t = $('pr-offer').value;
    $('pr-scheme').classList.toggle('hidden', t !== 'Scheme');
    $('pr-margin').classList.toggle('hidden', t !== 'Discount');
  }
  $('pr-offer').addEventListener('change', syncOffer);

  function rowHtml(r, i) {
    const cats = CATEGORIES.includes(r.category) || !r.category ? CATEGORIES : [r.category, ...CATEGORIES];
    const lbl = 'block text-xs font-semibold text-[#46536b] mb-1';
    return `<details class="rounded-xl border border-[#e5e2e8] bg-[#fdfcfe]" data-i="${i}">
      <summary class="cursor-pointer list-none px-3 py-3 flex items-center justify-between gap-3">
        <span class="min-w-0"><span class="block font-semibold text-[#17233d] truncate" data-title>${esc(r.sku || 'New product')}</span><span class="block text-xs text-[#7b8495] truncate" data-sub>${esc(r.brand || '')}</span></span>
        <span class="shrink-0 text-right text-xs text-[#46536b]" data-prices>${r.ptr ? 'PTR ₹' + esc(r.ptr) : ''}${r.mrp ? '<br>MRP ₹' + esc(r.mrp) : ''}</span>
      </summary>
      <div class="px-3 pb-3 space-y-3">
        <div><label class="${lbl}">Product and pack size</label><input class="${inputCls}" data-f="sku" value="${esc(r.sku)}" /></div>
        <div><label class="${lbl}">Brand</label><input class="${inputCls}" data-f="brand" value="${esc(r.brand)}" /></div>
        <div><label class="${lbl}">Category</label><select class="${inputCls}" data-f="category"><option value="">—</option>${cats.map((c) => `<option${c === r.category ? ' selected' : ''}>${esc(c)}</option>`).join('')}</select></div>
        <div><label class="${lbl}">Active ingredients</label><textarea rows="2" class="${inputCls}" data-f="ingredients">${esc(r.ingredients)}</textarea></div>
        <div class="grid grid-cols-2 gap-3">
          <div><label class="${lbl}">PTR (₹)</label><input inputmode="decimal" class="${inputCls}" data-f="ptr" value="${esc(r.ptr)}" /></div>
          <div><label class="${lbl}">MRP (₹)</label><input inputmode="decimal" class="${inputCls}" data-f="mrp" value="${esc(r.mrp)}" /></div>
        </div>
        <div><label class="${lbl}">Stockist for this product (if different)</label><input class="${inputCls}" data-f="stockist" value="${esc(r.stockist)}" /></div>
        <button type="button" data-remove class="text-sm text-red-600 font-semibold">Remove this product</button>
      </div></details>`;
  }
  function renderRows() {
    $('pr-rows').innerHTML = rows.map(rowHtml).join('') || '<p class="text-sm text-[#7b8495]">No products yet. Add them one by one, or go back and upload a rate list.</p>';
    $('pr-price-count').textContent = rows.length ? `(${rows.length})` : '';
  }
  $('pr-rows').addEventListener('input', (e) => {
    const d = e.target.closest('details'); const f = e.target.dataset.f; if (!d || !f) return;
    const r = rows[+d.dataset.i]; r[f] = e.target.value;
    d.querySelector('[data-title]').textContent = r.sku || 'New product';
    d.querySelector('[data-sub]').textContent = r.brand || '';
    d.querySelector('[data-prices]').innerHTML = (r.ptr ? 'PTR ₹' + esc(r.ptr) : '') + (r.mrp ? '<br>MRP ₹' + esc(r.mrp) : '');
  });
  $('pr-rows').addEventListener('click', (e) => {
    if (!e.target.hasAttribute('data-remove')) return;
    rows.splice(+e.target.closest('details').dataset.i, 1); renderRows();
  });
  $('pr-add-row').addEventListener('click', () => { rows.push({ category: '', brand: '', ingredients: '', sku: '', ptr: '', mrp: '', stockist: '' }); renderRows(); const d = $('pr-rows').lastElementChild; if (d) { d.open = true; d.scrollIntoView({ block: 'center' }); } });

  function collect() {
    return {
      phone: verifiedPhone, otpToken, website: val('pr-website'),
      salutation: val('pr-salutation'), firstName: val('pr-first'), lastName: val('pr-last'), company: val('pr-company'), division: val('pr-division'), designation: val('pr-designation'), email: val('pr-email'),
      offerType: val('pr-offer'), buyQty: val('pr-buy'), freeQty: val('pr-free'), marginPercent: val('pr-marginpct'),
      moq: val('pr-moq'), cashDiscountPercent: val('pr-cash'), deliveryDays: val('pr-delivery'), paymentTerms: val('pr-terms'), medvolApp: val('pr-medvol'),
      prefStockist: val('pr-pref'), secStockist1: val('pr-sec1'), secStockist2: val('pr-sec2'),
      uploadsFolderUrl: folderUrl, priceList: rows.filter((r) => String(r.sku).trim()),
    };
  }
  function problem(v) {
    if (!verifiedPhone) return 'Please verify your WhatsApp number first.';
    if (!v.firstName) return 'Please enter your name.';
    if (!v.company) return 'Please enter your company.';
    if (v.email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.email)) return 'Please enter a valid email address.';
    if (v.offerType === 'Scheme' && (!v.buyQty || !v.freeQty)) return 'For a scheme, enter both the buy and the free quantity.';
    return '';
  }
  $('pr-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const v = collect();
    const msg = problem(v);
    $('pr-error').textContent = msg;
    if (msg) return;
    const btn = $('pr-submit');
    btn.disabled = true; btn.textContent = 'Submitting...';
    try {
      await postJson('/.netlify/functions/public-partner-registration', v);
      $('pr-form-container').classList.add('hidden');
      $('pr-success').classList.remove('hidden');
      $('pr-success').scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      if (err.expired) { resetVerification(); setPhoneStatus('Please verify your number again.', 'error'); window.scrollTo({ top: 0, behavior: 'smooth' }); }
      $('pr-error').textContent = err.message;
    } finally { btn.disabled = false; btn.textContent = 'Submit registration'; }
  });
</script>
