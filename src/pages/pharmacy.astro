---
// src/pages/pharmacy.astro
//
// Standalone Pharmacy System, for pharmacist OR doctor accounts (see
// pharmacy-manager.js's role check). Same auth model as
// /bookings-manager and /prescription -- real per-staff Supabase Auth,
// JWT re-verified server-side on every request.
//
// Unlike /prescription's derm_rx_* tables (kept fully separate from
// CRIS ClinicOS), this tool deliberately REUSES ClinicOS's existing
// suppliers/medicines/medicine_batches/purchase_orders/
// pharmacy_dispenses/bills schema -- see pharmacy-manager.js's header
// comment for why. Ported from a mature Google Apps Script "CRISPR
// Pharmacy OS" (executeStockOut/voidEntireSale/processPartialReturn
// -> execute_pharmacy_sale/void_pharmacy_sale/return_pharmacy_sale_items).
//
// Built from the start with the site's real Warm Luxury design system
// (Plus Jakarta Sans, brand navy, champagne, warmwhite) -- unlike
// /prescription, which needed a later re-skin pass.
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Pharmacy" description="Pharmacy inventory, purchasing, and dispensing">

<div id="ph-app-root" class="min-h-screen bg-warmwhite">

  <!-- ================= LOGIN SCREEN ================= -->
  <div id="ph-login-screen" class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-sm text-center border border-champagne-200">
      <h2 class="text-2xl font-bold text-brand-900 mb-1">Pharmacy</h2>
      <p class="text-charcoal/50 text-sm mb-6">Sign in with your pharmacist or doctor account.</p>
      <form id="ph-login-form" class="space-y-4 text-left">
        <div>
          <label for="ph-email" class="text-xs font-semibold text-charcoal/50 mb-1 block">Email</label>
          <input type="email" id="ph-email" required placeholder="you@crisprdermatology.com"
                 class="w-full text-base border border-champagne-300 rounded-xl px-4 py-3 bg-champagne-50 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-all" />
        </div>
        <div>
          <label for="ph-password" class="text-xs font-semibold text-charcoal/50 mb-1 block">Password</label>
          <input type="password" id="ph-password" required placeholder="••••••••"
                 class="w-full text-base border border-champagne-300 rounded-xl px-4 py-3 bg-champagne-50 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-all" />
        </div>
        <button type="submit" id="ph-login-btn"
                class="w-full bg-brand-900 text-white font-bold py-3 rounded-xl shadow-lg transition-all active:scale-[0.98]">
          Sign In
        </button>
        <p id="ph-login-error" class="text-red-500 text-sm text-center min-h-[1.25rem]"></p>
      </form>
    </div>
  </div>

  <!-- ================= MAIN APP ================= -->
  <div id="ph-app-screen" class="hidden min-h-screen bg-warmwhite">
    <div class="bg-white border-b border-champagne-200 sticky top-0 z-20 px-6 py-4 flex items-center justify-between shadow-sm">
      <div>
        <h1 class="text-xl font-bold text-brand-900">Pharmacy</h1>
        <p id="ph-user-name" class="text-sm text-charcoal/60"></p>
      </div>
      <button id="ph-signout-btn" class="text-xs font-semibold text-charcoal/40 hover:text-red-600 transition">Sign out</button>
    </div>

    <!-- Tab bar -->
    <div class="bg-white border-b border-champagne-200 px-6 flex gap-1 sticky top-[69px] z-10">
      <button data-ph-tab="checkout" class="ph-tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-brand-700 text-brand-900">Checkout</button>
      <button data-ph-tab="inventory" class="ph-tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-charcoal/50 hover:text-brand-700">Inventory</button>
      <button data-ph-tab="purchasing" class="ph-tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-charcoal/50 hover:text-brand-700">Purchase Orders</button>
      <button data-ph-tab="reconcile" class="ph-tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-charcoal/50 hover:text-brand-700">Reconcile</button>
    </div>

    <div class="max-w-5xl mx-auto px-6 py-8">

      <!-- ============ CHECKOUT TAB ============ -->
      <div id="ph-tab-checkout" class="ph-tab-panel">
        <div class="grid md:grid-cols-2 gap-6">
          <!-- Add items -->
          <div class="bg-white rounded-2xl border border-champagne-200 shadow-sm p-6">
            <h2 class="text-sm font-bold text-brand-700 uppercase tracking-wide mb-4">Add Medicine</h2>
            <div class="relative mb-3">
              <input type="text" id="ph-med-search" placeholder="Search medicine by name..."
                     class="w-full text-base border border-champagne-300 rounded-xl px-4 py-3 bg-champagne-50 focus:bg-white focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition-all" />
              <div id="ph-med-results" class="hidden absolute mt-1 w-full bg-white rounded-xl border border-champagne-200 shadow-lg overflow-hidden divide-y divide-champagne-100 z-10 max-h-64 overflow-y-auto"></div>
            </div>
            <div id="ph-med-selected" class="hidden bg-champagne-50 rounded-xl p-4 mb-3">
              <p id="ph-med-selected-name" class="font-bold text-brand-900 text-sm"></p>
              <div id="ph-med-batches" class="mt-2 space-y-1"></div>
              <div class="flex items-center gap-2 mt-3">
                <label class="text-xs font-semibold text-charcoal/50">Quantity</label>
                <input type="number" id="ph-med-qty" min="1" value="1" class="w-20 border border-champagne-300 rounded-lg px-2 py-1.5 text-sm" />
                <button id="ph-add-to-cart-btn" class="ml-auto bg-brand-700 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-brand-900 transition">Add to Sale</button>
              </div>
            </div>
            <p class="text-xs text-charcoal/40">Batches are suggested oldest-first (FIFO) automatically.</p>
          </div>

          <!-- Cart / checkout -->
          <div class="bg-white rounded-2xl border border-champagne-200 shadow-sm p-6 flex flex-col">
            <h2 class="text-sm font-bold text-brand-700 uppercase tracking-wide mb-4">Current Sale</h2>
            <div id="ph-cart-list" class="flex-1 space-y-2 mb-4 min-h-[80px]">
              <p id="ph-cart-empty" class="text-charcoal/30 text-sm text-center py-8">No items added yet.</p>
            </div>
            <div class="border-t border-champagne-200 pt-4 space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span class="text-charcoal/60">Total</span>
                <span id="ph-cart-total" class="text-xl font-bold text-brand-900">₹0</span>
              </div>
              <input type="text" id="ph-cart-patient-name" placeholder="Patient name (walk-in OK)"
                     class="w-full text-sm border border-champagne-300 rounded-lg px-3 py-2 bg-champagne-50 focus:bg-white focus:border-brand-500 outline-none" />
              <input type="text" id="ph-cart-patient-phone" placeholder="Phone (optional)"
                     class="w-full text-sm border border-champagne-300 rounded-lg px-3 py-2 bg-champagne-50 focus:bg-white focus:border-brand-500 outline-none" />
              <select id="ph-cart-payment-mode" class="w-full text-sm border border-champagne-300 rounded-lg px-3 py-2 bg-champagne-50">
                <option value="cash">Cash</option>
                <option value="upi">UPI</option>
                <option value="card">Card</option>
              </select>
              <button id="ph-checkout-btn" class="w-full bg-brand-900 text-white font-bold py-3 rounded-xl shadow-lg transition-all active:scale-[0.98] disabled:opacity-40" disabled>
                Complete Sale
              </button>
              <p id="ph-checkout-error" class="text-red-500 text-sm text-center min-h-[1.25rem]"></p>
            </div>
          </div>
        </div>

        <!-- Recent sales / void / return -->
        <div class="mt-6 bg-white rounded-2xl border border-champagne-200 shadow-sm p-6">
          <h2 class="text-sm font-bold text-brand-700 uppercase tracking-wide mb-4">Recent Sales</h2>
          <div id="ph-recent-sales" class="space-y-2">
            <p class="text-charcoal/30 text-sm text-center py-4">No sales yet this session.</p>
          </div>
        </div>
      </div>

      <!-- ============ INVENTORY TAB ============ -->
      <div id="ph-tab-inventory" class="ph-tab-panel hidden">
        <div class="flex items-center justify-between mb-4">
          <div class="flex gap-2">
            <button data-ph-inv-view="all" class="ph-inv-view-btn text-xs font-bold px-3 py-1.5 rounded-full bg-brand-700 text-white">All Stock</button>
            <button data-ph-inv-view="low" class="ph-inv-view-btn text-xs font-bold px-3 py-1.5 rounded-full bg-champagne-100 text-brand-700">Low Stock</button>
            <button data-ph-inv-view="expiring" class="ph-inv-view-btn text-xs font-bold px-3 py-1.5 rounded-full bg-champagne-100 text-brand-700">Expiring Soon</button>
          </div>
          <button id="ph-new-medicine-btn" class="text-xs font-bold px-4 py-2 rounded-lg bg-brand-900 text-white">+ New Medicine</button>
        </div>
        <div id="ph-inventory-list" class="bg-white rounded-2xl border border-champagne-200 shadow-sm divide-y divide-champagne-100 overflow-hidden">
          <p class="text-charcoal/30 text-sm text-center py-8">Loading inventory...</p>
        </div>
      </div>

      <!-- ============ PURCHASE ORDERS TAB ============ -->
      <div id="ph-tab-purchasing" class="ph-tab-panel hidden">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-bold text-brand-700 uppercase tracking-wide">Purchase Orders</h2>
          <button id="ph-new-po-btn" class="text-xs font-bold px-4 py-2 rounded-lg bg-brand-900 text-white">+ New Purchase Order</button>
        </div>
        <div id="ph-po-list" class="bg-white rounded-2xl border border-champagne-200 shadow-sm divide-y divide-champagne-100 overflow-hidden">
          <p class="text-charcoal/30 text-sm text-center py-8">Loading purchase orders...</p>
        </div>
      </div>

      <!-- ============ RECONCILE TAB (Phase 2: AI invoice review, physical audit, reorder, reps) ============ -->
      <div id="ph-tab-reconcile" class="ph-tab-panel hidden">
        <div class="flex gap-2 mb-4">
          <button data-ph-rec-view="invoices" class="ph-rec-view-btn text-xs font-bold px-3 py-1.5 rounded-full bg-brand-700 text-white">Invoice Review</button>
          <button data-ph-rec-view="audit" class="ph-rec-view-btn text-xs font-bold px-3 py-1.5 rounded-full bg-champagne-100 text-brand-700">Physical Audit</button>
          <button data-ph-rec-view="reorder" class="ph-rec-view-btn text-xs font-bold px-3 py-1.5 rounded-full bg-champagne-100 text-brand-700">Reorder Suggestions</button>
          <button data-ph-rec-view="reps" class="ph-rec-view-btn text-xs font-bold px-3 py-1.5 rounded-full bg-champagne-100 text-brand-700">Reps</button>
        </div>

        <!-- Invoice Review sub-view -->
        <div id="ph-rec-invoices" class="ph-rec-subview">
          <div class="flex items-center justify-between mb-4">
            <p class="text-xs text-charcoal/50">Upload an invoice photo/PDF to extract it with AI, or review drafts already waiting.</p>
            <label class="text-xs font-bold px-4 py-2 rounded-lg bg-brand-900 text-white cursor-pointer">
              + Upload Invoice
              <input type="file" id="ph-invoice-upload-input" accept="image/*,.pdf" class="hidden" />
            </label>
          </div>
          <p id="ph-invoice-upload-status" class="text-xs text-charcoal/50 mb-3"></p>
          <div id="ph-pending-approvals-list" class="bg-white rounded-2xl border border-champagne-200 shadow-sm divide-y divide-champagne-100 overflow-hidden">
            <p class="text-charcoal/30 text-sm text-center py-8">Loading pending invoices...</p>
          </div>
        </div>

        <!-- Physical Audit sub-view -->
        <div id="ph-rec-audit" class="ph-rec-subview hidden">
          <p class="text-xs text-charcoal/50 mb-3">Count what's actually on the shelf and enter it below — only medicines with a real discrepancy will be adjusted.</p>
          <div id="ph-audit-list" class="bg-white rounded-2xl border border-champagne-200 shadow-sm divide-y divide-champagne-100 overflow-hidden mb-4">
            <p class="text-charcoal/30 text-sm text-center py-8">Loading medicines...</p>
          </div>
          <button id="ph-submit-audit-btn" class="bg-brand-900 text-white font-bold px-6 py-3 rounded-xl">Submit Audit</button>
          <p id="ph-audit-result" class="text-sm text-charcoal/60 mt-3"></p>
        </div>

        <!-- Reorder Suggestions sub-view -->
        <div id="ph-rec-reorder" class="ph-rec-subview hidden">
          <div id="ph-reorder-list" class="bg-white rounded-2xl border border-champagne-200 shadow-sm divide-y divide-champagne-100 overflow-hidden">
            <p class="text-charcoal/30 text-sm text-center py-8">Loading suggestions...</p>
          </div>
        </div>

        <!-- Reps sub-view -->
        <div id="ph-rec-reps" class="ph-rec-subview hidden">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-bold text-brand-700 uppercase tracking-wide">Medical Reps</h2>
            <button id="ph-new-rep-btn" class="text-xs font-bold px-4 py-2 rounded-lg bg-brand-900 text-white">+ New Rep</button>
          </div>
          <div id="ph-reps-list" class="bg-white rounded-2xl border border-champagne-200 shadow-sm divide-y divide-champagne-100 overflow-hidden">
            <p class="text-charcoal/30 text-sm text-center py-8">Loading reps...</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ================= MODALS ================= -->
  <div id="ph-modal-backdrop" class="hidden fixed inset-0 bg-black/40 z-30 flex items-center justify-center p-4">
    <div id="ph-modal-content" class="bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[85vh] overflow-y-auto"></div>
  </div>

</div>
</AppLayout>

<script define:vars={{ supabaseUrl: import.meta.env.PUBLIC_APPOINTMENT_MANAGER_SUPABASE_URL, supabaseAnonKey: import.meta.env.PUBLIC_APPOINTMENT_MANAGER_SUPABASE_ANON_KEY }}>
  window.__PH_SUPABASE_URL__ = supabaseUrl;
  window.__PH_SUPABASE_ANON_KEY__ = supabaseAnonKey;
</script>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script is:inline src="/scripts/pharmacy-app.js"></script>
