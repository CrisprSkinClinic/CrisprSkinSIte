---
// src/pages/register.astro
//
// Public patient self-registration form. Submissions go into
// patient_registration_requests (via public-patient-registration.js),
// NOT directly into the real patients table -- every submission
// requires staff approval before becoming a real patient record.
//
// One card with three tinted groups (not collapsible). The phone number must be verified with a WhatsApp
// code (send-booking-otp / verify-booking-otp); the server consumes the
// one-time token, so a registration can only carry a number its owner holds.
// Under-18s must give a guardian's name, and a friend/family or doctor
// referral asks for the referrer's name. "Review My Details" shows a preview
// before anything is submitted.
import MainLayout from '../layouts/MainLayout.astro';
import { siteConfig } from '../config/site.js';

const field = "w-full bg-white px-4 py-3 border border-slate-300 rounded-xl focus:border-brand-500 focus:ring-2 focus:ring-brand-100 outline-none transition";
const label = "text-sm font-semibold text-slate-700 mb-1 block";
---

<MainLayout title={`Patient Registration | ${siteConfig.name}`} description="Register as a new patient at CRISPR Skin and Hair Clinic ahead of your visit.">
  <div class="max-w-3xl mx-auto py-10 md:py-16 px-4 md:px-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-brand-900 mb-3 text-center">Patient Registration</h1>
    <p class="text-slate-600 text-center mb-10">
      Register your details ahead of your visit. Our front desk will review and confirm your registration -- there's nothing further you need to do after submitting.
    </p>

    <div id="reg-form-container" class="bg-white rounded-2xl shadow-sm border border-champagne-200 p-3 sm:p-6 md:p-10">
      <form id="reg-form" class="space-y-4" novalidate>

        <div role="group" aria-labelledby="reg-part-1" class="rounded-xl bg-brand-50 border border-brand-100 p-4 md:p-6 space-y-5">
          <h2 id="reg-part-1" class="text-base font-bold text-brand-900">1. About You</h2>
        <!-- Phone, verified with a WhatsApp code -->
        <div>
          <label for="reg-phone" class={label}>WhatsApp Number *</label>
          <div class="flex gap-2">
            <div class="relative flex-1 min-w-0">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">+91</span>
              <input type="tel" id="reg-phone" required placeholder="10-digit mobile" autocomplete="tel-national" inputmode="numeric" maxlength="10"
                     class={`${field} pl-12`} />
            </div>
            <button type="button" id="reg-send-code"
                    class="shrink-0 px-4 rounded-xl font-semibold bg-brand-900 text-white hover:bg-brand-800 transition disabled:opacity-50">
              Verify
            </button>
          </div>
          <div id="reg-code-group" class="hidden mt-3">
            <label for="reg-code" class={label}>Enter the 6-digit code sent on WhatsApp</label>
            <div class="flex gap-2">
              <input type="text" id="reg-code" placeholder="6-digit code" autocomplete="one-time-code" inputmode="numeric" maxlength="6"
                     class={`${field} flex-1 min-w-0 tracking-widest`} />
              <button type="button" id="reg-verify-code"
                      class="shrink-0 px-4 rounded-xl font-semibold bg-brand-900 text-white hover:bg-brand-800 transition disabled:opacity-50">
                Confirm
              </button>
            </div>
            <button type="button" id="reg-resend" class="text-sm text-brand-700 font-semibold mt-2 hover:underline">Resend code</button>
          </div>
          <p id="reg-phone-status" class="text-slate-500 text-xs mt-1 min-h-[1rem]"></p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="reg-salutation" class={label}>Salutation *</label>
            <select id="reg-salutation" required class={field}>
              <option value="">Select</option>
              <option value="Mr.">Mr.</option>
              <option value="Ms.">Ms.</option>
              <option value="Mrs.">Mrs.</option>
              <option value="Dr.">Dr.</option>
              <option value="Master">Master</option>
              <option value="Baby">Baby</option>
            </select>
          </div>
          <div>
            <label for="reg-gender" class={label}>Gender *</label>
            <select id="reg-gender" required class={field}>
              <option value="">Select</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="reg-first-name" class={label}>First Name *</label>
            <input type="text" id="reg-first-name" required placeholder="First name" autocomplete="given-name" class={field} />
          </div>
          <div>
            <label for="reg-last-name" class={label}>Last Name *</label>
            <input type="text" id="reg-last-name" required placeholder="Last name" autocomplete="family-name" class={field} />
          </div>
        </div>

        <div>
          <label for="reg-dob" class={label}>Date of Birth *</label>
          <div class="flex gap-2">
            <input type="text" id="reg-dob" required placeholder="DD/MM/YYYY" inputmode="numeric" maxlength="10" autocomplete="bday" class={field} />
            <label for="reg-dob-picker" class="shrink-0 w-12 flex items-center justify-center border border-slate-300 rounded-xl cursor-pointer hover:bg-slate-50 transition" aria-label="Pick date from calendar">
              <svg class="w-5 h-5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
              <input type="date" id="reg-dob-picker" class="sr-only" />
            </label>
          </div>
          <p id="reg-dob-error" class="text-slate-500 text-xs mt-1 min-h-[1rem]"></p>
          <p class="text-slate-400 text-xs">Type it in, or tap the calendar icon to pick a date. <span id="reg-age-display"></span></p>
        </div>

        <div id="reg-guardian-group" class="hidden">
          <label for="reg-guardian" class={label}>Parent / Guardian Name *</label>
          <input type="text" id="reg-guardian" placeholder="Parent or guardian's full name" class={field} />
          <p class="text-slate-400 text-xs mt-1">Needed because the patient is under 18.</p>
        </div>

        </div>

        <div role="group" aria-labelledby="reg-part-2" class="rounded-xl bg-gold-50 border border-gold-100 p-4 md:p-6 space-y-5">
          <h2 id="reg-part-2" class="text-base font-bold text-brand-900">2. Contact Details</h2>
        <div>
          <label for="reg-email" class={label}>Email Address *</label>
          <input type="email" id="reg-email" required placeholder="you@example.com" autocomplete="email" inputmode="email" class={field} />
        </div>

        <div>
          <label for="reg-pincode" class={label}>Pincode *</label>
          <input type="text" id="reg-pincode" required placeholder="6-digit pincode" inputmode="numeric" maxlength="6" autocomplete="postal-code" class={field} />
          <p id="reg-pincode-status" class="text-slate-500 text-xs mt-1 min-h-[1rem]"></p>
        </div>

        <div>
          <label for="reg-area" class={label}>Area *</label>
          <select id="reg-area" required disabled class={`${field} disabled:bg-slate-50 disabled:text-slate-400`}>
            <option value="">Enter pincode first</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="reg-city" class={label}>District *</label>
            <input type="text" id="reg-city" required placeholder="District" autocomplete="address-level2" class={field} />
          </div>
          <div>
            <label for="reg-state" class={label}>State *</label>
            <input type="text" id="reg-state" required placeholder="State" autocomplete="address-level1" class={field} />
          </div>
        </div>

        <div>
          <label for="reg-address" class={label}>Door No. / Apartment / Street *</label>
          <textarea id="reg-address" required rows="2" placeholder="Door no., apartment, street" autocomplete="street-address" class={field}></textarea>
          <p id="reg-address-counter" class="text-slate-500 text-xs mt-1">0/10 characters</p>
        </div>

        </div>

        <div role="group" aria-labelledby="reg-part-3" class="rounded-xl bg-champagne-100/60 border border-champagne-200 p-4 md:p-6 space-y-5">
          <h2 id="reg-part-3" class="text-base font-bold text-brand-900">3. A Little More</h2>
        <div>
          <label for="reg-occupation" class={label}>Occupation *</label>
          <input type="text" id="reg-occupation" required placeholder="Your occupation" autocomplete="organization-title" class={field} />
        </div>

        <div>
          <label for="reg-referral" class={label}>How did you hear about us? *</label>
          <select id="reg-referral" required class={field}>
            <option value="">Select</option>
            <option value="Friend/Family Referral">Friend/Family Referral</option>
            <option value="Doctor Referral">Doctor Referral</option>
            <option value="Google Search">Google Search</option>
            <option value="Social Media">Social Media</option>
            <option value="Practo">Practo</option>
            <option value="Walk-in">Walk-in</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div id="reg-referral-other-group" class="hidden">
          <label for="reg-referral-other" id="reg-referral-other-label" class={label}>Please specify *</label>
          <input type="text" id="reg-referral-other" placeholder="How did you hear about us?" class={field} />
        </div>

        </div>

        <button type="submit" id="reg-review-btn"
                class="w-full bg-brand-900 hover:bg-brand-800 text-white font-bold py-3.5 rounded-xl shadow-lg transition active:scale-[0.98] mt-2">
          Review My Details
        </button>
        <p id="reg-error" class="text-red-600 text-sm text-center min-h-[1.25rem]"></p>
      </form>
    </div>

    <!-- Review/preview screen -- shown after "Review My Details" passes validation,
         before anything is actually submitted to the server -->
    <div id="reg-review-container" class="hidden bg-white rounded-2xl shadow-sm border border-champagne-200 p-5 sm:p-8 md:p-12">
      <h2 class="text-xl font-bold text-slate-900 mb-1">Review Your Details</h2>
      <p class="text-slate-500 text-sm mb-6">Please check everything below is correct before submitting.</p>

      <dl id="reg-review-list" class="divide-y divide-slate-100 border-y border-slate-100 mb-8"></dl>

      <div class="flex flex-col sm:flex-row gap-3">
        <button type="button" id="reg-back-btn"
                class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-semibold border border-slate-300 text-slate-700 hover:bg-slate-50 transition">
          Back to Edit
        </button>
        <button type="button" id="reg-confirm-btn"
                class="w-full flex-1 bg-brand-900 hover:bg-brand-800 text-white font-bold py-3.5 rounded-xl shadow-lg transition active:scale-[0.98]">
          Confirm &amp; Submit
        </button>
      </div>
      <p id="reg-submit-error" class="text-red-600 text-sm text-center min-h-[1.25rem] mt-3"></p>
    </div>

    <!-- Shown briefly after successful submission, before redirecting home -->
    <div id="reg-success-container" class="hidden bg-white rounded-2xl shadow-sm border border-champagne-200 p-10 text-center">
      <div class="w-14 h-14 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
      </div>
      <h2 class="text-xl font-bold text-slate-900 mb-2">Registration Submitted</h2>
      <p class="text-slate-600">
        Thank you -- your registration has been received and is pending review by our front desk. Taking you back to our homepage...
      </p>
    </div>
  </div>
</MainLayout>

<script is:inline>
  const $ = (id) => document.getElementById(id);

  // --- DOB parsing, shared by both the text field and the date picker ---
  function parseDOB(str) {
    const parts = String(str || '').match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!parts) return null;
    const d = new Date(parts[3], parts[2] - 1, parts[1]);
    if (Number.isNaN(d.getTime()) || d.getDate() !== Number(parts[1]) || d.getMonth() !== parts[2] - 1) return null;
    return d;
  }
  function ageOn(dobDate) {
    const today = new Date();
    let age = today.getFullYear() - dobDate.getFullYear();
    const monthDiff = today.getMonth() - dobDate.getMonth();
    if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dobDate.getDate())) age--;
    return age;
  }
  function validAge(dobDate) {
    if (!dobDate) return null;
    const age = ageOn(dobDate);
    return age < 0 || age > 120 ? null : age;
  }

  // Shows the age, and the guardian field for under-18s.
  function updateAge() {
    const dobDate = parseDOB($('reg-dob').value);
    const age = validAge(dobDate);
    $('reg-dob-error').textContent = dobDate && age === null ? 'Enter a valid date (DD/MM/YYYY)' : '';
    $('reg-age-display').textContent = age === null ? '' : `Age: ${age} years.`;
    const minor = age !== null && age < 18;
    $('reg-guardian-group').classList.toggle('hidden', !minor);
    $('reg-guardian').required = minor;
  }

  // --- DOB text field: auto-inserts "/" as the patient types digits ---
  const dobInput = $('reg-dob');
  dobInput.addEventListener('input', (e) => {
    const digits = e.target.value.replace(/[^0-9]/g, '').slice(0, 8);
    let formatted = digits;
    if (digits.length > 4) formatted = `${digits.slice(0, 2)}/${digits.slice(2, 4)}/${digits.slice(4)}`;
    else if (digits.length > 2) formatted = `${digits.slice(0, 2)}/${digits.slice(2)}`;
    e.target.value = formatted;
    const dobDate = parseDOB(formatted);
    if (dobDate) {
      $('reg-dob-picker').value = `${dobDate.getFullYear()}-${String(dobDate.getMonth() + 1).padStart(2, '0')}-${String(dobDate.getDate()).padStart(2, '0')}`;
    }
    updateAge();
  });
  dobInput.addEventListener('blur', updateAge);

  // --- Native date picker: fills the text field when a date is chosen ---
  $('reg-dob-picker').addEventListener('change', (e) => {
    const iso = e.target.value; // YYYY-MM-DD
    if (!iso) return;
    const [yyyy, mm, dd] = iso.split('-');
    dobInput.value = `${dd}/${mm}/${yyyy}`;
    updateAge();
  });

  // --- Salutation -> gender auto-suggestion ---
  $('reg-salutation').addEventListener('change', (e) => {
    const s = e.target.value;
    if (s === 'Mr.' || s === 'Master') $('reg-gender').value = 'male';
    else if (s === 'Ms.' || s === 'Mrs.' || s === 'Baby') $('reg-gender').value = 'female';
  });

  // --- Referral follow-up: who referred (friend/family, doctor) or "Other" details ---
  const REFERRAL_FOLLOW_UP = {
    'Friend/Family Referral': { label: 'Referred by (name) *', placeholder: "Your friend or family member's name", error: 'Please enter the name of the person who referred you.' },
    'Doctor Referral': { label: "Referring doctor's name *", placeholder: 'e.g. Dr. Priya Raman', error: "Please enter the referring doctor's name." },
    'Other': { label: 'Please specify *', placeholder: 'How did you hear about us?', error: 'Please specify how you heard about us.' },
  };
  $('reg-referral').addEventListener('change', (e) => {
    const followUp = REFERRAL_FOLLOW_UP[e.target.value];
    $('reg-referral-other-group').classList.toggle('hidden', !followUp);
    $('reg-referral-other').required = !!followUp;
    $('reg-referral-other').value = '';
    if (followUp) {
      $('reg-referral-other-label').textContent = followUp.label;
      $('reg-referral-other').placeholder = followUp.placeholder;
    }
  });

  // --- Address character counter ---
  $('reg-address').addEventListener('input', (e) => {
    $('reg-address-counter').textContent = `${e.target.value.length}/10 characters`;
  });

  // --- Phone verification with a WhatsApp code ---
  // verify-booking-otp returns a one-time token; the registration function
  // uses it up, so the number on the registration is one the patient holds.
  let verifiedPhone = '';
  let otpToken = '';
  function setPhoneStatus(text, tone) {
    const el = $('reg-phone-status');
    el.textContent = text;
    el.className = `text-xs mt-1 min-h-[1rem] ${tone === 'ok' ? 'text-green-700 font-semibold' : tone === 'error' ? 'text-red-600' : 'text-slate-500'}`;
  }
  function resetVerification() {
    verifiedPhone = '';
    otpToken = '';
    $('reg-phone').readOnly = false;
    $('reg-send-code').textContent = 'Verify';
    $('reg-send-code').disabled = false;
    $('reg-code-group').classList.add('hidden');
    $('reg-code').value = '';
  }
  $('reg-phone').addEventListener('input', (e) => {
    e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 10);
    setPhoneStatus('');
  });

  async function postJson(url, body) {
    const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const result = await response.json().catch(() => ({}));
    if (!response.ok || !result.success) throw new Error(result.error || 'Something went wrong. Please try again.');
    return result;
  }

  async function sendCode() {
    const phone = $('reg-phone').value.trim();
    if (!/^[6-9][0-9]{9}$/.test(phone)) { setPhoneStatus('Enter a valid 10-digit mobile number.', 'error'); return; }
    $('reg-send-code').disabled = true;
    $('reg-resend').disabled = true;
    setPhoneStatus('Sending code on WhatsApp...');
    try {
      await postJson('/.netlify/functions/send-booking-otp', { phone });
      $('reg-code-group').classList.remove('hidden');
      $('reg-code').focus();
      setPhoneStatus(`Code sent to +91 ${phone} on WhatsApp.`);
    } catch (err) {
      setPhoneStatus(err.message, 'error');
    } finally {
      $('reg-send-code').disabled = false;
      $('reg-resend').disabled = false;
    }
  }
  $('reg-send-code').addEventListener('click', () => {
    if (verifiedPhone) { resetVerification(); setPhoneStatus(''); $('reg-phone').focus(); return; }
    sendCode();
  });
  $('reg-resend').addEventListener('click', sendCode);

  $('reg-code').addEventListener('input', (e) => {
    e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 6);
    if (e.target.value.length === 6) $('reg-verify-code').click();
  });
  $('reg-verify-code').addEventListener('click', async () => {
    const phone = $('reg-phone').value.trim();
    const code = $('reg-code').value.trim();
    if (code.length !== 6) { setPhoneStatus('Enter the 6-digit code.', 'error'); return; }
    $('reg-verify-code').disabled = true;
    try {
      const result = await postJson('/.netlify/functions/verify-booking-otp', { phone, code });
      verifiedPhone = phone;
      otpToken = result.token;
      $('reg-phone').readOnly = true;
      $('reg-code-group').classList.add('hidden');
      $('reg-send-code').textContent = 'Change';
      setPhoneStatus('✓ Number verified', 'ok');
    } catch (err) {
      setPhoneStatus(err.message, 'error');
    } finally {
      $('reg-verify-code').disabled = false;
    }
  });

  // --- Pincode -> Area/District/State auto-fill, via India Post's free
  // public API. On any lookup failure the patient fills them in manually. ---
  let pincodeLookupTimer = null;
  let lastLookedUpPincode = '';

  function resetAreaDropdown(placeholderText) {
    $('reg-area').innerHTML = `<option value="">${placeholderText}</option>`;
    $('reg-area').disabled = true;
  }

  async function lookupPincodeArea(pincode) {
    const statusEl = $('reg-pincode-status');
    const areaSelect = $('reg-area');
    if (pincode === lastLookedUpPincode) return;
    lastLookedUpPincode = pincode;
    statusEl.textContent = 'Looking up area...';
    try {
      const response = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
      const data = await response.json();
      const result = Array.isArray(data) ? data[0] : null;
      const postOffices = result && result.Status === 'Success' ? result.PostOffice : null;
      if (!postOffices || postOffices.length === 0) {
        statusEl.textContent = "Couldn't find that pincode -- please fill in Area, District and State manually.";
        resetAreaDropdown('Select area');
        areaSelect.disabled = false;
        return;
      }
      statusEl.textContent = postOffices.length > 1 ? 'Multiple areas found for this pincode -- please select yours.' : '';
      areaSelect.innerHTML = '<option value="">Select area</option>'
        + postOffices.map((po) => `<option value="${po.Name}">${po.Name}</option>`).join('');
      areaSelect.disabled = false;
      if (postOffices.length === 1) areaSelect.value = postOffices[0].Name;
      $('reg-city').value = postOffices[0].District;
      $('reg-state').value = postOffices[0].State;
    } catch {
      statusEl.textContent = "Couldn't look up that pincode -- please fill in Area, District and State manually.";
      resetAreaDropdown('Select area');
      areaSelect.disabled = false;
    }
  }

  $('reg-pincode').addEventListener('input', (e) => {
    e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 6);
    clearTimeout(pincodeLookupTimer);
    if (e.target.value.length !== 6) {
      $('reg-pincode-status').textContent = '';
      lastLookedUpPincode = '';
      resetAreaDropdown('Enter pincode first');
      $('reg-city').value = '';
      $('reg-state').value = '';
      return;
    }
    pincodeLookupTimer = setTimeout(() => lookupPincodeArea(e.target.value), 400);
  });

  const GENDER_LABELS = { male: 'Male', female: 'Female', other: 'Other' };

  function collectFormValues() {
    const referralSource = $('reg-referral').value;
    const age = validAge(parseDOB($('reg-dob').value.trim()));
    return {
      salutation: $('reg-salutation').value,
      firstName: $('reg-first-name').value.trim(),
      lastName: $('reg-last-name').value.trim(),
      dob: $('reg-dob').value.trim(),
      gender: $('reg-gender').value,
      guardianName: age !== null && age < 18 ? $('reg-guardian').value.trim() : '',
      email: $('reg-email').value.trim(),
      phone: $('reg-phone').value.trim(),
      pincode: $('reg-pincode').value.trim(),
      area: $('reg-area').value,
      city: $('reg-city').value.trim(),
      state: $('reg-state').value.trim(),
      address: $('reg-address').value.trim(),
      occupation: $('reg-occupation').value.trim(),
      referralSource,
      referralOtherDetails: REFERRAL_FOLLOW_UP[referralSource] ? $('reg-referral-other').value.trim() : '',
    };
  }

  // Returns [message, fieldId] for the first problem, or null.
  function validateFormValues(v) {
    if (!/^[6-9][0-9]{9}$/.test(v.phone)) return ['Please enter a valid 10-digit WhatsApp number.', 'reg-phone'];
    if (!otpToken || verifiedPhone !== v.phone) return ['Please verify your WhatsApp number -- tap Verify and enter the code.', 'reg-phone'];
    if (!v.salutation) return ['Please select a salutation.', 'reg-salutation'];
    if (!v.gender) return ['Please select a gender.', 'reg-gender'];
    if (!v.firstName || !v.lastName) return ['Please enter your first and last name.', v.firstName ? 'reg-last-name' : 'reg-first-name'];
    const age = validAge(parseDOB(v.dob));
    if (age === null) return ['Please enter a valid date of birth (DD/MM/YYYY).', 'reg-dob'];
    if (age < 18 && !v.guardianName) return ["Please enter the parent or guardian's name.", 'reg-guardian'];
    if (!/^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|in)$/.test(v.email)) return ['Please enter a valid email address.', 'reg-email'];
    if (!/^[0-9]{6}$/.test(v.pincode)) return ['Please enter a valid 6-digit pincode.', 'reg-pincode'];
    if (!v.area) return ['Please select your area.', 'reg-area'];
    if (!v.city) return ['Please enter your district.', 'reg-city'];
    if (!v.state) return ['Please enter your state.', 'reg-state'];
    if (v.address.length < 10) return ['Please enter your door no. / apartment / street.', 'reg-address'];
    if (!v.occupation) return ['Please enter your occupation.', 'reg-occupation'];
    if (!v.referralSource) return ['Please let us know how you heard about us.', 'reg-referral'];
    if (REFERRAL_FOLLOW_UP[v.referralSource] && !v.referralOtherDetails) return [REFERRAL_FOLLOW_UP[v.referralSource].error, 'reg-referral-other'];
    return null;
  }

  const escapeHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  function reviewRow(label, value) {
    return `<div class="py-3 grid grid-cols-1 sm:grid-cols-3 gap-1 sm:gap-4">
      <dt class="text-sm font-semibold text-slate-500">${label}</dt>
      <dd class="sm:col-span-2 text-slate-800">${escapeHtml(value)}</dd>
    </div>`;
  }

  function renderReview(v) {
    const age = validAge(parseDOB(v.dob));
    const referralLabels = { 'Friend/Family Referral': 'Referred by', 'Doctor Referral': 'Referred by', 'Other': '' };
    const referralDisplay = v.referralOtherDetails
      ? `${v.referralSource} -- ${referralLabels[v.referralSource] ? `${referralLabels[v.referralSource]} ` : ''}${v.referralOtherDetails}`
      : v.referralSource;
    $('reg-review-list').innerHTML = [
      reviewRow('WhatsApp Number', `+91 ${v.phone} (verified)`),
      reviewRow('Name', `${v.salutation} ${v.firstName} ${v.lastName}`),
      reviewRow('Gender', GENDER_LABELS[v.gender] || v.gender),
      reviewRow('Date of Birth', `${v.dob} (${age} years)`),
      v.guardianName ? reviewRow('Parent / Guardian', v.guardianName) : '',
      reviewRow('Email', v.email),
      reviewRow('Address', `${v.address}, ${v.area}, ${v.city}, ${v.state} - ${v.pincode}`),
      reviewRow('Occupation', v.occupation),
      reviewRow('How you heard about us', referralDisplay),
    ].join('');
  }

  function showError(elId, problem) {
    $(elId).textContent = problem[0];
    const field = $(problem[1]);
    if (field) { field.scrollIntoView({ behavior: 'smooth', block: 'center' }); field.focus({ preventScroll: true }); }
  }

  // --- "Review My Details" -> validate, then show the review screen ---
  $('reg-form').addEventListener('submit', (e) => {
    e.preventDefault();
    $('reg-error').textContent = '';
    const values = collectFormValues();
    const problem = validateFormValues(values);
    if (problem) { showError('reg-error', problem); return; }
    renderReview(values);
    $('reg-form-container').classList.add('hidden');
    $('reg-review-container').classList.remove('hidden');
    $('reg-review-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  function backToForm() {
    $('reg-review-container').classList.add('hidden');
    $('reg-form-container').classList.remove('hidden');
    $('reg-form-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  $('reg-back-btn').addEventListener('click', backToForm);

  // --- "Confirm & Submit" -> calls the API, then redirects home ---
  $('reg-confirm-btn').addEventListener('click', async () => {
    const btn = $('reg-confirm-btn');
    $('reg-submit-error').textContent = '';
    const values = collectFormValues();
    const problem = validateFormValues(values);
    if (problem) { backToForm(); showError('reg-error', problem); return; }

    btn.disabled = true;
    btn.textContent = 'Submitting...';
    try {
      const response = await fetch('/.netlify/functions/public-patient-registration', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...values, name: `${values.salutation} ${values.firstName} ${values.lastName}`.trim(), otpToken }),
      });
      const result = await response.json().catch(() => ({}));
      if (result.verificationExpired) {
        resetVerification();
        backToForm();
        showError('reg-error', ['Your WhatsApp verification has expired. Please verify your number again.', 'reg-phone']);
        return;
      }
      if (!response.ok || !result.success) throw new Error(result.error || 'Something went wrong. Please try again.');
      $('reg-review-container').classList.add('hidden');
      $('reg-success-container').classList.remove('hidden');
      $('reg-success-container').scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => { window.location.href = '/'; }, 2200);
    } catch (err) {
      $('reg-submit-error').textContent = err.message;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Confirm & Submit';
    }
  });
</script>
