---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import BookingSection from '../../components/LandingPageSections/BookingSection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ClinicGallery from '../../components/ClinicGallery.astro';
import StepCards from '../../components/ui/StepCards.astro';
import OptionCards from '../../components/ui/OptionCards.astro';
import LinkCards from '../../components/ui/LinkCards.astro';
import TocChips from '../../components/ui/TocChips.astro';
import SideBookCard from '../../components/ui/SideBookCard.astro';
import { siteConfig } from '../../config/site.js';
import { getServiceImage, getServiceImageAlt } from '../../utils/serviceImages';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
const data = entry.data;

const optimizedHero = getServiceImage(data.heroImage);
const heroAlt = getServiceImageAlt(data.heroImage, data.heroHeadline);

const conditionEntries = data.conditionsManaged
  ? (await Promise.all(
      data.conditionsManaged.map((slug) => getEntry('conditions', slug))
    )).filter(Boolean)
  : [];

let faqEntries = [];
if (data.faqIds && data.faqIds.length > 0) {
  const resolved = await Promise.all(
    data.faqIds.map((id) => getEntry('faqs', id))
  );
  faqEntries = resolved
    .filter(Boolean)
    .map((f) => ({ question: f.data.question, answer: f.body }));
}

// Blog articles tied to this service, either directly (service field)
// or through one of the conditions it manages. Newest first.
const managedConditionSlugs = data.conditionsManaged ?? [];
const relatedArticles = (await getCollection('blog'))
  .filter(
    (post) =>
      post.data.service === entry.slug ||
      (post.data.condition && managedConditionSlugs.includes(post.data.condition))
  )
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 6);

const relatedDoctor = data.defaultDoctorId
  ? siteConfig.doctors.find((d) => d.dbId === data.defaultDoctorId)
  : null;

const pageUrl = new URL(`/services/${entry.slug}`, siteConfig.url).toString();
const heroImageAbs = optimizedHero
  ? new URL(optimizedHero.src, siteConfig.url).toString()
  : new URL('/images/hero-doctor.jpg', siteConfig.url).toString();
const medicalWebPageSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": data.title,
  "description": data.metaDescription,
  "url": pageUrl,
  "image": heroImageAbs,
  "medicalAudience": {
    "@type": "MedicalAudience",
    "audienceType": "Patient",
  },
  "about": {
    "@type": "MedicalProcedure",
    "name": data.title,
    "description": data.metaDescription,
    "howPerformed": data.heroSubheadline || data.metaDescription,
  },
  ...(data.treatments && data.treatments.length > 0 && {
    "mentions": data.treatments.map((t) => ({
      "@type": "MedicalTherapy",
      "name": t.name,
      "description": t.description,
    })),
  }),
};

const medicalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalProcedure",
  "name": data.title,
  "description": data.metaDescription,
  "url": pageUrl,
  "image": heroImageAbs,
  "provider": {
    "@type": "MedicalBusiness",
    "name": siteConfig.name,
    "url": siteConfig.url,
    "telephone": siteConfig.contact.phone,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": siteConfig.contact.address.street,
      "addressLocality": siteConfig.contact.address.locality,
      "addressRegion": siteConfig.contact.address.state,
      "postalCode": siteConfig.contact.address.postalCode,
      "addressCountry": siteConfig.contact.address.country,
    },
  },
  ...(relatedDoctor && {
    "recognizingAuthority": {
      "@type": "Physician",
      "name": relatedDoctor.name,
      "url": new URL(`/our-doctors/${relatedDoctor.slug}`, siteConfig.url).toString(),
    },
  }),
};
---

<MainLayout title={data.title} description={data.metaDescription} image={optimizedHero?.src}>
  <script type="application/ld+json" set:html={JSON.stringify(medicalWebPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(medicalServiceSchema)} />

  <Breadcrumbs items={[
    { name: "Services", url: "/services" },
    { name: data.title, url: `/services/${entry.slug}` }
  ]} />

  <section class="bg-gradient-to-b from-brand-50/70 to-transparent px-5 pb-12 pt-3 md:px-6 md:pb-20">
    <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-[1.02fr_.98fr] md:gap-14">
      <div>
        {data.heroEyebrow && (
          <span data-rise style="--d:0" class="mb-5 inline-flex items-center gap-2 rounded-full border border-brand-100 bg-white/80 px-3.5 py-1.5 text-[11px] font-bold uppercase tracking-[0.16em] text-brand-700 shadow-sm"><span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>{data.heroEyebrow}</span>
        )}
        <h1 data-rise style="--d:1" class="mb-5 text-4xl leading-[1.05] text-slate-950 md:text-6xl">{data.heroHeadline}</h1>
        <p data-rise style="--d:2" class="mb-8 max-w-xl text-lg leading-relaxed text-slate-600 md:text-xl">{data.heroSubheadline}</p>
        <div data-rise style="--d:3" class="flex flex-col gap-3 sm:flex-row">
          <a href="#book" data-track="booking-click" class="inline-flex min-h-[52px] items-center justify-center gap-3 rounded-2xl bg-brand-800 px-7 font-bold text-white shadow-lg shadow-brand-900/20 transition hover:bg-brand-700 active:scale-[0.98]">
            {data.ctaTitle || `Book a ${data.title} Evaluation`} <span aria-hidden="true">→</span>
          </a>
          <a href={siteConfig.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[52px] items-center justify-center rounded-2xl border border-emerald-200 bg-white/80 px-6 font-bold text-emerald-800 transition hover:bg-emerald-50">Chat on WhatsApp</a>
        </div>
        <ul data-rise style="--d:4" class="mt-6 flex flex-wrap gap-2 text-xs font-semibold text-slate-600">
          <li class="rounded-full border border-slate-200 bg-white px-3 py-1.5">AIIMS-trained dermatologists</li>
          <li class="rounded-full border border-slate-200 bg-white px-3 py-1.5">Consultation first</li>
          <li class="rounded-full border border-slate-200 bg-white px-3 py-1.5">KK Nagar, Chennai</li>
        </ul>
      </div>

      {optimizedHero ? (
        <div class="relative" data-settle style="--d:2">
          <div data-hero-media class="aspect-[4/3] overflow-hidden rounded-[32px] border border-white bg-white p-1.5 shadow-2xl shadow-brand-900/15">
            <Image
              src={optimizedHero}
              alt={heroAlt}
              width={700}
              height={700}
              widths={[400, 700]}
              sizes="(max-width: 768px) 100vw, 50vw"
              formats={['avif', 'webp']}
              quality={80}
              loading="eager"
              class="h-full w-full rounded-[26px] object-cover"
            />
          </div>
          <div class="glass absolute -bottom-4 left-4 flex items-center gap-3 rounded-2xl px-4 py-3 md:left-6">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-emerald-100 text-emerald-700" aria-hidden="true"><svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
            <div><p class="text-sm font-bold leading-tight text-slate-900">Evidence-based care</p><p class="text-xs text-slate-600">No unnecessary procedures</p></div>
          </div>
        </div>
      ) : null}
    </div>
  </section>

  {data.twoPaths && (
    <section class="px-5 md:px-6">
      <div class="mx-auto grid max-w-6xl gap-5 pb-10 md:grid-cols-2">
        <div class="ui-card bg-gradient-to-br from-brand-50 to-white p-7">
          <span class="mb-4 grid h-11 w-11 place-items-center rounded-2xl bg-brand-100 text-brand-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
          <h2 class="mb-2 font-sans text-lg font-bold text-brand-900">{data.twoPaths.screeningTitle}</h2>
          <p class="leading-relaxed text-slate-700">{data.twoPaths.screeningBody}</p>
        </div>
        <div class="ui-card border-rose-100 bg-gradient-to-br from-rose-50 to-white p-7">
          <span class="mb-4 grid h-11 w-11 place-items-center rounded-2xl bg-rose-100 text-rose-700" aria-hidden="true"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><line x1="12" y1="8" x2="12" y2="12.5"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
          <h2 class="mb-2 font-sans text-lg font-bold text-rose-900">{data.twoPaths.symptomsTitle}</h2>
          <p class="leading-relaxed text-rose-900/80">{data.twoPaths.symptomsBody}</p>
        </div>
      </div>
    </section>
  )}

  <div class="mx-auto max-w-6xl px-5 py-6 md:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-12">
    <div class="min-w-0 space-y-14 pb-10">
      <section>
        <TocChips headings={headings} />
        <div class="prose prose-slate max-w-none md:prose-lg prose-headings:text-brand-900 prose-h2:scroll-mt-28 prose-a:text-brand-700 prose-p:leading-7 md:prose-p:leading-8">
          <Content />
        </div>
      </section>

      <StepCards title="How We Evaluate" items={data.diagnostics || []} />

      <OptionCards title="Treatment Options" items={data.treatments || []} />

      <LinkCards title="Conditions We Manage" items={conditionEntries.map((c) => ({ href: `/conditions/${c.slug}`, kicker: 'Condition', title: c.data.title }))} />

      <LinkCards title="Related Articles" items={relatedArticles.map((post) => ({ href: `/blog/${post.slug}`, kicker: 'Article', title: post.data.title }))} />

      {relatedDoctor && (
        <section>
          <h2 class="mb-6 text-2xl text-brand-900 md:text-3xl">Performed by</h2>
          <a href={`/our-doctors/${relatedDoctor.slug}`} class="ui-card group flex items-center gap-5 p-5">
            <img
              src={`/images/doctors/${relatedDoctor.slug}.jpg`}
              alt={`${relatedDoctor.name}, ${relatedDoctor.designation}`}
              width="80"
              height="80"
              loading="lazy"
              decoding="async"
              class="h-20 w-20 rounded-full border-2 border-white object-cover object-top shadow"
              onerror={`this.src='https://placehold.co/80x80/223154/FAF8F5?text=${encodeURIComponent(relatedDoctor.name.split(' ').pop())}'`}
            />
            <div class="min-w-0">
              <p class="font-bold text-slate-900 transition-colors group-hover:text-brand-700">{relatedDoctor.name}</p>
              <p class="text-sm font-semibold text-brand-600">{relatedDoctor.designation}</p>
              <p class="mt-1 text-xs text-slate-500">{relatedDoctor.qualificationsShort}</p>
            </div>
            <span class="ml-auto hidden text-sm font-semibold text-brand-600 sm:inline">View profile →</span>
          </a>
        </section>
      )}
    </div>

    <aside class="hidden lg:block" aria-label="Book a consultation">
      <div class="sticky top-28"><SideBookCard /></div>
    </aside>
  </div>

  <ClinicGallery />

  <FAQAccordion entries={faqEntries} />

  <BookingSection defaultService={data.defaultService} defaultDoctorId={data.defaultDoctorId} />
</MainLayout>
