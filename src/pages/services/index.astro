---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ListingFilter from '../../components/ListingFilter.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../config/site.js';
import { getServiceImage, getServiceImageAlt } from '../../utils/serviceImages';

const pageTitle = "All Services";
const pageDescription = `Complete list of dermatology, hair, and cosmetic services offered at ${siteConfig.name}, KK Nagar, Chennai.`;

const allServices = await getCollection('services');

const categoryLabels = {
  hair: 'Hair',
  skin: 'Skin',
  cosmetic: 'Cosmetic',
  pediatric: 'Pediatric',
};

const categoryOrder = ['hair', 'skin', 'cosmetic', 'pediatric'];

const filterCategories = categoryOrder.map((value) => ({ value, label: categoryLabels[value] }));

const servicesByCategory = categoryOrder.map((cat) => ({
  category: cat,
  label: categoryLabels[cat],
  services: allServices
    .filter((s) => s.data.category === cat)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
}));
---

<MainLayout title={pageTitle} description={pageDescription}>
  <Breadcrumbs items={[{ name: "Services", url: "/services" }]} />

  <div class="bg-gradient-to-b from-brand-50/70 to-transparent py-12 md:py-16 px-6 text-center">
    <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-brand-600 mb-4">Our expertise</p>
    <h1 class="text-4xl md:text-6xl text-slate-950 mb-4">Services</h1>
    <p class="text-lg text-slate-600 max-w-2xl mx-auto">Evidence-based hair, skin, cosmetic, and paediatric dermatology care under one roof in KK Nagar, Chennai.</p>
  </div>

  <ListingFilter noun="services" placeholder="Search" categories={filterCategories} />

  <div class="max-w-7xl mx-auto py-10 px-6">
    {servicesByCategory.map(({ category, label, services }) => (
      services.length > 0 && (
        <section class="mb-16 last:mb-0" data-filter-section>
          <div class="flex items-center gap-4 mb-8">
            <h2 class="text-2xl md:text-3xl font-bold text-brand-900">{label}</h2>
            <a href={`/${category}`} class="text-sm text-brand-600 font-semibold hover:underline">View {label} overview &rarr;</a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {services.map((service) => (
              <div class="h-full" data-filter-item data-cat={category} data-search={`${service.data.title} ${service.data.heroSubheadline || ''} ${service.data.metaDescription || ''} ${label} ${(service.data.conditionsManaged || []).join(' ')}`.toLowerCase()}>
              <ServiceCard
                image={getServiceImage(service.data.heroImage)}
                alt={getServiceImageAlt(service.data.heroImage, service.data.title)}
                title={service.data.title}
                description={service.data.heroSubheadline || service.data.metaDescription || ''}
                link={`/services/${service.slug}`}
              />
              </div>
            ))}
          </div>
        </section>
      )
    ))}
  </div>
</MainLayout>
